  "help": [
    {
      "id": "h1",
      "question": "Как связать высоту с ребром?",
      "text": "В основании равносторонний треугольник. Расстояние от его центра до вершины равно a/√3.",
      "view": "height"
    },
    {
      "id": "h2",
      "question": "Какую долю высоты занимает радиус к вершине?",
      "text": "Сравни расстояния от центра сферы до вершины S и вершины основания A.",
      "view": "radius"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди h = SO",
      "prompt": "В треугольнике SOA известны ребро SA и проекция OA. Какова высота?",
      "explanation": "Получаем h² = a²−a²/3 = 2a²/3. Тогда OA² = h²/2.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Центр равностороннего основания делит медиану в отношении два к одному от вершины."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вырази R через h",
      "prompt": "Пусть z = OI. Как использовать равенство IA = IS?",
      "explanation": "Запишем (h−z)² = h²/2+z². После сокращения получим z = h/4. Значит, R = h−z = 3h/4, откуда a² = 8R²/3.",
