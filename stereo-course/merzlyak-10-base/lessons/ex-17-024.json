  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Перемножь площади сечений, чтобы появилась площадь основания."
    }
  ],
  "steps": [
    {
      "title": "Основание",
      "prompt": "Как записать площадь через диагонали p,q?",
      "explanation": "Поскольку диагонали ромба перпендикулярны, S=pq/2, то есть pq=2S.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь ромба по диагоналям."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Сечения",
      "prompt": "Что даёт произведение их площадей?",
      "explanation": "S₁=ph, S₂=qh. Поэтому S₁S₂=pq·h²=2S·h².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь прямоугольных диагональных сечений."
        }
      ],
      "view": "sections",
      "id": "step-2"
    },
    {
      "title": "Высота",
      "prompt": "Какой корень нужно взять?",
      "explanation": "h²=S₁S₂/(2S), откуда h=√[S₁S₂/(2S)]. Высота положительна.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Решение равенства относительно положительной длины."
        }
      ],
      "view": "sections",
      "id": "step-3"
    }
