  "help": [
    {
      "id": "help-1",
      "question": "Как исключить пересечение с m?",
      "text": "BD лежит в плоскости ромба и параллельна m. Сама m в этой плоскости не лежит. Примени признак параллельности прямой и плоскости.",
      "theoryIds": [
        "theory-006"
      ],
