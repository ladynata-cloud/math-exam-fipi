  "steps": [
    {
      "title": "ABC и DCB",
      "prompt": "Какие две вершины входят в оба названия?",
      "explanation": "Общие точки B и C задают BC. Обе плоскости различны, поэтому ABC∩DCB=BC.",
      "justifications": [
        {
          "kind": "given",
          "text": "B,C принадлежат обеим плоскостям, а D не лежит в ABC."
        },
        {
          "kind": "theorem",
          "text": "Две общие точки определяют линию пересечения различных плоскостей.",
          "theoryId": "atanasyan2024-theory-002-a2"
        },
        {
          "kind": "theorem",
          "text": "Общая часть пересекающихся плоскостей — прямая.",
          "theoryId": "atanasyan2024-theory-002-a3"
        }
      ],
      "view": "bcd",
      "id": "step-1"
    },
    {
      "title": "ABD и CDA",
      "prompt": "Какие точки общие здесь?",
      "explanation": "A и D принадлежат обеим различным плоскостям, значит, ABD∩CDA=AD.",
      "justifications": [
        {
          "kind": "given",
          "text": "A,D — общие вершины; плоскости разных граней различны."
        },
        {
          "kind": "theorem",
          "text": "По A2 и A3 общая прямая — AD.",
          "theoryId": "atanasyan2024-theory-002-a3"
        }
      ],
      "view": "acd",
      "id": "step-2"
    },
    {
      "title": "PDC и ABC",
      "prompt": "Как найти вторую общую точку кроме C?",
      "explanation": "Плоскость PDC содержит прямую DP=DE, значит, содержит E. E∈AB⊂ABC; C тоже общая. Поэтому PDC∩ABC=EC. Плоскости различны, так как D∉ABC.",
      "justifications": [
        {
          "kind": "given",
          "text": "D,P,E коллинеарны и E∈AB."
        },
        {
          "kind": "theorem",
          "text": "DP лежит в PDC целиком.",
          "theoryId": "atanasyan2024-theory-002-a2"
        },
        {
          "kind": "theorem",
          "text": "Две общие точки E,C определяют линию пересечения.",
          "theoryId": "atanasyan2024-theory-002-a3"
        }
      ],
      "view": "dec",
      "id": "step-3"
    }
