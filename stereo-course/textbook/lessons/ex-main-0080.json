  "steps": [
    {
      "id": "step-1",
      "title": "Построй первое сечение",
      "prompt": "Как дополнить A,B,C₁ до многоугольника сечения?",
      "explanation": "AB∥D₁C₁, поэтому плоскость ABC₁ содержит D₁. Соедини A,B,C₁,D₁. Отрезки AB,BC₁,C₁D₁,D₁A лежат на гранях и составляют полное сечение ABC₁D₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Соответствующие рёбра параллелепипеда параллельны.",
          "theoryId": "theory-013",
