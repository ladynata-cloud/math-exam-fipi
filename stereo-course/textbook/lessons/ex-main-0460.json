  "help": [
    {
      "id": "h1",
      "question": "Как выразить радиус в сантиметрах?",
      "text": "4 мм — это диаметр. После перевода получится 0,4 см, а радиус вдвое меньше.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Где в формуле цилиндра стоит длина провода?",
      "text": "Она играет роль высоты цилиндра; сначала нужно найти объём материала из массы и плотности.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Согласуй единицы",
      "prompt": "Чему равны радиус и масса в системе г и см?",
      "explanation": "Диаметр 0,4 см, радиус 0,2 см, масса 6800 г. Площадь сечения S = 0,04π см².",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При вычислении площади сечения используется радиус, равный половине диаметра."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди объём алюминия",
      "prompt": "Как восстановить объём через плотность?",
      "explanation": "Из m = ρV получаем V = 6800/2,6 = 34000/13 см³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плотность равна массе, делённой на объём."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Вычисли длину и переведи её в метры",
      "prompt": "Что даёт деление объёма на площадь сечения?",
      "explanation": "Длина L = V/S = 850000/(13π) см, или 8500/(13π) м. Это приблизительно 208 м.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Во всём однородном проводе постоянны плотность и площадь поперечного сечения."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "Радиус другого провода при тех же массе и плотности увеличили вдвое. Какую часть прежней длины он составляет?",
      "explanation": "Поперечная площадь вырастет в 4 раза; прежний объём займёт четверть длины.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
