  "help": [
    {
      "id": "h1",
      "question": "Как получить A₁B₁ из радиус-векторов?",
      "text": "Вычти OA₁ из OB₁. Два одинаковых прибавления OP взаимно уничтожатся.",
      "view": "cancel"
    },
    {
      "id": "h2",
      "question": "Как доказать утверждение сразу для трёх сторон?",
      "text": "Повтори ту же разность для любой упорядоченной пары вершин. Никаких предположений о направлении OP не требуется.",
      "view": "sides"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Коэффициент сдвига",
      "prompt": "Какой коэффициент при OP остаётся в (OB+OP)−(OA+OP)?",
      "input": {
        "prompt": "Коэффициент сдвига",
        "accepted": [
          "0"
        ],
        "feedback": "OP появляется один раз со знаком плюс и один раз со знаком минус."
      },
      "explanation": "A₁B₁=OB−OA=AB.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вектор стороны есть разность радиус-векторов конца и начала.",
          "theoryId": "theory-070"
        }
      ],
      "view": "cancel"
    },
    {
      "id": "step-2",
      "title": "Вторая сторона",
      "prompt": "Назови сторону исходного треугольника, равную B₁C₁.",
      "input": {
        "prompt": "Вторая сторона",
        "accepted": [
          "BC",
          "BС",
          "ВC",
          "ВС"
        ],
        "feedback": "Сохрани порядок от B к C."
      },
      "explanation": "B₁C₁=(OC+OP)−(OB+OP)=BC. Для C₁A₁ получаем CA.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Общий перенос сохраняет разности.",
          "theoryId": "theory-070"
        }
      ],
      "view": "sides"
    },
    {
      "id": "step-3",
      "title": "Вывод о длинах",
      "prompt": "Каково отношение |A₁B₁|/|AB| у треугольника?",
      "input": {
        "prompt": "Вывод о длинах",
        "accepted": [
          "1"
        ],
        "feedback": "Сравни равные векторы соответствующих сторон."
      },
      "explanation": "Равные векторы имеют равные длины и одинаковое направление. Несущие прямые параллельны либо совпадают, если перенос вдоль стороны или нулевой.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У невырожденного треугольника длина стороны положительна.",
          "theoryId": "theory-070"
        }
      ],
      "view": "sides"
    },
    {
      "id": "step-4",
      "title": "Новый перенос",
      "prompt": "В другом примере A=(0,1,0), B=(3,2,1), а обе точки сдвинули на (4,−2,5). Введи компоненты A₁B₁.",
