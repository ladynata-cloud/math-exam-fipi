  "sourceDefects": [
    {
      "id": "S1213-014",
      "exercise": "12.14",
      "category": "source",
      "state": "confirmed-source-defect",
      "pdfPages": [
        117,
        203
      ],
      "finding": "The printed inclinations 60° and45° with a common external point make a mutual angle90° impossible. The formal answer3√10 on printed p202 does not describe an existing configuration.",
      "independentProof": "AH=3√3 gives BH=3,CH=3√3,AB=6,AC=3√6. A right angle BAC would give BC=3√10, whereas BC≤BH+CH=3+3√3<3√10.",
      "currentCardTreatment": "Faithfully quotes the data, proves inconsistency, and explicitly labels its75° extremal model as diagnostic. This content is mathematically sound, but it is not an ordinary solved instance of a consistent condition.",
      "source_defect": "inconsistent_conditions",
      "publicationTreatment": "Keep the exact source data and the explicit diagnostic/case distinction already present in this card. Do not silently alter the source condition or present the expected printed answer as uniquely implied."
    },
    {
      "id": "S1213-026",
      "exercise": "12.26",
      "category": "source",
      "state": "confirmed-source-defect",
      "pdfPages": [
        118,
        203
      ],
      "finding": "The angle30° is specified with the line AC, while the requested cos∠BAC depends on the chosen ray AC. Replacing C by a point on the opposite ray preserves the line-angle condition and reverses the cosine sign.",
      "independentProof": "Both choices produce the stated45° inclination and30° line angle, with cos∠BAC=±√6/4. The positive answer on printed p202 presupposes ∠HAC=30°.",
