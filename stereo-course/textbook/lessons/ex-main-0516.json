  "steps": [
    {
      "id": "step-1",
      "title": "Вычисли покрытие",
      "prompt": "Чему равен коэффициент перед π у площади мяча в см²?",
      "explanation": "S = 4π·10² = 400π см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула 4πR² относится ко всей поверхности шара."
        }
      ],
      "view": "disk",
      "input": {
        "prompt": "Коэффициент площади сферы",
        "accepted": [
          "400"
        ],
        "feedback": "Футбольный мяч покрывается по всей сфере. Одного круга недостаточно."
      }
    },
    {
      "id": "step-2",
      "title": "Найди запас",
      "prompt": "Какой коэффициент перед π добавят на швы?",
      "explanation": "8% от 400π составляют 0,08·400π = 32π см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Процент означает сотую долю основания расчёта."
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Коэффициент запаса на швы",
        "accepted": [
          "32"
        ],
        "feedback": "Восемь процентов — восемь сотых от уже вычисленной площади."
      }
    },
    {
      "id": "step-3",
      "title": "Сложи материалы",
      "prompt": "Какой коэффициент перед π нужен всего?",
      "explanation": "400+32 = 432. Получается 432π см², примерно 1357 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расход материала включает покрытие и припуск.",
          "theoryId": "theory-062"
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Коэффициент общего расхода",
        "accepted": [
          "432"
        ],
        "feedback": "Швы увеличивают расход, поэтому прибавь запас к 400."
      }
    },
    {
      "id": "step-4",
      "title": "Рассчитай иной запас",
      "prompt": "Для мяча радиуса 5 см при запасе 10% какой коэффициент перед π нужен?",
      "explanation": "Площадь 100π, запас 10π. Всего 110π см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь подобных сфер пропорциональна квадрату радиуса."
        }
      ],
      "view": "disk",
      "input": {
        "prompt": "Коэффициент нового расхода",
        "accepted": [
          "110"
        ],
        "feedback": "При половинном радиусе базовая площадь в четыре раза меньше."
      }
