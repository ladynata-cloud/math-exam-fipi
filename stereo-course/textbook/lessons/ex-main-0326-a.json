  "steps": [
    {
      "title": "Построй проекцию отрезка",
      "prompt": "Куда проектируется верхняя точка B на нижнее основание?",
      "explanation": "Проведём образующую BC до нижнего основания. Тогда C лежит на его окружности, BC = h, а AC — проекция AB. Так как BC перпендикулярна плоскости основания, треугольник ACB прямоугольный: AB² = AC² + h².",
      "view": "projection",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образующие цилиндра перпендикулярны основаниям и равны высоте.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
