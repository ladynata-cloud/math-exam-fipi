  "help": [
    {
      "id": "h1",
      "question": "Какую величину сначала вычислить в метрах?",
      "text": "Площадь круглого верха задаёт основание конуса. Умножь её на вертикальную глубину и раздели на три. Получишь кубические метры.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Сколько литров в одном кубическом метре?",
      "text": "Ребро метра содержит десять дециметров. Кубический метр содержит 10³ кубических дециметров, или 1000 литров.",
      "view": "depth"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Площадь верха",
      "prompt": "Сколько единиц π содержит площадь верха в м²?",
      "explanation": "r² = 1,5² = 2,25, поэтому площадь равна 2,25π м².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В условии указали радиус круглого верха."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Коэффициент площади",
        "accepted": [
          "2.25"
        ],
        "feedback": "Радиус уже дан: возведи 1,5 в квадрат без деления на два."
      }
    },
    {
      "id": "step-2",
      "title": "Объём конуса",
      "prompt": "Каков коэффициент при π в объёме в м³?",
      "explanation": "V = 2,25π·3/3 = 2,25π м³. При глубине 3 м коэффициент в числе м³ совпал с коэффициентом площади в м².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У конуса объём составляет треть объёма цилиндра с тем же основанием и высотой."
        }
      ],
      "view": "depth",
      "input": {
        "prompt": "Коэффициент объёма",
        "accepted": [
          "2.25"
        ],
        "feedback": "Применяй глубину SO, затем дели на три именно объём."
      }
    },
    {
      "id": "step-3",
      "title": "Литры и ответ ключа",
      "prompt": "Прими π ≈ 3,14 и введи целое число литров, как в печатном ответе.",
      "explanation": "Точное значение 2250π л. При π ≈ 3,14 получаем 7065 л — так округляет учебник. С более точным π получается 7068,58… л, до ближайшего литра 7069.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обе численные оценки происходят из одной точной вместимости. Разная точность π заметна при умножении на 2250.",
          "theoryId": "theory-059"
        }
      ],
      "view": "depth",
      "input": {
        "prompt": "Литры при π ≈ 3,14",
        "accepted": [
          "7065"
        ],
        "feedback": "Сначала переведи 2,25π м³ в 2250π л. Здесь условлено взять π ≈ 3,14."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другой бак",
      "prompt": "Глубина по-прежнему 3 м, а радиус теперь 1 м. Сколько литров получается при π ≈ 3,14?",
      "explanation": "V = π м³ = 1000π л. При указанном приближении это 3140 л.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При неизменной высоте вместимость пропорциональна квадрату радиуса."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Новая вместимость",
        "accepted": [
          "3140"
        ],
        "feedback": "В новом примере квадрат радиуса равен 1. Не забудь переход от м³ к литрам."
      }
    }
