  "help": [
    {
      "id": "h1",
      "question": "Как найти высоту пирамиды?",
      "text": "Сначала найди радиус описанной окружности основания — это проекция бокового ребра.",
      "view": "height"
    },
    {
      "id": "h2",
      "question": "Как связать радиус вписанной сферы с апофемой?",
      "text": "Радиус перпендикулярен каждой касательной плоскости. В осевом сечении точка I лежит на биссектрисе угла при середине стороны.",
      "view": "inc"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди высоту и апофему",
      "prompt": "Пусть M — середина стороны основания, O — его центр. Чему равны OA, OM, SO и SM?",
      "explanation": "Для равностороннего основания OA = a/√3, OM = a√3/6. Из SO² = (2a)²−OA² получаем h = a√33/3. В боковой грани SM² = (2a)²−(a/2)², значит l = a√15/2.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В равностороннем треугольнике центры окружностей совпадают, а медиана делится центром в отношении 2:1."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди радиус вписанной сферы",
      "prompt": "Как из равных расстояний от I до OM и SM получить отношение IO к IS?",
      "explanation": "В треугольнике SOM биссектриса угла OMS проходит через I, поскольку IO равно перпендикуляру от I к SM. По теореме о биссектрисе IO/IS = OM/SM. Значит, r = h·OM/(OM+l) = a√33/[3(1+3√5)].",
      "view": "inc",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость SOM перпендикулярна стороне основания; поэтому расстояния до двух граней измеряются в ней."
        }
      ],
      "input": {
        "prompt": "Введи коэффициент при a для r. Для корня используй sqrt(число).",
        "accepted": [
          "sqrt(33)/(3*(1+3*sqrt(5)))"
        ],
        "feedback": "Половина высоты не является радиусом. Раздели h·OM на сумму OM и SM."
      }
    },
    {
      "id": "step-3",
      "title": "Найди радиус описанной сферы",
      "prompt": "Как из равенства QS = QA выразить радиус R?",
      "explanation": "Координата Q от основания равна h−R, поэтому R² = OA²+(h−R)². Отсюда R = (h²+OA²)/(2h) = (2a)²/(2h) = 2a√33/11.",
      "view": "circ",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В прямоугольном треугольнике SOA сумма квадратов катетов равна квадрату ребра 2a."
        }
      ],
      "input": {
        "prompt": "Введи коэффициент при a для R.",
        "accepted": [
          "2*sqrt(33)/11"
        ],
        "feedback": "Используй квадрат бокового ребра, делённый на удвоенную высоту."
      }
    },
    {
