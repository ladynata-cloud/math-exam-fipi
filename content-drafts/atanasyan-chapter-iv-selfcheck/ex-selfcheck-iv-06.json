  "help": [
    {
      "question": "Может ли вместо треугольника получиться отрезок?",
      "text": "Да: касательная плоскость через вершину имеет с телом общую образующую. Это вырожденное пересечение, исключённое условием о внутренности.",
      "view": "tangent",
      "theoryIds": [
        "theory-040"
      ],
      "id": "help-1"
    },
    {
      "question": "А только одна точка?",
      "text": "Например, плоскость через вершину, параллельная основанию, имеет с конусом только вершину S. Поэтому условие о невырожденном сечении существенно.",
      "view": "point",
      "theoryIds": [
        "theory-040"
      ],
      "id": "help-2"
    }
  ],
  "steps": [
    {
      "title": "Найди линии границы",
      "prompt": "Какие точки связываются с вершиной?",
      "explanation": "Плоскость пересекает круг основания по хорде AB. Для каждой точки этой хорды отрезок, соединяющий её с S, лежит в конусе. Граница полученного сечения состоит из AB и двух образующих SA, SB. Сечение — треугольник SAB.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Конус состоит из отрезков, соединяющих вершину с точками круга основания.",
          "theoryId": "theory-040"
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Сравни боковые стороны",
      "prompt": "Почему SA=SB?",
      "explanation": "В прямом круговом конусе SA²=SO²+OA², SB²=SO²+OB². Радиусы OA и OB равны, поэтому SA=SB. Следовательно, невырожденное сечение через вершину — равнобедренный треугольник. Оно не обязано быть осевым.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равенство образующих прямого кругового конуса.",
          "theoryId": "theory-040"
        }
      ],
      "id": "step-2"
    }
  ],
