      }
    },
    {
      "id": "step-3",
      "title": "Сложи объёмы тонких слоёв",
      "prompt": "Как применить пределы 1 и 2?",
      "explanation": "Первообразная для 1/x² равна −1/x. Разность её значений равна (−1/2) − (−1) = 1/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула объёма по сечениям требует интегрировать площадь по координате, перпендикулярной срезу."
