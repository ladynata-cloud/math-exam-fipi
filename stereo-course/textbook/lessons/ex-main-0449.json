  "help": [
    {
      "id": "h1",
      "question": "Куда проектируется B₁ при перпендикулярном проектировании на основание?",
      "text": "Его проекция — B, поэтому диагональ B₁D проектируется в BD.",
      "view": "tilted"
    },
    {
      "id": "h2",
      "question": "По какому ребру соединены плоскости указанного двугранного угла?",
      "text": "Обе плоскости содержат B₁B. Ищи две прямые в основании, перпендикулярные этому вертикальному ребру.",
      "view": "dihedral"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди высоту",
      "prompt": "Где находятся данные 45° и 12 см?",
      "explanation": "В треугольнике DBB₁ угол при D равен 45°, а прилежащий катет DB = 12. Получаем BB₁ = 12 tg 45° = 12 см.",
      "view": "tilted",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ и её проекция на плоскость образуют угол наклона к плоскости."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Построй линейный угол",
      "prompt": "Почему его можно увидеть в основании?",
      "explanation": "Ребро двугранного угла вертикально. Луч BA лежит в грани A₁B₁B, луч BD — в плоскости B₁BD. Они оба перпендикулярны BB₁. Поэтому ∠ABD = 60°.",
      "view": "dihedral",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейный угол двугранного угла задаётся лучами его граней, перпендикулярными ребру в одной точке."
        }
      ],
      "input": {
        "prompt": "Введи градусную меру угла ABD.",
        "accepted": [
          "60"
        ],
        "feedback": "У обоих лучей общая точка B, и оба перпендикулярны ребру BB₁."
      }
    },
    {
      "id": "step-3",
      "title": "Вычисли стороны основания",
      "prompt": "Как расположены AB и AD относительно угла 60°?",
      "explanation": "В прямоугольном треугольнике BAD гипотенуза BD равна 12. Получаем AB = 12 cos 60° = 6, AD = 12 sin 60° = 6√3 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Угол при A прямой, поскольку основание прямоугольное."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Вычисли объём",
      "prompt": "Как соединить результаты?",
      "explanation": "Sосн = 6·6√3 = 36√3 см². Умножив на высоту 12 см, получаем V = 432√3 см³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём прямого бруска равен произведению площади основания на высоту."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь независимый случай",
      "prompt": "Если диагональ основания 10 см, а угол наклона B₁D по-прежнему 45°, чему равна высота?",
      "explanation": "Равные острые углы дают равные катеты, поэтому высота 10 см.",
      "view": "tilted",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У прямоугольного равнобедренного треугольника катеты равны."
        }
      ],
      "input": {
        "prompt": "Введи новую высоту в сантиметрах.",
        "accepted": [
