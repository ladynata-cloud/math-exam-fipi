  "help": [
    {
      "id": "h1",
      "question": "Какие радиусы удобно различить?",
      "text": "Обозначь через R радиус сферы, через r — радиус основания конуса. Тогда h = 2R и l = 2r.",
      "view": "neutral"
    },
    {
      "id": "h2",
      "question": "Как связать r и R?",
      "text": "Примени теорему Пифагора к половине осевого разреза.",
      "view": "triangle"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Сравни длины",
      "prompt": "Чему равно отношение l/r?",
      "explanation": "По условию образующая равна диаметру основания. Получается l/r = 2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образующая заданного конуса равна диаметру основания."
        }
      ],
      "view": "double",
      "input": {
        "prompt": "Отношение образующей к радиусу",
        "accepted": [
          "2"
        ],
        "feedback": "Диаметр основания равен двум радиусам основания, а не радиусу сферы."
      }
    },
    {
      "id": "step-2",
      "title": "Свяжи квадраты",
      "prompt": "Чему равно r²/R²?",
      "explanation": "В прямоугольном треугольнике l² = h²+r². Подстановка 4r² = 4R²+r² приводит к r²/R² = 4/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус основания и ось прямого конуса взаимно перпендикулярны."
        }
      ],
      "view": "triangle",
      "input": {
        "prompt": "Отношение квадратов радиусов",
        "accepted": [
          "4/3"
        ],
        "feedback": "Из обеих частей вычти r² и только потом раздели на 3R²."
      }
    },
    {
      "id": "step-3",
      "title": "Сложи площади конуса",
      "prompt": "Каков коэффициент перед πr² у полной поверхности конуса?",
      "explanation": "πr²+πrl = πr²+2πr² = 3πr². Это 4πR², совпадающее с поверхностью сферы.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная поверхность состоит из основания и боковой поверхности.",
          "theoryId": "theory-062"
        }
      ],
      "view": "double",
      "input": {
        "prompt": "Коэффициент полной поверхности",
        "accepted": [
          "3"
        ],
        "feedback": "πrl — только боковая площадь. Добавь круг основания."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь доказательство численно",
      "prompt": "Если R = 3, каков общий коэффициент при π?",
      "explanation": "Сфера имеет площадь 4π·9 = 36π. Тогда r² = 12, и поверхность конуса 3π·12 = 36π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Доказанное тождество выполняется для каждого положительного радиуса."
        }
      ],
      "view": "triangle",
      "input": {
        "prompt": "Общий коэффициент при π",
        "accepted": [
          "36"
        ],
        "feedback": "Два способа вычисления должны дать одно значение при выбранном радиусе."
      }
    }
