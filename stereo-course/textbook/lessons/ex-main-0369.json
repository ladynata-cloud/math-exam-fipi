  "steps": [
    {
      "title": "Определи две части конуса",
      "prompt": "Какая часть отсекается у вершины?",
      "explanation": "Пусть P — вершина, O — центр основания, O₁ — середина высоты PO. Плоскость через O₁ перпендикулярна оси, поэтому параллельна основанию и пересекает конус по кругу. Над сечением остаётся малый конус с вершиной P, под ним — искомый усечённый конус.",
      "view": "cut",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сечение конуса плоскостью, перпендикулярной оси и проходящей между вершиной и основанием, является кругом; такая плоскость отделяет малый конус.",
          "theoryId": "theory-040",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              94,
              95
            ],
            "pdfPages": [
              96,
              97
            ],
            "point": "40"
          }
        },
        {
          "kind": "theorem",
          "text": "Усечённый конус получается удалением малого конуса параллельным сечением.",
          "theoryId": "theory-042",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              96,
              97
            ],
            "pdfPages": [
              98,
