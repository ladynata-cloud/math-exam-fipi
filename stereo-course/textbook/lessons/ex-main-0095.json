  "steps": [
    {
      "id": "step-1",
      "title": "Исключим совпадение",
      "prompt": "Может ли β совпасть с α?",
      "explanation": "Нет: a не имеет общих точек с α, но имеет общую точку с β.",
      "justifications": [
        {
          "kind": "given",
          "text": "a ∥ α; β пересекает a."
        },
        {
          "kind": "theorem",
          "text": "Определение параллельности прямой и плоскости.",
          "theoryId": "theory-006"
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Исключим параллельность",
      "prompt": "Что было бы при β ∥ α?",
      "explanation": "Пусть P = a ∩ β. Через a и любую точку Q ∈ α проведём плоскость γ. Она пересекает α по c ∥ a. При β ∥ α её след d = γ ∩ β параллелен c, значит параллелен a. Но d и a проходят через P, поэтому совпадают. Тогда a ⊂ β, вопреки пересечению в одной точке. Значит β и α пересекаются.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "След плоскости, содержащей прямую, параллельную другой плоскости, параллелен этой прямой.",
          "theoryId": "theory-006"
        },
        {
          "kind": "theorem",
          "text": "Следы параллельных плоскостей параллельны.",
          "theoryId": "theory-011"
        },
        {
          "kind": "theorem",
          "text": "Единственность параллельной прямой через точку.",
          "theoryId": "theory-004"
        }
      ],
