  "steps": [
    {
      "title": "Раздели поверхность на три части",
      "prompt": "Где находятся грани, не содержащие P или Q?",
      "explanation": "При P расположены пять треугольных граней, при Q — ещё пять. Между рядами A₁…A₅ и B₁…B₅ находится пояс из десяти треугольников: пять имеют сторону верхнего пятиугольника и пять — нижнего. Итого f = 5 + 10 + 5 = 20.",
      "view": "belt",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждая из пяти сторон каждого ряда принадлежит одной грани пояса; эти десять граней различны."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Посчитай рёбра при вершине",
      "prompt": "Сколько граней сходится в P?",
      "explanation": "В P встречаются пять треугольных граней и пять рёбер. У любой вершины ряда тоже пять рёбер: два к соседям того же ряда, два к соседнему ряду и одно к P или Q. Значит, m = 5.",
      "view": "vertex",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перечислены все соседи каждого из трёх видов вершин в данной конструкции."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Найди сумму плоских углов",
      "prompt": "Какой угол даёт каждая грань?",
      "explanation": "Каждая грань равносторонняя, её угол 60°. Пять граней дают 5·60° = 300°, что меньше 360°.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Суммируем пять плоских углов равносторонних треугольников."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Подсчитай рёбра и вершины",
      "prompt": "Как учесть общие рёбра?",
      "explanation": "У двадцати граней 20·3 сторон с повторениями. Поэтому k = (20·3)/2 = 30. Вершин e = 2 + 5 + 5 = 12. Проверка Эйлера: 20 + 12 − 30 = 2.",
      "view": "belt",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждое ребро принадлежит двум граням; два пятиугольных ряда и две крайние вершины не пересекаются."
        }
      ],
      "id": "step-4"
    },
    {
      "title": "Проверь, что стоит за рисунком",
      "prompt": "Достаточно ли нарисовать два пятиугольных ряда?",
      "explanation": "Нет: нужны определённые радиусы, высоты и поворот рядов относительно друг друга. В карточке о построении икосаэдра эти величины выбираются так, чтобы все тридцать рёбер действительно имели одну длину.",
      "view": "neutral",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Внешнее сходство модели не доказывает равенства её рёбер.",
          "theoryId": "theory-036-icosahedron-existence"
        }
      ],
      "id": "step-5"
    }
