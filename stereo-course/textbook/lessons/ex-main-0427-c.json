  "help": [
    {
      "id": "h1",
      "question": "Какой отрезок известен благодаря касанию?",
      "text": "От центра сферы до каждой грани опущен перпендикуляр длины R.",
      "view": "radii"
    },
    {
      "id": "h2",
      "question": "Как использовать правильность многогранника?",
      "text": "Все четыре грани имеют одинаковую площадь.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Переведи касание на язык длин",
      "prompt": "Что даёт радиус вписанной сферы?",
      "explanation": "Соедини I с вершинами. Получатся четыре пирамиды с одинаковой площадью основания F и общей высотой R. Их суммарный объём 4FR/3.",
      "view": "radii",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Соединение центра вписанной сферы с вершинами разбивает выпуклый многогранник на пирамиды с общей высотой R."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Запиши размеры",
      "prompt": "Какие длины или площади свяжут R с рёбрами?",
      "explanation": "Пусть F — площадь одной грани, h — высота. Объём можно записать как Fh/3 или как 4FR/3: каждая пирамида с вершиной в центре сферы имеет высоту R. Поэтому h = 4R. Если a — ребро, проекция бокового ребра на основание равна a/√3. Тогда h² = a²−a²/3 = 2a²/3, откуда a² = 24R². Площадь четырёх граней равна √3a² = 24√3R².",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Соединение центра вписанной сферы с вершинами разбивает выпуклый многогранник на пирамиды с общей высотой R."
        }
      ]
    },
    {
      "id": "step-3",
