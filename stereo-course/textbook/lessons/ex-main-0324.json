  "steps": [
    {
      "title": "Запиши площадь основания",
      "prompt": "Как выразить данную площадь через радиус?",
      "explanation": "Основание — круг, поэтому πr² = 5. Отсюда r² = 5/π.",
      "view": "radius",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круга радиуса r равна πr²."
        },
        {
          "kind": "given",
          "text": "Площадь одного основания равна 5 м²."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Найди радиус",
      "prompt": "Какой квадратный корень нужно выбрать?",
      "explanation": "r = √(5/π) м, поскольку радиус положителен. Пока можно оставить выражение под корнем.",
      "view": "radius",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина радиуса положительна."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Запиши площадь осевого сечения",
      "prompt": "Чему равны стороны этого прямоугольника?",
      "explanation": "Осевое сечение имеет стороны 2r и h. Его площадь равна 2rh, поэтому 2rh = 10.",
      "view": "rectangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевое сечение цилиндра — прямоугольник со сторонами 2r и h.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
