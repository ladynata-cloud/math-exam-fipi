  "steps": [
    {
      "title": "Первая проекция",
      "prompt": "Первая проекция. Объясни свой выбор.",
      "explanation": "Обозначим исходную площадь S, угол плоскостей φ. Тогда S₁=S cosφ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о площади ортогональной проекции: S₁=S·cosφ, где φ — угол между плоскостями."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Вторая проекция",
      "prompt": "Вторая проекция. Объясни свой выбор.",
      "explanation": "При проектировании обратно угол плоскостей тот же, поэтому S₂=S₁ cosφ=S cos²φ. Обратное проектирование не возвращает исходный треугольник.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о площади ортогональной проекции: S₁=S·cosφ, где φ — угол между плоскостями."
        }
      ],
      "view": "second",
      "id": "step-2"
    },
    {
      "title": "Реши уравнение",
      "prompt": "Реши уравнение. Объясни свой выбор.",
      "explanation": "По условию S₂=S/2, значит cos²φ=1/2. Так как cosφ≥0, cosφ=√2/2 и φ=45°. Ответ: 45°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Угол между плоскостями принадлежит [0°,90°]."
        }
      ],
