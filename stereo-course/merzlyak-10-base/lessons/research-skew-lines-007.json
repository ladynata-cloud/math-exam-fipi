  "steps": [
    {
      "title": "Середины рёбер",
      "prompt": "Пусть M — середина AB, N — середина CD.",
      "explanation": "В равносторонних треугольниках CAB и DAB медианы CM и DM перпендикулярны AB. Значит, AB⊥плоскости CMD, а потому AB⊥MN.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Медиана равностороннего треугольника является высотой; признак перпендикулярности прямой и плоскости."
        }
      ],
      "view": "first",
      "id": "step-1"
    },
    {
      "title": "Вторая перпендикулярность",
      "prompt": "Рассмотрите треугольники ACD и BCD.",
      "explanation": "Их медианы AN и BN перпендикулярны CD. Следовательно, CD⊥плоскости ANB и CD⊥MN. Отрезок MN — общий перпендикуляр к AB и CD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тот же признак перпендикулярности прямой и плоскости."
        }
      ],
      "view": "second",
      "id": "step-2"
    },
    {
      "title": "Прямоугольный треугольник",
      "prompt": "Вычислите MC и CN.",
      "explanation": "MC — высота равностороннего треугольника ABC: MC=a√3/2. CN=a/2. Треугольник MCN прямоугольный при N, так как MN⊥CD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота равностороннего треугольника."
        }
      ],
      "view": "triangle",
      "id": "step-3"
    },
    {
      "title": "Расстояние",
      "prompt": "Примените теорему Пифагора.",
      "explanation": "d=MN=√(MC²−CN²)=√(3a²/4−a²/4)=a√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора и определение расстояния между скрещивающимися прямыми."
