  "help": [
    {
      "id": "h1",
      "question": "Какие стороны образуют первую диагональ?",
      "text": "DC₁ лежит в грани DCC₁D₁ с катетами DC = 9 и CC₁ = 12. Для DB используй два горизонтальных направления 8 и 9.",
      "view": "side"
    },
    {
      "id": "h2",
      "question": "Как найти пространственную диагональ?",
      "text": "Проекция DB₁ на основание — DB, а вертикальный катет BB₁ = 12. Ещё раз примени теорему Пифагора.",
      "view": "space"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Боковая грань",
      "prompt": "Чему равна длина DC₁?",
      "explanation": "√(9²+12²) = √225 = 15 см. Ребро длины 8 в этой грани отсутствует.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Катеты DC и CC₁ перпендикулярны."
        }
      ],
      "view": "side",
      "input": {
        "prompt": "Длина DC₁",
        "accepted": [
          "15"
        ],
        "feedback": "Найди прямоугольную грань, на которой лежат обе буквы D и C₁."
      }
    },
    {
      "id": "step-2",
      "title": "Основание",
      "prompt": "Найди квадрат длины DB.",
      "explanation": "DB² = 8²+9² = 145. Длина DB = √145 см. Корень оставляем в точном виде.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Горизонтальная диагональ использует только горизонтальные размеры."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Квадрат DB",
        "accepted": [
          "145"
        ],
        "feedback": "Здесь запрашивается квадрат DB, не его корень."
      }
    },
    {
      "id": "step-3",
      "title": "Через всё тело",
      "prompt": "Какова длина DB₁?",
      "explanation": "DB₁² = DB²+BB₁² = 145+144 = 289. Поэтому DB₁ = 17 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вертикальное ребро перпендикулярно всей плоскости основания, в частности DB.",
          "theoryId": "theory-063"
        }
      ],
      "view": "space",
      "input": {
        "prompt": "Длина DB₁",
        "accepted": [
          "17"
        ],
        "feedback": "К квадрату диагонали основания прибавь квадрат вертикального ребра."
      }
    },
    {
      "id": "step-4",
      "title": "Новый параллелепипед",
      "prompt": "При взаимно перпендикулярных размерах 3, 4 и 12 найди пространственную диагональ.",
      "explanation": "В основании получается 5, а пространственная диагональ √(25+144) = 13.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Квадрат пространственной диагонали равен сумме квадратов трёх измерений."
        }
      ],
      "view": "space",
      "input": {
        "prompt": "Новая диагональ",
        "accepted": [
          "13"
        ],
        "feedback": "Квадраты трёх размеров складываются до извлечения корня."
      }
    }
