  "steps": [
    {
      "id": "step-1",
      "title": "Сторона BC",
      "prompt": "Найди коэффициенты BC в порядке a,b,c.",
      "input": {
        "prompt": "Сторона BC",
        "accepted": [
          "0;-1;1"
        ],
        "feedback": "Чтобы получить BC, вычти вектор к началу B из вектора к концу C."
      },
      "explanation": "BC=c−b. Он же равен AD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Разность радиус-векторов направлена от вычитаемого конца к уменьшаемому.",
          "theoryId": "theory-070"
        }
      ],
      "view": "fourth"
    },
    {
      "id": "step-2",
      "title": "Вершина D",
      "prompt": "Разложи OD.",
      "input": {
        "prompt": "Вершина D",
        "accepted": [
          "1;-1;1"
        ],
        "feedback": "После OA добавь найденный BC, равный AD."
      },
      "explanation": "OD=a−b+c.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Путь O → A → D складывается по правилу треугольника.",
          "theoryId": "theory-070"
        }
      ],
      "view": "fourth"
    },
    {
      "id": "step-3",
      "title": "Центр основания",
      "prompt": "Запиши коэффициенты OM.",
      "input": {
        "prompt": "Центр основания",
        "accepted": [
          "1/2;0;1/2"
        ],
        "feedback": "Это полусумма OA и OC. Коэффициент при OB равен нулю."
      },
      "explanation": "OM=(a+c)/2. Проверка по другой диагонали: (b+a−b+c)/2 даёт то же.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали параллелограмма делятся пополам.",
          "theoryId": "theory-070"
        }
      ],
      "view": "center"
    },
    {
      "id": "step-4",
      "title": "Середина стороны",
      "prompt": "На новом шаге N делит AD пополам. Вырази ON.",
      "input": {
        "prompt": "Середина стороны",
        "accepted": [
          "1;-1/2;1/2"
        ],
        "feedback": "Усредни OA и OD. Оба содержат по одному a."
