  "steps": [
    {
      "title": "Найди высоту основания",
      "prompt": "Где находится основание высоты из A?",
      "explanation": "Пусть M — середина BC. В равнобедренном ABC медиана AM является высотой, BM=5 см. AM=√(13²−5²)=12 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Медиана равнобедренного треугольника к основанию является высотой."
        },
        {
          "kind": "theorem",
          "text": "Теорема Пифагора для прямоугольного треугольника."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Найди высоту грани DBC",
      "prompt": "Почему DM перпендикулярна BC?",
      "explanation": "BC⊥AM и BC⊥AD, поэтому BC⊥(ADM), значит BC⊥DM. В прямоугольном DAM имеем DM=√(9²+12²)=15 см. Площадь DBC равна 10·15/2=75 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямая, перпендикулярная двум пересекающимся прямым плоскости, перпендикулярна этой плоскости.",
