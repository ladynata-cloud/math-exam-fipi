        "prompt": "Вес вершины A",
        "accepted": [
          "7/10"
        ],
        "feedback": "K ближе к A. Взвешенное среднее использует коэффициент 1−3/10 при DA."
      },
      "explanation": "DK=(7/10)DA+(3/10)DA₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для K=A+t(A₁−A) веса концов равны 1−t и t.",
          "theoryId": "theory-070"
        }
      ],
      "view": "ratio"
    },
    {
