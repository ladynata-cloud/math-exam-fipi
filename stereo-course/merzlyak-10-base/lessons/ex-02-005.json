  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Отдельно рассмотри прямоугольный треугольник, у которого AC — гипотенуза."
    }
  ],
  "steps": [
    {
      "title": "Центр вне AC",
      "prompt": "Когда единственность плоскости сразу помогает?",
      "explanation": "Сначала рассмотрим случай, отличный от показанного в модели: O не лежит на AC. Тогда A,C,O неколлинеарны. Они определяют плоскость треугольника, которая поэтому совпадает с α. Тогда B∈α.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Единственность плоскости через три неколлинеарные точки."
        }
      ],
      "view": "diameter",
      "id": "step-1"
    },
    {
      "title": "Центр лежит на AC",
      "prompt": "Какая сторона описанного треугольника проходит через центр окружности?",
      "explanation": "Если O лежит на AC, то AC — диаметр описанной окружности, а ∠ABC=90°. Так бывает у прямоугольного треугольника с гипотенузой AC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вписанный угол, опирающийся на диаметр, прямой."
        }
      ],
      "view": "triangle",
      "id": "step-2"
    },
    {
      "title": "Проверим вывод",
      "prompt": "Обязана ли α совпадать с плоскостью прямоугольного треугольника?",
      "explanation": "Нет. Через гипотенузу AC можно провести другую плоскость α. Она содержит и O, но не содержит B. Модель показывает именно такой случай. Поэтому без дополнительного условия утверждать B∈α нельзя.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Через прямую проходит бесконечно много плоскостей."
        }
      ],
      "view": "triangle",
      "id": "step-3"
    }
  ],
