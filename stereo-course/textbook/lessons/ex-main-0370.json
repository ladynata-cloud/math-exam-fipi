  "steps": [
    {
      "title": "Определи элементы тела вращения",
      "prompt": "Какие стороны трапеции задают основания и образующую?",
      "explanation": "Основания трапеции AD и BC параллельны. Сторона AB перпендикулярна им и служит осью вращения. Получается усечённый конус с меньшим радиусом r = BC = 4 см, большим радиусом R = AD и образующей l = CD = 3√2 см.",
      "view": "rotation",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вращение прямоугольной трапеции вокруг её боковой стороны, перпендикулярной основаниям, создаёт усечённый конус.",
          "theoryId": "theory-042",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              96,
              97
            ],
