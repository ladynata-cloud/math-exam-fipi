  "help": [
    {
      "id": "h1",
      "question": "Как перейти от диаметра к радиусу?",
      "text": "Высота равна полному диаметру AB. Радиус OA идёт только до центра.",
      "view": "axial"
    },
    {
      "id": "h2",
      "question": "Что меняется при возведении радиуса в квадрат?",
      "text": "Если r = H/2, то квадрат радиуса равен H²/4.",
      "view": "base"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди половину диаметра",
      "prompt": "В примере H = 10. Чему равен радиус?",
      "explanation": "Поскольку 2r = H, получаем r = H/2 = 5.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диаметр проходит через центр и состоит из двух радиусов."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи радиус модели.",
        "accepted": [
          "5"
        ],
        "feedback": "Высота равна диаметру, а не радиусу."
      }
    },
    {
      "id": "step-2",
      "title": "Найди площадь круга",
      "prompt": "Какой коэффициент у π в площади примера?",
      "explanation": "S = π(H/2)² = πH²/4. При H = 10 имеем S = 25π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При возведении отношения в квадрат знаменатель также возводят в квадрат."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи коэффициент площади.",
        "accepted": [
          "25"
        ],
        "feedback": "В квадрат возводи радиус 5, а не всю высоту 10."
      }
    },
    {
      "id": "step-3",
      "title": "Вырази общий объём",
      "prompt": "Какой коэффициент при π в объёме примера?",
      "explanation": "V = (πH²/4) · H/3 = πH³/12. При H = 10 объём 250π/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота и диаметр одинаковы численно, но в формуле объёма они выполняют разные роли.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи коэффициент объёма модели.",
        "accepted": [
          "250/3"
        ],
        "feedback": "Умножь площадь 25π на треть высоты 10."
      }
    },
    {
      "id": "step-4",
      "title": "Возьми другой диаметр",
      "prompt": "Новый конус того же вида имеет высоту 6. Какой коэффициент при π получается в объёме?",
      "explanation": "Радиус 3 и высота 6 дают 9 · 6/3 = 18. Тот же результат следует из 6³/12.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Отношение высоты к радиусу сохраняется и при новых размерах."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "18"
        ],
        "feedback": "Сначала найди новый радиус 3; половина прежнего диаметра не подходит."
      }
    }
  ],
