  "help": [
    {
      "id": "h1",
      "question": "С чего начать вычисление сечения?",
      "text": "Радиус равен половине диаметра, поэтому r = 9 м.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Можно ли перемножать кубические метры и граммы на кубический сантиметр без перевода?",
      "text": "Переведи плотность в т/м³ или все длины в сантиметры.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди вместимость",
      "prompt": "Какой объём в кубических метрах?",
      "explanation": "V = π·9²·7 = 567π м³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круглого основания равна πr²."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Переведи плотность",
      "prompt": "Сколько тонн в кубическом метре при плотности 1 г/см³?",
      "explanation": "В 1 м³ миллион см³, а миллион граммов равен 1 т. Численное значение плотности поэтому сохраняется: 0,85 г/см³ = 0,85 т/м³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При переводе плотности одновременно меняются единицы массы и объёма."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Найди массу",
      "prompt": "Какова масса полного объёма?",
      "explanation": "Точно 481,95π т. При π ≈ 3,14 получаем 1513,323 т, то есть 1513 т. При более точном π получаем около 1514,09 т, то есть 1514 т.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Масса однородного вещества равна произведению его плотности на объём."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "Цистерну объёмом 10 м³ наполнили той же нефтью. Какова масса в тоннах?",
      "explanation": "10·0,85 = 8,5 т.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "После перевода плотности в т/м³ умножай её на объём в м³."
        }
      ],
      "input": {
        "prompt": "Введи массу в тоннах.",
        "accepted": [
