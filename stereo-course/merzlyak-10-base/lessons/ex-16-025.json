  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Соедини верхнюю вершину C₁ с серединой AB."
    }
  ],
  "steps": [
    {
      "title": "Высота основания",
      "prompt": "Как найти CM?",
      "explanation": "Пусть M — середина AB. Тогда CM⊥AB и CM=a√3/2. Боковое ребро CC₁=a перпендикулярно основанию.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота равностороннего треугольника и прямота призмы."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота сечения",
      "prompt": "Почему C₁M⊥AB?",
      "explanation": "AB перпендикулярна CM и CC₁, поэтому перпендикулярна плоскости CMC₁ и её прямой C₁M. В прямоугольном CMC₁: C₁M=√(3a²/4+a²)=a√7/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой плоскости и теорема Пифагора."
        }
      ],
      "view": "angle",
      "id": "step-2"
    },
    {
      "title": "Пункт 1: площадь",
      "prompt": "Какова площадь ABC₁?",
      "explanation": "S=(1/2)AB·C₁M=(1/2)a·(a√7/2)=a²√7/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь треугольника через основание и высоту."
        }
      ],
      "view": "section",
      "id": "step-3"
    },
    {
      "title": "Пункт 2: угол",
      "prompt": "Какой угол является линейным?",
      "explanation": "Искомый угол φ=∠C₁MC, так как CM и C₁M перпендикулярны общему ребру AB. sinφ=CC₁/C₁M=2/√7=2√7/7. Поэтому φ=arcsin(2√7/7), равноценно arctg(2/√3).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейный угол двугранного угла и синус в прямоугольном треугольнике."
        }
      ],
      "view": "angle",
      "id": "step-4"
    }
