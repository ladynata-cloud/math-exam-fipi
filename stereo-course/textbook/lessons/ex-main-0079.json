          }
        },
        {
          "kind": "theorem",
          "text": "Соответствующие рёбра противоположных граней параллельны.",
          "theoryId": "theory-013",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "13",
