  "steps": [
    {
      "title": "Один и тот же сдвиг",
      "prompt": "Какие отрезки задают перенос?",
      "explanation": "Все точки смещаются в одном направлении на расстояние AA₁. У куба AA₁,BB₁,CC₁,DD₁ равны, параллельны и сонаправлены. Поэтому A→A₁, B→B₁, C→C₁, D→D₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение параллельного переноса."
        }
      ],
      "view": "point",
      "id": "step-1"
    },
    {
      "title": "Пункты 1 и 2",
      "prompt": "Как задаётся образ отрезка?",
      "explanation": "1) Образ D — D₁. 2) Концы AB переходят в A₁,B₁, поэтому образ AB — отрезок A₁B₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При переносе образ отрезка соединяет образы его концов."
        }
      ],
      "view": "ab",
      "id": "step-2"
    },
    {
      "title": "Пункт 3",
      "prompt": "Куда переходят B и C?",
      "explanation": "B→B₁ и C→C₁, значит, BC→B₁C₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойство параллельного переноса."
        }
      ],
      "view": "bc",
      "id": "step-3"
    },
    {
      "title": "Пункт 4",
      "prompt": "Переносится ли диагональ так же, как ребро?",
      "explanation": "Да. Концы A,C переходят в A₁,C₁, поэтому диагональ AC переходит в A₁C₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образ отрезка определяется образами концов."
        }
      ],
      "view": "diag",
      "id": "step-4"
    }
