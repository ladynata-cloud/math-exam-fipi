  "help": [
    {
      "id": "h1",
      "question": "Как найти радиус круга?",
      "text": "Диагональ прямоугольника — диаметр описанной окружности.",
      "view": "cone"
    },
    {
      "id": "h2",
      "question": "Одинаковы ли высоты четырёх боковых треугольников?",
      "text": "У двух пар граней разные расстояния от O до сторон прямоугольника.",
      "view": "side8"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Площадь конуса",
      "prompt": "Чему равны радиус и образующая?",
      "explanation": "Диагональ равна 10 см, радиус — 5 см. По теореме Пифагора образующая равна 13 см. Полная площадь конуса равна π·5·(5+13) = 90π см².",
      "view": "cone",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус описанной окружности прямоугольника равен половине диагонали. Полная площадь конуса равна πr(r+l)."
        }
      ],
      "input": {
        "prompt": "Введи длину образующей в сантиметрах.",
        "accepted": [
          "13"
        ],
        "feedback": "Рассмотри прямоугольный треугольник с катетами 5 и 12."
      }
    },
    {
      "id": "step-2",
      "title": "Грани с основанием 8",
      "prompt": "Чему равны OM и SM?",
      "explanation": "OM = 3 см, SM = √(12²+3²) = 3√17 см. Две грани с основанием 8 см вместе имеют площадь 24√17 см².",
      "view": "side8",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота равнобедренного треугольника проходит через середину его основания."
        }
      ],
      "input": {
        "prompt": "Введи SM в сантиметрах.",
        "accepted": [
          "3*sqrt(17)"
        ],
        "feedback": "Используй катеты 12 и 3; вспомни, где середина стороны длины 8."
      }
    },
    {
      "id": "step-3",
      "title": "Грани с основанием 6",
      "prompt": "Чем высота SN отличается от SM?",
      "explanation": "ON = 4 см, SN = √(12²+4²) = 4√10 см. Две грани с основанием 6 см вместе дают 24√10 см².",
      "view": "side6",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расстояние от центра прямоугольника до стороны равно половине длины смежной стороны."
        }
      ],
      "input": {
        "prompt": "Введи SN в сантиметрах.",
        "accepted": [
          "4*sqrt(10)"
        ],
        "feedback": "При стороне 6 другой катет равен половине стороны длины 8."
      }
    },
    {
      "id": "step-4",
      "title": "Составь отношение",
      "prompt": "Что ещё входит в полную площадь пирамиды?",
      "explanation": "Основание даёт 48 см². Делим 48+24√17+24√10 на 90π. Получаем (8+4√17+4√10)/(15π).",
      "view": "neutral",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная площадь многогранника равна сумме площадей всех его граней."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь зависимость от размера",
      "prompt": "Все размеры увеличили вдвое. Во сколько раз изменится отношение?",
      "explanation": "Останется тем же: каждая площадь возрастёт в 4 раза.",
      "view": "cone",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площади подобных фигур относятся как квадраты коэффициента подобия."
        }
      ],
      "input": {
        "prompt": "Введи множитель для отношения площадей.",
        "accepted": [
          "1"
        ],
        "feedback": "Обе площади увеличиваются в четыре раза."
      }
    }
  ],
  "answer": {
