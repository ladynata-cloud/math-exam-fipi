  "steps": [
    {
      "id": "step-1",
      "title": "Построим высоту и проекцию вершины",
      "prompt": "Как получить сечение, перпендикулярное гипотенузе?",
      "explanation": "Обозначим гипотенузу AB, прямой угол — C, катет — a. Пусть H — середина AB, а C₁ — проекция C на α. Тогда CH⊥AB. Проекция CH — C₁H — также перпендикулярна AB, если C₁≠H.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота равнобедренного треугольника; обратная теорема о трёх перпендикулярах.",
          "theoryId": "theory-020",
          "source": {
