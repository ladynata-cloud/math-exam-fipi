  "help": [
    {
      "id": "h1",
      "question": "Зачем нужен контрпример?",
      "text": "Достаточно показать один наклонный диск, на котором оба параллельных уровня горизонтальны. Он опровергает надёжность такой проверки.",
      "theoryIds": [
