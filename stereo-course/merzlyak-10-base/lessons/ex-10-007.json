  "steps": [
    {
      "title": "Проведи общий перпендикуляр",
      "prompt": "Как обосновать шаг «проведи общий перпендикуляр»?",
      "explanation": "Обозначим наклонные AB, AC, а перпендикуляр к плоскости — AH. Их проекции — HB и HC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ортогональная проекция отрезка соединяет ортогональные проекции его концов."
        }
      ],
      "view": "height",
      "id": "step-1"
    },
    {
      "title": "Сравни квадраты",
      "prompt": "Как обосновать шаг «сравни квадраты»?",
      "explanation": "AB²=AH²+HB² и AC²=AH²+HC². Вычитая равенства, получаем AB²−AC²=HB²−HC².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Используй условие",
      "prompt": "Как обосновать шаг «используй условие»?",
      "explanation": "AB=AC. Из AB²=AC² следует HB²=HC² и HB=HC. Длины положительны, поэтому сравнение квадратов сохраняет сравнение длин.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Монотонность возведения неотрицательных чисел в квадрат."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    }
