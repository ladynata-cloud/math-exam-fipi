    {
      "title": "Обоснуй второй прямой угол",
      "prompt": "Обоснуй второй прямой угол. Объясни свой выбор.",
      "explanation": "Из α⊥β и BD⊥(α∩β) следует BD⊥α, значит BD⊥AD. Треугольник ADB прямоугольный.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В двух перпендикулярных плоскостях прямая одной плоскости, перпендикулярная их общей прямой, перпендикулярна другой плоскости."
        }
      ],
      "view": "tri",
      "id": "step-2"
    },
    {
      "title": "Вычисли BD",
      "prompt": "Вычисли BD. Объясни свой выбор.",
      "explanation": "BD=√(AB²−AD²)=√(17²−15²)=√64=8 см. Ответ: 8 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
