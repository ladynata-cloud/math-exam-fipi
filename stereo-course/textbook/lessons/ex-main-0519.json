  "help": [
    {
      "id": "h1",
      "question": "Какие уравнения даёт теорема Пифагора?",
      "text": "Для рёбер x, y, z запиши x²+y² = 49, x²+z² = 64 и y²+z² = 81.",
      "view": "pair"
    },
    {
      "id": "h2",
      "question": "Зачем сложить три уравнения?",
      "text": "Сумма их левых частей равна удвоенной сумме квадратов всех трёх рёбер.",
      "view": "edges"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Сложи квадраты",
      "prompt": "Чему равно x²+y²+z²?",
      "explanation": "(49+64+81)/2 = 97.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждый квадрат ребра входит в две диагональные формулы."
        }
      ],
      "view": "pair",
      "input": {
        "prompt": "Сумма квадратов рёбер",
        "accepted": [
          "97"
        ],
        "feedback": "Раздели сумму трёх квадратов диагоналей на два."
      }
    },
    {
      "id": "step-2",
      "title": "Восстанови рёбра",
      "prompt": "Каков наименьший из трёх квадратов рёбер?",
      "explanation": "Вычитание даёт 97−81 = 16, 97−64 = 33, 97−49 = 48. Наименьшее ребро равно 4 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждая диагональ грани исключает одно из трёх рёбер."
        }
      ],
      "view": "edges",
      "input": {
        "prompt": "Наименьший квадрат",
        "accepted": [
          "16"
        ],
        "feedback": "Для наименьшего остатка вычти наибольший квадрат диагонали."
      }
    },
    {
      "id": "step-3",
      "title": "Умножь длины",
      "prompt": "Каков объём в см³?",
      "explanation": "V = √16·√33·√48 = 4·√33·4√3 = 48√11 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём вычисляют по действительным длинам, а не по их квадратам.",
          "theoryId": "theory-053"
        }
      ],
      "view": "edges",
      "input": {
        "prompt": "Объём в см³",
        "accepted": [
          "48*sqrt(11)"
        ],
        "feedback": "Под корнем 33·48 удобно выделить полный квадрат."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь на знакомых рёбрах",
      "prompt": "У другого тела квадраты диагоналей равны 13, 20 и 25. Каков объём?",
      "explanation": "Сумма квадратов рёбер равна 29. Сами квадраты 4, 9, 16; рёбра 2, 3, 4, объём 24.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждый новый набор диагоналей должен давать три положительных квадрата рёбер."
        }
      ],
      "view": "pair",
      "input": {
        "prompt": "Объём нового тела",
        "accepted": [
          "24"
        ],
        "feedback": "После сложения и деления на два вычти каждый квадрат диагонали."
      }
    }
