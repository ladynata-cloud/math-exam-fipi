  "steps": [
    {
      "title": "Пункт 1",
      "prompt": "Почему BC перпендикулярна направлению AA₁?",
      "explanation": "Центр O лежит на медиане AM равностороннего ABC, поэтому BC⊥AO. Также BC перпендикулярна вертикальному направлению A₁O. Следовательно BC перпендикулярна плоскости AA₁O и прямой AA₁. Так как BB₁∥AA₁, грань BB₁C₁C — прямоугольник.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой плоскости."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Угол при A",
      "prompt": "Как найти угол AA₁ с AB?",
      "explanation": "Проекция O на AB — середина AB, поскольку центр равностороннего треугольника лежит на серединном перпендикуляре к каждой стороне. Проекция AA₁ на AB имеет длину a/2; AA₁=a, поэтому cos∠A₁AB=1/2 и угол равен 60°. Аналогично ∠A₁AC=60°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ортогональная проекция и косинус угла."
        }
      ],
      "view": "angle",
      "id": "step-2"
    },
    {
      "title": "Пункт 2",
      "prompt": "Как сложить три площади?",
      "explanation": "Две грани при AB и AC имеют площадь a²sin60°=a²√3/2 каждая. Прямоугольник BB₁C₁C имеет стороны a,a и площадь a². Итого Sбок=a²(√3+1).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь параллелограмма и прямоугольника."
        }
      ],
      "view": "rectangle",
      "id": "step-3"
    }
