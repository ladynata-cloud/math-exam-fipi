  "help": [
    {
      "id": "h1",
      "question": "Как найти радиус через острый угол?",
      "text": "Середина K короткой стороны BC находится на биссектрисе угла BOC между половинами диагоналей. В прямоугольном OCK катет CK = a/2 лежит напротив φ₁/2.",
      "view": "diagonal"
    },
    {
      "id": "h2",
      "question": "Где виден угол наклона боковой грани?",
      "text": "Проведи KS и KO поперёк ребра BC. Получится прямоугольный треугольник KOS с углом SKO = φ₂. Отсюда SO = OK tan φ₂.",
      "view": "slope"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Половина длинной стороны",
      "prompt": "На модели a = 2 и tan(φ₁/2) = 1/2. Чему равно OK?",
      "explanation": "CK = a/2 = 1. В OCK тангенс половины угла равен CK/OK. Поэтому OK = 2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали прямоугольника симметричны относительно прямой OK."
        }
      ],
      "view": "diagonal",
      "input": {
        "prompt": "Длина OK",
        "accepted": [
          "2"
        ],
        "feedback": "Бери половину меньшей стороны и тангенс половины угла."
      }
    },
    {
      "id": "step-2",
      "title": "Квадрат радиуса",
      "prompt": "Найди квадрат OC.",
      "explanation": "OC² = OK²+CK² = 4+1 = 5. В буквенном виде R = a/(2sin(φ₁/2)).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Описанная окружность прямоугольника проходит через каждую его вершину."
        }
      ],
      "view": "diagonal",
      "input": {
        "prompt": "Квадрат радиуса",
        "accepted": [
          "5"
        ],
        "feedback": "Диагональ целиком равна диаметру; здесь нужен отрезок от O до C."
      }
    },
    {
      "id": "step-3",
      "title": "Высота и объём",
      "prompt": "При φ₂ = 45° каков коэффициент при π в объёме конуса?",
      "explanation": "SO = OK tan φ₂ = 2. Получаем V = 10π/3. После подстановки углов V = πa³ tan φ₂/[24sin²(φ₁/2)tan(φ₁/2)].",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём конуса вычисляют по круглому основанию, площадь которого πR².",
          "theoryId": "theory-059"
        }
      ],
      "view": "slope",
      "input": {
        "prompt": "Коэффициент объёма",
        "accepted": [
          "10/3"
        ],
        "feedback": "Используй площадь всего круга и перпендикулярную высоту."
      }
    },
    {
      "id": "step-4",
      "title": "Измени боковой наклон",
      "prompt": "При том же прямоугольнике увеличь tan φ₂ до 2. Каков новый коэффициент при π?",
      "explanation": "Теперь высота 4. Радиус прежний, поэтому объём равен 20π/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Наклон боковой грани задаёт высоту независимо от радиуса фиксированного основания."
        }
      ],
      "view": "slope",
      "input": {
        "prompt": "Новый коэффициент",
        "accepted": [
          "20/3"
        ],
        "feedback": "Меняется высота, а не диаметр основания."
      }
    }
  ],
  "answer": {
    "mode": "manual",
    "prompt": "Запиши V через a, φ₁ и φ₂.",
    "feedback": "V = πa³ tan φ₂/[24sin²(φ₁/2)tan(φ₁/2)]."
  },
