  "steps": [
    {
      "title": "Найди боковую сторону",
      "prompt": "Как обосновать шаг «найди боковую сторону»?",
      "explanation": "У описанного четырёхугольника суммы противоположных сторон равны. Боковые стороны равны, поэтому каждая равна (16+36)/2=26 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равенство отрезков касательных."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Найди высоту трапеции",
      "prompt": "Как обосновать шаг «найди высоту трапеции»?",
      "explanation": "Горизонтальный отрезок у каждой боковой стороны равен (36−16)/2=10. Высота h=√(26²−10²)=24 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Найди радиус",
      "prompt": "Как обосновать шаг «найди радиус»?",
      "explanation": "Окружность касается двух параллельных оснований, поэтому диаметр равен высоте: r=12 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расстояние между параллельными касательными равно диаметру."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    },
    {
      "title": "Найди все расстояния",
      "prompt": "Как обосновать шаг «найди все расстояния»?",
      "explanation": "Для каждой точки касания T имеем MT⊥стороне и MT=√(MO²+r²)=√(16²+12²)=20 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах: прямая плоскости перпендикулярна наклонной тогда и только тогда, когда перпендикулярна её проекции. Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
