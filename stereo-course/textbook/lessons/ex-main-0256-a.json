  "help": [
    {
      "id": "h1",
      "question": "Как не перепутать углы?",
      "text": "α — плоский угол ∠ASB одной боковой грани. Для прямоугольного треугольника внутри этой грани используется α/2. Углы между плоскостями строятся отдельно.",
      "theoryIds": [
        "theory-033"
      ],
      "children": [
        {
          "id": "h1-detail",
          "question": "Почему α меньше 90°?",
          "text": "При α = 90° боковое ребро стало бы равно радиусу квадрата m/√2, а высота стала бы нулевой."
        }
      ]
    }
  ],
  "steps": [
    {
      "title": "Используй половину плоского угла",
      "prompt": "Что даёт апофема SE в боковой грани?",
      "explanation": "E — середина AB, AE = m/2. В равнобедренной грани SAB апофема SE делит угол α пополам. Поэтому SA = m/(2sin(α/2)), SE = (m/2)ctg(α/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота правильной пирамиды проходит через центр правильного основания; боковые рёбра равны, боковые грани — равные равнобедренные треугольники.",
