  "help": [
    {
      "id": "h1",
      "question": "Сколько треугольных граней у одной вершины?",
      "text": "Икосаэдр имеет 20 треугольных граней. В каждой вершине сходятся пять. Их центры переставляются поворотом вокруг оси через центр O и эту вершину.",
      "view": "reason"
    },
    {
      "id": "h2",
      "question": "Как убедиться, что за пятиугольником нет других центров?",
      "text": "Вершина P принадлежит пяти исходным граням. Если r — радиус вписанной сферы, для центров этих граней c выполняется P·c = r². Для каждого другого центра P·c < r². Значит, пятиугольник лежит на опорной плоскости.",
      "view": "dual"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Поворот пяти центров",
      "prompt": "На какой угол в градусах нужно повернуть рисунок вокруг OP, чтобы передвинуть каждый центр к соседнему?",
      "input": {
        "prompt": "Поворот пяти центров",
        "accepted": [
          "72"
        ],
        "feedback": "Ищи угол вокруг центра пятиугольника, а не внутренний угол при его вершине."
      },
      "explanation": "Пять одинаковых поворотов дают полный оборот, поэтому угол равен 360°/5 = 72°. Все пять точек имеют общий осевой уровень и одинаковое расстояние до оси.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пять одинаковых поворотов дают полный оборот, поэтому угол равен 360°/5 = 72°. Все пять точек имеют общий осевой уровень и одинаковое расстояние до оси.",
          "theoryId": "theory-036-icosahedron"
