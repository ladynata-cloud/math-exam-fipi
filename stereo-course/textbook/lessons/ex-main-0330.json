  "help": [
    {
      "question": "С чего начать, если радиус неизвестен?",
      "text": "Из площади сечения и высоты найди вторую сторону прямоугольника.",
      "theoryIds": [
        "theory-038"
      ],
      "view": "rectangle",
      "id": "h1"
    },
    {
      "question": "Почему нельзя взять катет 24 дм?",
      "text": "Перпендикуляр из центра делит хорду пополам; катетом станет половина её длины.",
      "view": "foot",
      "id": "h2"
    },
    {
      "question": "Где на рисунке радиус?",
      "text": "Соедини центр основания с концом хорды. Этот отрезок — гипотенуза, а не один из катетов.",
      "view": "triangle",
      "id": "h3"
    }
  ],
  "steps": [
    {
      "title": "Восстанови хорду из площади",
      "prompt": "Какая сторона прямоугольника уже известна?",
      "explanation": "Сечение ABB₁A₁ — прямоугольник. Его вертикальная сторона AA₁ равна высоте цилиндра, то есть 10 дм. Поэтому из равенства AB · 10 = 240 находим AB = 24 дм. Это полная хорда нижнего основания.",
      "view": "rectangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость, параллельная оси прямого кругового цилиндра и пересекающая его внутренность, даёт прямоугольник: его вертикальные стороны — образующие, а горизонтальные — равные хорды оснований.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "Площадь прямоугольника равна произведению соседних сторон."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Раздели хорду пополам",
      "prompt": "Какую длину надо использовать в прямоугольном треугольнике?",
      "explanation": "Пусть O — центр нижнего основания. Опустим OM ⟂ AB. Тогда M — середина хорды, AM = 12 дм. Отрезок OM перпендикулярен также вертикальной прямой через M, а значит, всей секущей плоскости. Поэтому OM = 9 дм — указанное расстояние от оси до плоскости.",
      "view": "foot",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикуляр, опущенный из центра окружности на хорду, делит эту хорду пополам."
        },
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости; все образующие перпендикулярны основанию.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Найди радиус как гипотенузу",
      "prompt": "Нужно складывать или вычитать квадраты?",
      "explanation": "Радиус OA является гипотенузой прямоугольного треугольника OMA. Поэтому OA² = OM² + AM² = 9² + 12² = 225. Радиус положителен, следовательно, r = OA = 15 дм.",
      "view": "triangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора; радиус окружности положителен."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Проверь восстановленный цилиндр",
      "prompt": "Получается ли исходная площадь?",
      "explanation": "Расстояние 9 дм меньше радиуса 15 дм, поэтому сечение невырожденное. Хорда имеет длину 2√(15² − 9²) = 24 дм. При высоте 10 дм её сечение имеет площадь 24 · 10 = 240 дм². Все условия выполнены; радиус равен 15 дм.",
      "view": "area",
      "justifications": [
