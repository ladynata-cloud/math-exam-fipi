  "help": [
    {
      "question": "Как не спутать P и Q?",
      "text": "Поверни заднюю грань к себе. P лежит между B и Q; до верхнего ребра B₁C₁ прямая доходит в Q. Плоская проекция создаёт впечатление, будто P уже на верхней грани.",
      "theoryIds": [],
      "children": [],
      "id": "help-1"
    }
  ],
  "steps": [
    {
      "title": "MK и основание",
      "prompt": "Где красная прямая встречает плоскость основания?",
      "explanation": "MK пересекает ABD в R. R лежит на DC, а DC⊂ABD. M не лежит в ABD, поэтому вся MK в ней не лежит и второй общей точки быть не может.",
      "justifications": [
        {
          "kind": "given",
          "text": "K,M,R коллинеарны; R∈DC; M вне основания."
        },
        {
          "kind": "theorem",
          "text": "Не лежащая в плоскости прямая имеет с ней не более одной общей точки.",
          "theoryId": "atanasyan2024-theory-002-a2"
        }
      ],
      "view": "mk",
      "id": "step-1"
    },
    {
      "title": "DK и верхняя плоскость",
      "prompt": "С какой прямой совпадает DK?",
      "explanation": "K∈DD₁, поэтому DK=DD₁. Её пересечение с A₁B₁C₁ — D₁. D вне верхней плоскости, значит, пересечение единственно.",
      "justifications": [
        {
          "kind": "given",
          "text": "K∈DD₁, D₁ принадлежит верхней плоскости."
        },
        {
          "kind": "theorem",
          "text": "Следствие A2 о единственности общей точки.",
          "theoryId": "atanasyan2024-theory-002-a2"
        }
      ],
      "view": "top",
      "id": "step-2"
    },
    {
      "title": "BP и верхняя плоскость",
      "prompt": "Какая из точек P и Q находится на верхнем ребре?",
      "explanation": "B,P,Q коллинеарны. Q лежит на B₁C₁, следовательно, Q принадлежит A₁B₁C₁. P — внутренняя точка BQ, а не верхней грани. Поэтому BP∩A₁B₁C₁={Q}.",
      "justifications": [
        {
          "kind": "given",
          "text": "P∈BQ и Q∈B₁C₁ по рисунку9."
        },
        {
          "kind": "theorem",
          "text": "B не лежит в верхней плоскости; по A2 общей точки не может быть две.",
          "theoryId": "atanasyan2024-theory-002-a2"
        }
      ],
      "view": "back",
      "id": "step-3"
    }
