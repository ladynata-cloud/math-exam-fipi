  "steps": [
    {
      "title": "Найди площадь основания",
      "prompt": "Как распознать треугольник со сторонами 3, 4 и 5?",
      "explanation": "В треугольнике ABD имеем BD² + AD² = 3² + 4² = 25. Также AB² = 5² = 25. Значит ∠ADB = 90°. Его площадь равна 3·4/2=6 м², а площадь параллелограмма вдвое больше: Sосн=12 м².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обратная теорема Пифагора."
        },
        {
          "kind": "theorem",
          "text": "Площадь треугольника равна половине произведения стороны на высоту к её несущей прямой."
        },
        {
          "kind": "theorem",
          "text": "Диагональ параллелограмма делит его на два равных треугольника."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Найди расстояния от центра до прямых сторон",
      "prompt": "Почему надо взять половины высот основания?",
      "explanation": "Высоты параллелограмма к сторонам 5 и 4 равны 12/5 и 3 м. Центр O находится посередине между противоположными прямыми, поэтому расстояния равны 6/5 и 3/2 м. На рисунке первое — OE, второе — OD: BD⊥AD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула площади параллелограмма и центральная симметрия его противоположных сторон."
        }
      ],
      "view": "radii",
      "id": "step-2"
    },
    {
      "title": "Вычисли боковую площадь",
      "prompt": "Какие две высоты имеют боковые треугольники?",
      "explanation": "По теореме о трёх перпендикулярах PE⊥AB и PD⊥AD. PE=√(2²+(6/5)²)=2√34/5 м, PD=√(2²+(3/2)²)=5/2 м. Поэтому Sбок=2·5·PE/2+2·4·PD/2=2√34+10 м².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах.",
          "theoryId": "theory-020",
          "source": {
