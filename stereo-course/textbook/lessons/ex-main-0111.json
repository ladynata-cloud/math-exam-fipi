  "steps": [
    {
      "id": "step-1",
      "title": "Первое неравенство",
      "prompt": "Как сравнить AC1 с путём через C?",
      "explanation": "Рассмотрим диагональ AC1. В невырожденном треугольнике ACC1 по неравенству треугольника AC1 < AC + CC1.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сторона треугольника меньше суммы двух других.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        }
      ],
      "view": "path"
    },
    {
      "id": "step-2",
      "title": "Второе неравенство",
      "prompt": "Как оценить диагональ основания?",
      "explanation": "В треугольнике ABC имеем AC < AB + BC. Следовательно AC1 < AB + BC + CC1 = AB + AD + AA1, потому что BC = AD и CC1 = AA1. Эти три ребра имеют общую вершину A. Для любой другой пространственной диагонали аналогично выбираем путь по трём направлениям рёбер; сумма трёх длин одинакова при любой вершине.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Неравенство треугольника.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        },
