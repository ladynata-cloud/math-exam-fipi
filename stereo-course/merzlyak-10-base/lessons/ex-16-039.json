  "steps": [
    {
      "title": "Проекция высоты сечения",
      "prompt": "Как далеко середины верхних рёбер от AB в проекции?",
      "explanation": "Пусть сторона основания a. Высота равностороннего ABC равна a√3/2; проекция D — середина AC, поэтому расстояние KH до AB равно a√3/4. DK=6.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия и высота равностороннего треугольника."
        }
      ],
      "view": "angle",
      "id": "step-1"
    },
    {
      "title": "Сторона основания",
      "prompt": "Что даёт угол 60°?",
      "explanation": "tan60°=DK/KH=6/(a√3/4). Следовательно a=8 см, DE=a/2=4 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейный угол двугранного угла и тангенс."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Высота и площадь трапеции",
      "prompt": "Чему равна DH?",
      "explanation": "KH=2√3, поэтому DH=√((2√3)²+6²)=4√3. Тогда S=(AB+DE)·DH/2=(8+4)·4√3/2=24√3 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор и площадь трапеции."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
