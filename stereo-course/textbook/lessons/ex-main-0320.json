  "help": [
    {
      "question": "Какая фигура получится в плоскости через ось?",
      "text": "Осевое сечение имеет стороны 2r и h. Назови, какие из них лежат в основаниях, а какие являются образующими.",
      "theoryIds": [
        "theory-038"
      ],
      "view": "rectangle",
      "id": "h1"
    },
    {
      "question": "Как выбрать прямоугольный треугольник?",
      "text": "Проведи диагональ AB₁. Катеты треугольника ABB₁ — диаметр AB и образующая BB₁. Примени теорему Пифагора к диаметру и высоте.",
      "view": "triangle",
      "id": "h2"
    }
  ],
  "steps": [
    {
      "title": "Найди стороны в основаниях",
      "prompt": "Почему линии сечения оснований проходят через их центры?",
      "explanation": "Осевой плоскости принадлежит ось OO₁. Поэтому она проходит через центры обоих оснований. Её пересечения с кругами оснований — диаметры AB и A₁B₁. Плоскости оснований параллельны, значит эти диаметры параллельны.",
      "view": "bases",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ось цилиндра соединяет центры его равных оснований; осевое сечение проходит через эту ось.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "Если две параллельные плоскости пересечены третьей, линии пересечения параллельны.",
          "theoryId": "theory-011",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "11",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
              22
