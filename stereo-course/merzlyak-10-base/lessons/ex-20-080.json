  "steps": [
    {
      "title": "Найди след и перпендикуляр",
      "prompt": "Как обосновать шаг «найди след и перпендикуляр»?",
      "explanation": "След секущей плоскости в основании — EF. EF∥AC как средняя линия DAC. Следовательно BD⊥EF; точка H=BD∩EF — середина EF.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия и перпендикулярность диагоналей квадрата."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Вычисли BH",
      "prompt": "Как обосновать шаг «вычисли bh»?",
      "explanation": "Если ребро a, высота D до AC равна a/√2, а EF проходит посередине между D и AC. Вдоль BD получаем DH=a/(2√2), BH=a√2−a/(2√2)=3a√2/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подобие треугольников при средней линии."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Назови линейный угол",
      "prompt": "Как обосновать шаг «назови линейный угол»?",
      "explanation": "MB⊥основанию, BH⊥EF; по теореме о трёх перпендикулярах MH⊥EF. Искомый острый угол — ∠MHB.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах: прямая плоскости перпендикулярна наклонной тогда и только тогда, когда перпендикулярна её проекции."
        }
      ],
      "view": "angle",
      "id": "step-3"
    },
    {
      "title": "Найди тангенс",
      "prompt": "Как обосновать шаг «найди тангенс»?",
      "explanation": "MB=a/2, поэтому tanθ=(a/2)/(3a√2/4)=√2/3. Ответ arctg(√2/3).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс прямоугольного треугольника."
        }
      ],
