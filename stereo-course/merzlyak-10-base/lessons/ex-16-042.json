  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "В отличие от квадратного основания здесь основание сечения равно a, а не a√2."
    }
  ],
  "steps": [
    {
      "title": "Стороны треугольника",
      "prompt": "Как связаны L,a,h?",
      "explanation": "Пусть L — диагональ боковой грани, a — сторона основания. Тогда L²=a²+h². В сечении BA₁C две стороны равны L, а третья равна a.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор в боковой грани."
        }
      ],
      "view": "face",
      "id": "step-1"
    },
    {
      "title": "Устраняем a",
      "prompt": "Что даёт теорема косинусов?",
      "explanation": "a²=2L²(1−cosα). Значит h²=L²−a²=L²(2cosα−1), откуда L²=h²/(2cosα−1). Положительность h требует 0<α<60°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов и положительность квадрата длины."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Чему равно S?",
      "explanation": "S=L²sinα/2=h²sinα/[2(2cosα−1)]. Равносильная запись: h²sinα/[2(1−4sin²(α/2))].",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь по двум сторонам и углу; cosα=1−2sin²(α/2)."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
