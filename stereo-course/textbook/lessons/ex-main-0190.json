  "steps": [
    {
      "title": "а) Выбери линейный угол",
      "prompt": "Какие лучи из B перпендикулярны ребру BB₁ и лежат в нужных гранях?",
      "explanation": "BA и BC перпендикулярны BB₁. Они направлены в соответствующие полуплоскости, поэтому ∠ABC — линейный угол ABB₁C. Он равен 90°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейный угол двугранного угла.",
          "theoryId": "theory-022",
          "source": {
