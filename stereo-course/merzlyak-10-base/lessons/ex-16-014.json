      "view": "side",
      "id": "step-1"
    },
    {
      "title": "Два основания",
      "prompt": "Сколько площади они добавляют?",
      "explanation": "Каждое основание — квадрат площади a². Два основания дают 2a².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь квадрата."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Полная поверхность",
      "prompt": "Как объединить неперекрывающиеся грани?",
      "explanation": "Sполн=Sбок+2Sосн=4aH+2a².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение площади полной поверхности призмы."
