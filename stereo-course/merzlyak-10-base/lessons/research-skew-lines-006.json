  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Рассмотрите плоскость AB₁C₁. Прямая A₁B перпендикулярна ей; остаётся опустить перпендикуляр из центра грани на AC₁."
    }
  ],
  "steps": [
    {
      "title": "Подходящая плоскость",
      "prompt": "Пусть O — центр грани ABB₁A₁.",
      "explanation": "Как в дополнительной задаче 1, A₁B⊥плоскости AB₁C₁: она перпендикулярна AB₁ и направлению BC. Точка O=A₁B∩AB₁ — центр грани ABB₁A₁ и точка пересечения прямой A₁B с плоскостью AB₁C₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости."
        }
      ],
      "view": "plane",
      "id": "step-1"
    },
    {
      "title": "Общий перпендикуляр",
      "prompt": "Опустите из O перпендикуляр OH на AC₁.",
      "explanation": "OH лежит в плоскости AB₁C₁, поэтому OH⊥A₁B; по построению OH⊥AC₁. Точки O и H принадлежат двум заданным прямым. Значит, искомое расстояние d=OH.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расстояние между скрещивающимися прямыми равно длине их общего перпендикуляра."
        }
      ],
      "view": "height",
      "id": "step-2"
    },
    {
      "title": "Площадь двумя способами",
      "prompt": "Найдите площадь треугольника AOC₁.",
      "explanation": "AO=AB₁/2=a√2/2. Прямая B₁C₁ перпендикулярна AB₁ и имеет длину a, поэтому S(AOC₁)=AO·a/2=a²√2/4. С другой стороны, AC₁=a√3, а S=AC₁·OH/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула площади треугольника через основание и высоту; диагонали куба."
        }
      ],
      "view": "area",
      "id": "step-3"
    },
    {
      "title": "Ответ",
      "prompt": "Выразите OH.",
      "explanation": "d=OH=2S/AC₁=(a²√2/2)/(a√3)=a√6/6. На модели при a=1 точка H делит AC₁ в отношении AH:HC₁=1:2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Алгебраическое преобразование полученного равенства."
        }
      ],
      "view": "height",
      "id": "step-4"
    }
