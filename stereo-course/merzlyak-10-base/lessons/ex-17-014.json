  "steps": [
    {
      "title": "Большая диагональ основания",
      "prompt": "Какой знак у смешанного члена?",
      "explanation": "Для суммы двух сторон при остром угле p²=(2√2)²+4²+2·2√2·4 cos45°=8+16+16=40. Большая диагональ соответствует знаку плюс.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов в параллелограмме."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота",
      "prompt": "Как найти h?",
      "explanation": "7²=p²+h², поэтому h²=49−40=9 и h=3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор в диагональном сечении."
        }
      ],
      "view": "space",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Каков периметр?",
      "explanation": "P=2(2√2+4)=4√2+8. Значит Sбок=3P=12√2+24=12(√2+2) см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр параллелограмма и формула боковой поверхности."
        }
      ],
      "view": "side",
      "id": "step-3"
