  "steps": [
    {
      "title": "Перенеси второй перпендикуляр",
      "prompt": "Как получить в одной плоскости линейный угол 120°?",
      "explanation": "В грани с BD проведи AE∥BD так, чтобы AE=BD=a и лучи AE,BD шли в одну сторону от ребра. Тогда ABDE — прямоугольник, DE∥AB и DE=a. Лучи AC и AE перпендикулярны ребру при A и лежат в разных гранях, поэтому ∠CAE=120°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Параллелограмм с прямым углом — прямоугольник."
        },
        {
          "kind": "theorem",
          "text": "Линейный угол двугранного угла.",
          "theoryId": "theory-022",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "22",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              50,
              51
            ],
            "pdfPages": [
              52,
              53
            ],
            "subpart": "definition-and-linear-angle"
          }
        }
      ],
      "view": "shift",
      "id": "step-1"
    },
    {
      "title": "Найди CE",
      "prompt": "Что даёт теорема косинусов при угле 120°?",
      "explanation": "CE²=a²+a²−2a²cos120°=3a².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов; cos120°=−1/2."
        }
      ],
      "view": "shift",
      "id": "step-2"
    },
    {
      "title": "Добавь смещение вдоль ребра",
      "prompt": "Почему CE⊥DE?",
      "explanation": "Плоскость ACE содержит две пересекающиеся прямые AC и AE, перпендикулярные AB. Следовательно AB⊥(ACE), и DE∥AB также перпендикулярна CE. В прямоугольном CED получаем CD²=CE²+DE²=3a²+a²=4a², значит CD=2a. Выбор направления AB вдоль ребра не меняет длины.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости.",
