  "steps": [
    {
      "title": "Сравни диагонали основания",
      "prompt": "Какая диагональ противолежит острому углу 60°?",
      "explanation": "Пусть AB=15 см, AD=8 см и ∠BAD=60°. Тогда BD²=15²+8²−2·15·8·cos60°=169, то есть BD=13 см. Другая диагональ удовлетворяет AC²=15²+8²+2·15·8·cos60°=409, поэтому BD<AC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов для двух треугольников параллелограмма."
        }
      ],
      "view": "diagonal",
      "id": "step-1"
    },
    {
      "title": "Найди высоту",
      "prompt": "Почему меньшему сечению соответствует меньшая диагональ основания?",
      "explanation": "Диагональные сечения прямого параллелепипеда — прямоугольники с одинаковой высотой h и основаниями BD и AC. Поэтому меньшая площадь равна BD·h=130 см². Получаем h=130/13=10 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковые рёбра прямой призмы перпендикулярны основаниям; боковые грани — прямоугольники.",
