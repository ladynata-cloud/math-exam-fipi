  "help": [
    {
      "id": "help-1",
      "question": "Как начать?",
      "text": "Проведи через E и F две прямые одного направления в параллельных основаниях."
    }
  ],
  "steps": [
    {
      "title": "Нижний след",
      "prompt": "Как найти вторую точку в основании?",
      "explanation": "Через E проводим e∥a; в положении модели она пересекает AD в P. Искомая плоскость должна содержать эту прямую.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость через точку и заданное параллельное направление."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Верхний след",
      "prompt": "Почему его можно провести сразу?",
      "explanation": "Через F в верхней грани проводим f∥a, значит f∥e. Она пересекает B₁C₁ в Q. Две параллельные прямые e,f определяют плоскость через E,F.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Следы в параллельных основаниях параллельны."
        }
      ],
      "view": "top",
      "id": "step-2"
    },
    {
      "title": "Боковые следы",
      "prompt": "Как получить недостающие вершины?",
      "explanation": "Продлим e и f до пересечений с плоскостью одной боковой грани, например ABB₁A₁: нижняя точка — E, верхняя — X=f∩A₁B₁ на продолжении. Прямая EX задаёт след этой грани и его точку на BB₁. В противоположной грани через F проводим параллельный след до DD₁. Соединяем соседние точки в передней и задней гранях.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две общие точки задают след; противоположные грани параллельны."
        }
      ],
      "view": "aux",
      "id": "step-3"
    },
    {
      "title": "Проверка",
      "prompt": "Почему это сечение удовлетворяет задаче?",
      "explanation": "Все построенные стороны принадлежат плоскости параллельных e,f; она проходит через E,F и содержит направление a. Так как a — другая прямая нижнего основания, плоскость с ней не пересекается. Выделенный многоугольник — её часть внутри параллелепипеда.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак параллельности прямой и плоскости."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
