              52,
              53
            ],
            "subpart": "definition-and-linear-angle"
          }
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Опусти высоты трапеции",
      "prompt": "Как найти AM и NB?",
      "explanation": "Опустим DM и CN на AB. В равнобедренной трапеции AM=NB=(AB−CD)/2=(25−9)/2=8 см. При этом DM=CN=8 см. Прямоугольные треугольники AMD и BNC имеют равные катеты.",
      "justifications": [
        {
          "kind": "given",
          "text": "Трапеция равнобедренная; её основания и высота заданы."
        },
        {
          "kind": "theorem",
          "text": "У равнобедренной трапеции выступающие за меньшее основание части большего основания равны."
        }
      ],
      "view": "feet",
      "id": "step-2"
    },
    {
      "title": "Найди острые углы",
      "prompt": "Какие углы получаются при основаниях равных катетов?",
      "explanation": "В прямоугольном равнобедренном AMD угол DAM=45°. Аналогично угол CBN=45°. Значит внутренние двугранные углы при AA₁ и BB₁ равны 45°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Острые углы прямоугольного равнобедренного треугольника равны 45°."
        }
      ],
      "view": "feet",
      "id": "step-3"
    },
    {
      "title": "Найди вторую пару",
      "prompt": "Почему два оставшихся угла не равны 45°?",
      "explanation": "Из AB∥CD следует ∠A+∠D=180° и ∠B+∠C=180°. Поэтому при CC₁ и DD₁ внутренние двугранные углы равны 135°. Все четыре угла: 45°, 45°, 135°, 135°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сумма внутренних односторонних углов при параллельных прямых равна 180°."
        }
      ],
      "view": "feet",
      "id": "step-4"
    }
