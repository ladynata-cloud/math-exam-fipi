  "steps": [
    {
      "title": "Общий множитель",
      "prompt": "Как записать неизвестные длины?",
      "explanation": "Пусть они k,2k,2k, где k>0. Коэффициент k имеет размерность длины.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Задание длин по отношению."
        }
      ],
      "view": "edges",
      "id": "step-1"
    },
    {
      "title": "Уравнение",
      "prompt": "Как использовать диагональ 6?",
      "explanation": "6²=k²+(2k)²+(2k)²=9k². Значит k²=4 и k=2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула диагонали прямоугольного параллелепипеда."
        }
      ],
      "view": "diagonal",
      "id": "step-2"
    },
    {
      "title": "Ответ",
      "prompt": "Каковы три измерения?",
      "explanation": "2 см,4 см,4 см. Их квадраты дают 4+16+16=36, то есть нужную диагональ 6.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подстановка найденного множителя и проверка."
        }
      ],
      "view": "edges",
      "id": "step-3"
    }
