  "steps": [
    {
      "title": "Площади сечений",
      "prompt": "Как выразить их через диагонали p,q и высоту h?",
      "explanation": "Диагональные сечения — прямоугольники, поэтому S₁=ph, S₂=qh.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойства прямого параллелепипеда."
        }
      ],
      "view": "sections",
      "id": "step-1"
    },
    {
      "title": "Сторона ромба",
      "prompt": "Как связать a с p,q?",
      "explanation": "Диагонали ромба перпендикулярны и делятся пополам, поэтому a²=(p/2)²+(q/2)². Следовательно 4a²=p²+q².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор в четверти ромба."
        }
      ],
      "view": "triangle",
      "id": "step-2"
    },
    {
      "title": "Боковая площадь",
      "prompt": "Как исключить p,q,h?",
      "explanation": "Sбок=4ah=2√(p²h²+q²h²)=2√(S₁²+S₂²).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр ромба, боковая поверхность и положительность длин."
        }
      ],
      "view": "side",
      "id": "step-3"
    }
