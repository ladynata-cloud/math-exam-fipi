    {
      "title": "Пространственный треугольник",
      "prompt": "Как добавить высоту?",
      "explanation": "ACC₁ прямоугольный при C, поэтому AC₁²=AC²+CC₁²=13+36=49.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярность высоты основанию и теорема Пифагора."
        }
      ],
      "view": "space",
      "id": "step-2"
    },
    {
      "title": "Ответ",
      "prompt": "Как выбрать корень?",
      "explanation": "Длина положительна, поэтому AC₁=√49=7 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение положительной длины."
        }
      ],
