  "steps": [
    {
      "title": "DK и ABC",
      "prompt": "На каком ребре лежит K?",
      "explanation": "K лежит на DC, поэтому DK — та же прямая, что DC. C принадлежит ABC, D не принадлежит ABC. Значит, DK пересекает ABC в C и не может иметь вторую общую точку.",
      "justifications": [
        {
          "kind": "given",
          "text": "K∈DC; C∈ABC; D∉ABC по рисунку8."
        },
        {
          "kind": "theorem",
          "text": "Если бы было две общие точки, вся прямая лежала бы в плоскости, вопреки D∉ABC.",
          "theoryId": "atanasyan2024-theory-002-a2"
        }
      ],
      "view": "abc",
      "id": "step-1"
    },
    {
      "title": "CE и ADB",
      "prompt": "Какая точка CE лежит на AB?",
      "explanation": "E лежит на AB⊂ADB, а C не лежит в ADB. Поэтому CE∩ADB={E}. Единственность общей точки снова следует из A2.",
      "justifications": [
        {
          "kind": "given",
          "text": "E∈AB, C∉ADB по рисунку8."
        },
        {
          "kind": "theorem",
          "text": "Прямая, не лежащая в плоскости, имеет с ней не более одной общей точки.",
          "theoryId": "atanasyan2024-theory-002-a2"
        }
