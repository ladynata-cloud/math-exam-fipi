  "help": [
    {
      "id": "h1",
      "question": "Какая высота нужна для площади грани?",
      "text": "Нужна высота самого бокового треугольника к стороне основания. Она образует прямоугольный треугольник с PO и расстоянием от O до прямой этой стороны. Высоты разных пар граней здесь различны.",
      "view": "face20"
    }
  ],
  "steps": [
    {
      "title": "Найди расстояния от O до сторон",
      "prompt": "Как площадь параллелограмма определяет две его высоты?",
      "explanation": "Расстояние между прямыми AB и CD равно 360/36=10 см, а между AD и BC равно 360/20=18 см. Центр O равноудалён от противоположных прямых, поэтому OE=5 см и OF=9 см, где E и F — основания перпендикуляров к прямым AB и AD. F может лежать на продолжении AD; на этой модели так и происходит.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь параллелограмма равна произведению стороны на соответствующую высоту."
        },
        {
          "kind": "theorem",
          "text": "Центральная симметрия относительно пересечения диагоналей меняет противоположные стороны параллелограмма местами."
        }
      ],
      "view": "distances",
      "id": "step-1"
    },
    {
      "title": "Найди высоты двух пар граней",
      "prompt": "Почему PE и PF перпендикулярны соответствующим сторонам?",
      "explanation": "Из PO⊥(ABCD), OE⊥AB и OF⊥AD следует PE⊥AB и PF⊥AD по теореме о трёх перпендикулярах. Поэтому высоты граней к сторонам 36 см равны √(12²+5²)=13 см, а к сторонам 20 см — √(12²+9²)=15 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах.",
          "theoryId": "theory-020",
          "source": {
