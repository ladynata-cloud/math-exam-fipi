  "steps": [
    {
      "id": "step-1",
      "title": "Обозначим сторону и высоту",
      "prompt": "Как выразить расстояние от B до AD?",
      "explanation": "Пусть сторона ромба равна a. Опустим BH⊥AD. В прямоугольном ABH: BH=AB·sin45°=a√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение синуса в прямоугольном треугольнике."
        }
      ],
      "view": "work"
    },
    {
      "id": "step-2",
      "title": "Свяжем два расстояния",
      "prompt": "Как угол 60° связывает BH с расстоянием до ADM?",
      "explanation": "Пусть K — основание перпендикуляра из B к ADM. По обратной теореме о трёх перпендикулярах HK⊥AD. Луч HK лежит в той полуграни плоскости ADM, которая содержит M, поскольку данный двугранный угол острый. Поэтому ∠BHK=60° и BK=BH·sin60°=a√6/4. В модели M выбран на луче HK; это удобство рисунка, а не дополнительное условие.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обратная теорема о трёх перпендикулярах; определение линейного угла; синус острого угла.",
          "theoryId": "theory-020",
