  "steps": [
    {
      "id": "step-1",
      "title": "Проверь нижнее основание",
      "prompt": "Какие противоположные стороны легко сравнить?",
      "explanation": "Так как AB=CD и AM=CN, получаем MB=AB−AM=CD−CN=DN. Прямые MB и DN параллельны как части параллельных AB и CD. Поэтому плоский четырёхугольник MBND — параллелограмм по паре равных и параллельных противоположных сторон. Тот же довод показывает, что M₁B₁N₁D₁ — параллелограмм.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Грани параллелепипеда — параллелограммы; соответствующие рёбра равны и параллельны.",
          "theoryId": "theory-013",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "13",
            "chapter": "I. Параллельность прямых и плоскостей",
