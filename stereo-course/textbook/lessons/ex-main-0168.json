  "steps": [
    {
      "id": "step-1",
      "title": "Проведём сечение поперёк ребра",
      "prompt": "Как перейти от двугранного угла к плоскому?",
      "explanation": "Пусть O — основание перпендикуляра из A на ребро. Проведём через O в другой грани луч OP, перпендикулярный ребру. Тогда ∠AOP=φ. Перпендикуляр AC к плоскости другой грани лежит в этой секущей плоскости, а C находится на прямой OP. Искомое расстояние — AO=r, известное — AC=d.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение линейного угла; плоскость, проведённая через две пересекающиеся прямые, перпендикулярные ребру, перпендикулярна ему. Проекция AO также перпендикулярна ребру.",
          "theoryId": "theory-020",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "20",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              44,
              45
            ],
            "pdfPages": [
              46,
              47
            ]
          }
        }
      ],
      "view": "acute"
    },
    {
      "id": "step-2",
      "title": "Разберём острый угол",
      "prompt": "Что связывает d и r в прямоугольном AOC?",
      "explanation": "При 0°<φ<90° точка C лежит на луче OP. Тогда sinφ=AC/AO=d/r, откуда r=d/sinφ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение синуса острого угла."
        }
      ],
      "view": "acute"
    },
    {
      "id": "step-3",
      "title": "Разберём прямой угол",
      "prompt": "Где находится проекция A при φ=90°?",
      "explanation": "При φ=90° точка C совпадает с O. Расстояния до ребра и плоскости равны: r=d. Та же формула даёт d/sin90°=d; вырожденный треугольник AOC использовать не нужно.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При перпендикулярных гранях отрезок AO перпендикулярен плоскости другой грани.",
          "theoryId": "theory-023",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "23",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              52,
              53
            ],
            "pdfPages": [
              54,
              55
            ],
            "subpart": "criterion-and-corollary"
          }
        }
      ],
      "view": "right"
    },
    {
      "id": "step-4",
      "title": "Разберём тупой угол",
      "prompt": "Почему нельзя считать C точкой полуграни с лучом OP?",
      "explanation": "При 90°<φ<180° точка C лежит на луче, противоположном OP. Угол AOC равен 180°−φ, и d=r·sin(180°−φ)=r·sinφ. Поэтому во всех случаях r=d/sinφ. Если A лежит на ребре, d=r=0 и формула тоже верна; при d>0 все построенные расстояния ненулевые.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "sin(180°−φ)=sinφ; расстояние берётся до всей плоскости, а не до выбранной полуграни."
        }
      ],
