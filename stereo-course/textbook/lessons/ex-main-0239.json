  "steps": [
    {
      "title": "Найди половины диагоналей",
      "prompt": "Почему AO=4 см, а OB находится по теореме Пифагора?",
      "explanation": "Диагонали ромба перпендикулярны и делятся пополам: AO=CO=4 см. В прямоугольном AOB имеем OB²=AB²−AO²=25−16=9, поэтому BO=DO=3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали ромба взаимно перпендикулярны и точкой пересечения делятся пополам."
        },
        {
          "kind": "theorem",
          "text": "Теорема Пифагора для прямоугольного треугольника."
        }
