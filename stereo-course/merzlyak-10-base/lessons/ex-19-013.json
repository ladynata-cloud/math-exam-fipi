      "id": "step-1"
    },
    {
      "title": "Сумма сторон",
      "prompt": "Сумма сторон — выполните этот шаг самостоятельно.",
      "explanation": "Проекция диагонали (a+b)/√2=H·ctgβ, поэтому a+b=√2Hctgβ.",
