  "steps": [
    {
      "title": "Равенство исходных длин",
      "prompt": "Почему AB=CD?",
      "explanation": "AB=2. У CD горизонтальное смещение 1, вертикальное √3, поэтому CD=√(1+3)=2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "original",
      "id": "step-1"
    },
    {
      "title": "Длины образов",
      "prompt": "Каковы проекции при вертикальном направлении?",
      "explanation": "A₁B₁=2, а C₁D₁=1. Вторая проекция короче, поскольку часть исходного отрезка направлена по высоте.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проекция на z=0 сохраняет горизонтальные координаты."
        }
      ],
      "view": "image",
      "id": "step-2"
    },
    {
      "title": "Вывод",
      "prompt": "Можно ли получить разные длины?",
      "explanation": "Да. Два равных отрезка разного направления могут иметь разные параллельные проекции.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Приведённый пример доказывает возможность."
        }
      ],
      "view": "image",
