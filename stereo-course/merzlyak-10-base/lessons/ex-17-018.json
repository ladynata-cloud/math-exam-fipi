  "steps": [
    {
      "title": "Связь с основанием",
      "prompt": "Чем различаются квадраты пространственных диагоналей?",
      "explanation": "Пусть диагонали основания p,q, общая высота h. Так как параллелепипед прямой, соответствующие пространственные диагонали имеют квадраты p²+h² и q²+h².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор в прямоугольных диагональных сечениях."
        }
      ],
      "view": "sections",
      "id": "step-1"
    },
    {
      "title": "Равные диагонали основания",
      "prompt": "Что следует из равенства диагоналей тела?",
      "explanation": "p²+h²=q²+h², откуда p²=q². Длины положительны, поэтому p=q.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вычитание одинаковых слагаемых."
        }
      ],
      "view": "sections",
      "id": "step-2"
    },
    {
      "title": "Вывод",
      "prompt": "Какой параллелограмм имеет равные диагонали?",
      "explanation": "Параллелограмм с равными диагоналями — прямоугольник. Основание поэтому прямоугольное; боковые рёбра уже перпендикулярны основанию, значит все грани прямоугольные и параллелепипед прямоугольный.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак прямоугольника и определение прямоугольного параллелепипеда."
        }
      ],
      "view": "base",
      "id": "step-3"
    }
