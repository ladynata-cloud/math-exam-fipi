  "steps": [
    {
      "id": "step-1",
      "title": "Параллельные опорные плоскости",
      "prompt": "Параллельные опорные плоскости",
      "explanation": "Поместим a,b в параллельные α,β. Их общий перпендикуляр MN перпендикулярен обеим плоскостям: направления a,b различны и вместе задают направления этих плоскостей. Поэтому MN равно расстоянию между α и β.",
      "view": "distance",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости; ключевая задача 6.25."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Сравним произвольное соединение",
      "prompt": "Сравним произвольное соединение",
      "explanation": "Для произвольных P∈a,Q∈b опустим PH⊥β. Если H≠Q, треугольник PHQ прямоугольный и PQ²=PH²+HQ²>PH². Если H=Q, PQ=PH. Во всех случаях PQ≥PH=MN.",
      "view": "compare",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора; постоянство расстояния между параллельными плоскостями."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Когда возможно равенство?",
      "prompt": "Когда возможно равенство?",
      "explanation": "Равенство возможно ровно при Q=H, то есть когда соединение перпендикулярно β и α. Тогда оно является общим перпендикуляром a,b. Таким образом, MN — наименьшая длина соединяющего отрезка.",
      "view": "compare",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Критерий равенства в предыдущем вычислении."
        }
      ]
