  "help": [
    {
      "id": "help-1",
      "question": "Как найти EF без координат?",
      "text": "Это средняя линия треугольника ABC, а AC — диагональ квадратной грани."
    }
  ],
  "steps": [
    {
      "title": "Подними E и F",
      "prompt": "Подними E и F. Объясни свой выбор.",
      "explanation": "Через E,F проводим прямые, параллельные DD₁. В соответствующих гранях они встречают A₁B₁,B₁C₁ в E₁,F₁. Соединяем E₁,F₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если плоскость содержит прямую, параллельную другой плоскости, и пересекает её, то линия пересечения параллельна этой прямой."
        }
      ],
      "view": "upright",
      "id": "step-1"
    },
    {
      "title": "Определи вид сечения",
      "prompt": "Определи вид сечения. Объясни свой выбор.",
      "explanation": "EFF₁E₁ — прямоугольник: его вертикальные стороны равны a и перпендикулярны основанию. EF — средняя линия ABC, значит EF=AC/2=a√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия треугольника параллельна третьей стороне и равна её половине. Теорема Пифагора в квадрате основания."
        }
      ],
      "view": "section",
      "id": "step-2"
    },
    {
      "title": "Найди периметр",
      "prompt": "Найди периметр. Объясни свой выбор.",
      "explanation": "P=2(a+a√2/2)=a(2+√2). Ответ: a(2+√2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр прямоугольника."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
