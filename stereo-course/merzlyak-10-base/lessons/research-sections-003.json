  "steps": [
    {
      "title": "Равные доли на рёбрах",
      "prompt": "Что следует из равенства отношений?",
      "explanation": "В параллелограмме ABB₁A₁ точки X и Y отсекают одинаковую долю боковых рёбер: AX/AA₁=BY/BB₁. Поэтому XY∥AB.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о пропорциональных отрезках на параллельных прямых."
        }
      ],
      "view": "xy",
      "id": "step-1"
    },
    {
      "title": "Найдём след",
      "prompt": "Продолжите C₁X и C₁Y к основанию.",
      "explanation": "Пусть U=C₁X∩AC, V=C₁Y∩BC. При внутренних X,Y эти пересечения существуют на продолжениях рёбер. U,V лежат и в XYC₁, и в ABC; их прямая UV — искомый след.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две общие точки определяют прямую пересечения двух различных плоскостей. В каждой грани сечение идёт по прямой."
        }
      ],
      "view": "trace",
      "id": "step-2"
    },
    {
      "title": "Докажем параллельность",
      "prompt": "Может ли UV пересечь XY?",
      "explanation": "XY параллельна AB⊂ABC и не лежит в ABC, поэтому XY не пересекает плоскость ABC. Следовательно, две прямые XY и UV одной плоскости XYC₁ не пересекаются: UV∥XY∥AB.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две непересекающиеся прямые одной плоскости параллельны."
        }
      ],
      "view": "parallel",
      "id": "step-3"
    }
