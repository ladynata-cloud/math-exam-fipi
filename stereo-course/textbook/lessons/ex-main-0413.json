  "help": [
    {
      "id": "h1",
      "question": "В каких единицах удобнее считать?",
      "text": "Переведи длину 40 см в дециметры. Это диаметр, поэтому радиус вдвое меньше.",
      "view": "height",
      "theoryIds": []
    },
    {
      "id": "h2",
      "question": "Что даёт перпендикулярность диагоналей?",
      "text": "Их пересечение K лежит на оси симметрии. Треугольники AKB и DKC прямоугольные и равнобедренные.",
      "view": "diagonals",
      "theoryIds": []
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Согласуй единицы и обозначения",
      "prompt": "Дана длина радиуса или диаметра?",
      "explanation": "Обозначим радиусы R и r, где R ≥ r, высоту h. Данное основание осевого сечения — диаметр: 40 см = 4 дм. Соответствующий радиус равен 2 дм. Все дальнейшие длины считаем в дециметрах.",
      "view": "neutral",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевое сечение усечённого конуса — равнобедренная трапеция с основаниями 2R и 2r.",
          "theoryId": "theory-042",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              96,
              97
            ],
            "pdfPages": [
              98,
              99
            ],
            "point": "42"
          }
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Используй диагонали",
      "prompt": "Чему равны расстояния от K до оснований?",
      "explanation": "Пусть K — пересечение диагоналей. По симметрии KA = KB и KD = KC, а углы AKB и DKC прямые. Высота из K к гипотенузе AB равна AB/2 = R, к DC — DC/2 = r. K лежит между основаниями, поэтому h = R + r.",
      "view": "diagonals",
      "justifications": [
        {
          "kind": "given",
          "text": "Диагонали по условию перпендикулярны."
        },
        {
          "kind": "theorem",
          "text": "В прямоугольном равнобедренном треугольнике высота к гипотенузе равна её половине."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Найди высоту и оба радиуса",
      "prompt": "Что даёт площадь трапеции?",
      "explanation": "Площадь сечения равна ((2R + 2r)h)/2 = (R + r)h = h². Значит, h² = 36 и h = 6 дм. Тогда R + r = 6. Один радиус равен 2, другой 4, поэтому R = 4 дм, r = 2 дм.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь трапеции равна произведению полусуммы оснований на высоту."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Найди образующую",
      "prompt": "Какие катеты у треугольника BMC?",
      "explanation": "Опустим CM на нижнее основание. CM = h = 6 дм, BM = R − r = 2 дм. Поэтому l = BC = √(6² + 2²) = 2√10 дм.",
      "view": "slant",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике BMC."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Вычисли две площади",
      "prompt": "Сколько оснований нужно прибавить?",
      "explanation": "Sбок = π(R + r)l = 12√10π дм². Полная площадь включает два круга: Sполн = Sбок + πR² + πr² = (12√10 + 20)π = 4(3√10 + 5)π дм².",
      "view": "surface",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь боковой поверхности усечённого конуса равна π(R + r)l.",
          "theoryId": "theory-042",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              96,
              97
            ],
            "pdfPages": [
              98,
              99
            ],
            "point": "42"
          }
        },
        {
          "kind": "theorem",
          "text": "Площади двух оснований равны πR² и πr²."
        }
      ]
    }
