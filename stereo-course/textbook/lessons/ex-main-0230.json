  "steps": [
    {
      "title": "Найди третью сторону",
      "prompt": "Как использовать две стороны и угол между ними?",
      "explanation": "Обозначим AB=5 см, AC=3 см, ∠BAC=120°. По теореме косинусов BC²=5²+3²−2·5·3·cos120°=25+9+15=49. Значит BC=7 см — наибольшая сторона основания.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов; cos120°=−1/2."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи длину BC в сантиметрах.",
        "accepted": [
          "7"
        ],
        "feedback": "Подставь cos120°=−1/2, затем извлеки положительный квадратный корень."
      },
      "id": "step-1"
    },
    {
      "title": "Восстанови высоту",
      "prompt": "Почему наибольшая боковая грань построена на стороне BC?",
      "explanation": "Все боковые грани прямоугольные и имеют общую высоту h. Поэтому их площади пропорциональны сторонам основания. Наибольшая площадь равна BC·h=35 см², откуда h=35/7=5 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковые рёбра прямой призмы перпендикулярны основаниям; боковые грани — прямоугольники.",
