  "steps": [
    {
      "id": "step-1",
      "title": "Напомним плоское равенство",
      "prompt": "Как связаны диагонали и стороны параллелограмма?",
      "explanation": "В параллелограмме со сторонами a, b и углом θ по теореме косинусов квадраты диагоналей равны a² + b² − 2ab cos θ и a² + b² + 2ab cos θ. Складывая, получаем d1² + d2² = 2a² + 2b².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов; cos(180° − θ) = −cos θ.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Две диагональные плоскости",
      "prompt": "Как сгруппировать четыре диагонали?",
      "explanation": "Для параллелограмма ACC1A1 имеем AC1² + CA1² = 2AC² + 2AA1². Для BDD1B1 имеем BD1² + DB1² = 2BD² + 2BB1². Так как BB1 = AA1, общая сумма равна 2(AC² + BD²) + 4AA1².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональные сечения параллелепипеда — параллелограммы; боковые рёбра равны.",
          "theoryId": "theory-013"
        },
        {
          "kind": "theorem",
          "text": "Равенство суммы квадратов диагоналей параллелограмма, полученное на предыдущем шаге.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        }
      ],
      "view": "first"
    },
    {
      "id": "step-3",
      "title": "Учтём все рёбра",
      "prompt": "Как заменить квадраты диагоналей основания?",
      "explanation": "В основании AC² + BD² = 2AB² + 2AD². Поэтому сумма квадратов четырёх пространственных диагоналей равна 4AB² + 4AD² + 4AA1². У параллелепипеда по четыре ребра каждой из трёх длин AB, AD, AA1; это и есть сумма квадратов двенадцати рёбер.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равенство для диагоналей параллелограмма.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        },
        {
          "kind": "theorem",
          "text": "Параллельные рёбра параллелепипеда равны, каждое из трёх направлений содержит четыре ребра.",
          "theoryId": "theory-013"
        }
      ],
