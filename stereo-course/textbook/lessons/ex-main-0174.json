      "view": "work"
    },
    {
      "id": "step-2",
      "title": "Найдём AD",
      "prompt": "Как использовать гипотенузу DB?",
      "explanation": "В прямоугольном DAB: AD²=DB²−AB²=125−50=75, поэтому AD=5√3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "work"
    },
    {
      "id": "step-3",
      "title": "Построим линейный угол при BC",
      "prompt": "Почему лучи CA и CD оба перпендикулярны BC?",
      "explanation": "CA⊥BC по условию. Кроме того, AD⊥BC, так как AD⊥(ABC). Значит BC перпендикулярна двум пересекающимся прямым AC и AD плоскости ACD, то есть BC⊥(ACD), в частности BC⊥CD. Поэтому ∠ACD — нужный линейный угол.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости; определение линейного угла.",
          "theoryId": "theory-017",
