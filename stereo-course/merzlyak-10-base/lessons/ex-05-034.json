  "steps": [
    {
      "title": "Найди след первой плоскости",
      "prompt": "Найди след первой плоскости. Объясни свой выбор.",
      "explanation": "В грани DCC₁D₁ через K проводим KL∥AA₁ до CD. KL лежит в AA₁K, поэтому AL — след этой плоскости на основании.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость через AA₁ и K содержит параллель через K."
        }
      ],
      "view": "traces",
      "id": "step-1"
    },
    {
      "title": "Пересеки следы",
      "prompt": "Пересеки следы. Объясни свой выбор.",
      "explanation": "След DD₁M на основании — DM. Строим O=AL∩DM. При внутренних M,K эти отрезки пересекаются внутри основания.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две точки определяют след плоскости."
        }
      ],
      "view": "traces",
      "id": "step-2"
    },
    {
      "title": "Подними общую прямую",
      "prompt": "Подними общую прямую. Объясни свой выбор.",
      "explanation": "Через O проводим OQ∥AA₁∥DD₁. Она лежит в обеих плоскостях, каждая из которых содержит соответствующее вертикальное направление. Это искомая линия пересечения; она параллельна AA₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Единственность параллельной прямой через точку; Все общие точки двух различных пересекающихся плоскостей лежат на их общей прямой (A4)."
        }
      ],
