  "help": [
    {
      "id": "h1",
      "question": "Как связать апофему основания со стороной?",
      "text": "В треугольнике из центра к концу и середине стороны половинный центральный угол равен 180°/n.",
      "view": "sector"
    },
    {
      "id": "h2",
      "question": "Как найти высоту?",
      "text": "Дано, что длины всех рёбер совпадают.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди площадь основания",
      "prompt": "Как разделить правильный многоугольник на равные треугольники?",
      "explanation": "От O к середине стороны расстояние a/[2tg 22,5°] = a(1+√2)/2, так как tg 22,5° = √2−1. Получаем S = 2(1+√2)a².",
      "view": "sector",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь правильного многоугольника равна полупериметру, умноженному на апофему."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Используй равенство рёбер",
      "prompt": "Какой длины вертикальный отрезок AA₁?",
      "explanation": "Поскольку призма правильная, боковое ребро перпендикулярно основанию. По условию h = a.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У правильной призмы высота равна боковому ребру."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Запиши объём",
      "prompt": "Что произойдёт при умножении площади на a?",
      "explanation": "Каждый множитель a² в площади основания умножается ещё на a. Объём равен 2(1+√2)a³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для прямой призмы V = Sh."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "На какой угол в градусах делится центральный угол правильного восьмиугольника при проведении апофемы к стороне?",
      "explanation": "Центральный угол равен 360°/8 = 45°, а апофема делит его пополам.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Центральный угол равен 360°/8 = 45°, а апофема делит его пополам."
        }
      ],
      "input": {
        "prompt": "Введи числовой результат проверки.",
        "accepted": [
          "22.5"
        ],
        "feedback": "Центральный угол равен 360°/8 = 45°, а апофема делит его пополам."
      }
    }
  ],
  "answer": {
    "mode": "exact",
    "prompt": "Введи коэффициент при a³. При необходимости используй sqrt.",
