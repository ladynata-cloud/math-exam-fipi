  "help": [
    {
      "id": "help-1",
      "question": "Диагонали разных граней всегда скрещиваются?",
      "text": "Нет. Например, AB₁ и DC₁ здесь параллельны. Проверяй конкретные концы и направления."
    }
  ],
  "steps": [
    {
      "title": "Пара 1",
      "prompt": "Пара 1. Объясни свой выбор.",
      "explanation": "BC и A₁C пересекаются в C.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обе прямые проходят через C."
        }
      ],
      "view": "1",
      "id": "step-1"
    },
    {
      "title": "Пара 2",
      "prompt": "Пара 2. Объясни свой выбор.",
      "explanation": "AB∥C₁D₁: это рёбра одного направления параллелепипеда.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две различные прямые параллельны, если лежат в одной плоскости и не пересекаются."
        }
      ],
      "view": "2",
      "id": "step-2"
    },
    {
      "title": "Пара 3",
      "prompt": "Пара 3. Объясни свой выбор.",
      "explanation": "BD лежит в основании, а CC₁ пересекает основание в C∉BD. Поэтому BD и CC₁ скрещиваются.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак скрещивающихся прямых."
        }
      ],
      "view": "3",
      "id": "step-3"
    },
    {
      "title": "Пара 4",
      "prompt": "Пара 4. Объясни свой выбор.",
      "explanation": "AB₁∥DC₁. Противоположные прямоугольные грани ABB₁A₁ и DCC₁D₁ имеют равные и одинаково направленные соответствующие диагонали; AB₁C₁D — параллелограмм.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойство параллелограмма: противоположные стороны параллельны."
        }
      ],
      "view": "4",
      "id": "step-4"
    },
    {
      "title": "Пара 5",
      "prompt": "Пара 5. Объясни свой выбор.",
      "explanation": "DC₁ лежит в грани DCC₁D₁. BB₁ параллельна CC₁, но не параллельна диагонали DC₁ и не пересекает её: BB₁ не имеет точек в плоскости этой грани. Значит прямые скрещиваются.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Скрещивающиеся прямые не лежат в одной плоскости."
        }
      ],
      "view": "5",
      "id": "step-5"
    },
    {
      "title": "Пара 6",
      "prompt": "Пара 6. Объясни свой выбор.",
      "explanation": "AA₁∥CC₁ — параллельные боковые рёбра параллелепипеда.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две различные прямые параллельны, если лежат в одной плоскости и не пересекаются."
        }
      ],
      "view": "6",
      "id": "step-6"
    }
