  "steps": [
    {
      "title": "Пункт 1: проекция",
      "prompt": "Куда проектируется D?",
      "explanation": "DC перпендикулярен грани BCC₁, поэтому D проектируется в C, а DC₁ — в CC₁. Искомый угол ∠DC₁C, tan∠DC₁C=DC/CC₁=5/12. Ответ 1: arctan(5/12).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение угла прямой с плоскостью."
        }
      ],
      "view": "first",
      "id": "step-1"
    },
    {
      "title": "Пункт 2: проекция",
      "prompt": "Какая точка является проекцией D на ABB₁?",
      "explanation": "DA⊥(ABB₁), значит проекция D — A, проекция DB₁ — AB₁. Диагональ AB₁=√(5²+12²)=13 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярные рёбра и теорема Пифагора."
        }
      ],
      "view": "face",
      "id": "step-2"
    },
    {
      "title": "Пункт 2: угол",
      "prompt": "Как найти угол DB₁A?",
      "explanation": "В прямоугольном DAB₁ тангенс искомого угла равен DA/AB₁=7/13. Ответ 2: arctan(7/13).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс в прямоугольном треугольнике."
        }
      ],
