  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Найдите две точки, которые лежат в одной грани и в искомой плоскости. Соедините их; при необходимости продолжите прямую до ребра или его продолжения."
    }
  ],
  "steps": [
    {
      "title": "Левая грань",
      "prompt": "Проведите EF в плоскости ABB₁A₁.",
      "explanation": "Постройте V = EF ∩ AA₁ и P = EF ∩ AB. Часть EF внутри левой грани — VP.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две общие точки определяют прямую пересечения двух различных плоскостей. В каждой грани сечение идёт по прямой."
        }
      ],
      "view": "ef",
      "id": "step-1"
    },
    {
      "title": "Верхнее основание",
      "prompt": "Проведите EM в плоскости A₁B₁C₁D₁.",
      "explanation": "Постройте U = EM ∩ A₁D₁ и T = EM ∩ C₁D₁. Часть EM внутри верхнего основания — UT.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две общие точки определяют прямую пересечения двух различных плоскостей. В каждой грани сечение идёт по прямой."
        }
