  "help": [
    {
      "id": "h1",
      "question": "Как получить вертикальную высоту?",
      "text": "В осевой трапеции опусти из C перпендикуляр CK на нижний диаметр. Горизонтальный катет равен разности радиусов.",
      "view": "height"
    },
    {
      "id": "h2",
      "question": "Где появятся оба радиуса в объёме?",
      "text": "К квадрату большого и квадрату малого радиуса добавь произведение радиусов.",
      "view": "bases"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди горизонтальный катет",
      "prompt": "Сколько метров в AK?",
      "explanation": "Большой радиус равен 6, малый 3. Их разность составляет 3 м.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Параллельные основания имеют общую ось, поэтому сдвиг краёв в осевом сечении равен разности радиусов."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи разность радиусов.",
        "accepted": [
          "3"
        ],
        "feedback": "Проекция образующей на горизонталь есть разность 6−3, а не сумма."
      }
    },
    {
      "id": "step-2",
      "title": "Восстанови высоту",
      "prompt": "Чему равна высота CK?",
      "explanation": "h² = 5²−3² = 16, поэтому h = 4 м.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образующая 5 м служит гипотенузой прямоугольного треугольника AKC."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи высоту в метрах.",
        "accepted": [
          "4"
        ],
        "feedback": "Длина 5 идёт по боковой поверхности. Вертикальный катет короче неё."
      }
    },
    {
      "id": "step-3",
      "title": "Примени формулу усечения",
      "prompt": "Какой коэффициент при π в объёме?",
      "explanation": "V = πh(R²+Rr+r²)/3. Здесь сумма равна 36+18+9 = 63 и объём 84π м³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сечение на промежуточной высоте меняется по линейному радиусу, поэтому в объёме есть смешанный член Rr.",
          "theoryId": "theory-059"
        }
      ],
      "view": "bases",
      "input": {
        "prompt": "Введи коэффициент объёма.",
        "accepted": [
          "84"
        ],
        "feedback": "Прибавь 18 = 6 · 3 между квадратами. Затем умножь на 4/3."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другие радиусы",
      "prompt": "Теперь радиусы 5 и 2 м, образующая по-прежнему 5 м. Чему равен новый коэффициент при π?",
      "explanation": "Разность радиусов осталась 3, значит h = 4. Сумма 25+10+4 = 39, получается 52π м³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Одинаковая разность радиусов сохраняет высоту при прежней образующей, но объёмы отличаются."
        }
      ],
      "view": "bases",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "52"
        ],
        "feedback": "Новое произведение радиусов равно 10. Найди все три слагаемых заново."
      }
    }
  ],
