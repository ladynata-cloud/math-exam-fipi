  "help": [
    {
      "id": "h1",
      "question": "Что в треугольнике основания является гипотенузой?",
      "text": "Она лежит напротив указанного прямого угла A.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Какую длину нужно перевести в сантиметры?",
      "text": "Высота призмы задана в дециметрах.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди второй катет",
      "prompt": "Как использовать разность квадратов 37 и 35?",
      "explanation": "AC² = 37²−35² = (37−35)(37+35) = 144. Значит, AC = 12 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Квадрат гипотенузы равен сумме квадратов катетов."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди площадь основания",
      "prompt": "Как использовать катеты 35 см и 12 см?",
      "explanation": "S = 35·12/2 = 210 см². Половина появляется, потому что основание треугольное.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь прямоугольного треугольника равна половине произведения катетов."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Согласуй единицы",
      "prompt": "Как выразить 1,1 дм в сантиметрах?",
      "explanation": "1 дм = 10 см; следовательно, AA₁ = 11 см. В прямой призме боковое ребро задаёт высоту.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для умножения площади в см² на высоту в сантиметрах не нужен другой перевод."
        }
      ],
      "input": {
        "prompt": "Введи высоту призмы в сантиметрах.",
        "accepted": [
          "11"
        ],
        "feedback": "При переходе от дециметров к сантиметрам умножь на 10."
      }
    },
    {
      "id": "step-4",
      "title": "Найди объём",
      "prompt": "Что получится при умножении основания на высоту?",
      "explanation": "Получаем V = 210·11 = 2310 см³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём прямой призмы с прямоугольным треугольником в основании равен Sh."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь другой треугольник",
      "prompt": "У основания катет 5 см и гипотенуза 13 см; какова площадь основания?",
      "explanation": "Второй катет √(13²−5²) = 12 см. Площадь равна 5·12/2 = 30 см².",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота призмы не участвует в определении площади её основания."
        }
      ],
      "input": {
        "prompt": "Введи площадь нового треугольника в см².",
        "accepted": [
          "30"
        ],
        "feedback": "После нахождения второго катета раздели произведение катетов на 2."
      }
    }
