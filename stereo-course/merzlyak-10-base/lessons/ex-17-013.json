  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Не перепутай меньшую пространственную диагональ с меньшей диагональю основания."
    }
  ],
  "steps": [
    {
      "title": "Основание",
      "prompt": "Каковы диагонали ромба?",
      "explanation": "При стороне 6 и угле 60° малая диагональ q=2·6 sin30°=6 см, большая p=2·6 cos30°=6√3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали ромба через половинный угол."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота",
      "prompt": "Что даёт равенство пространственной диагонали и p?",
      "explanation": "Меньшая пространственная диагональ имеет квадрат q²+h². По условию q²+h²=p², значит h²=108−36=72 и h=6√2 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор в диагональном сечении."
        }
      ],
      "view": "small",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Каков периметр основания?",
      "explanation": "P=4·6=24 см. Sбок=Ph=24·6√2=144√2 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковая поверхность прямой призмы."
        }
      ],
      "view": "side",
      "id": "step-3"
    }
