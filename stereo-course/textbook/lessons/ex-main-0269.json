  "help": [
    {
      "id": "h1",
      "question": "Как различить высоту и апофему?",
      "text": "Высота перпендикулярна плоскостям оснований. Апофема — высота боковой равнобедренной трапеции, поэтому обычно длиннее высоты тела.",
      "theoryIds": [
        "theory-034-regular"
      ],
      "children": [
        {
          "id": "h1-detail",
          "question": "Почему используются два радиуса?",
          "text": "До вершины основания идёт радиус описанной окружности; до середины стороны — радиус вписанной. Их разности относятся к разным прямоугольным треугольникам."
        }
      ]
    }
  ],
  "steps": [
    {
      "title": "Найди проекцию бокового ребра",
      "prompt": "Какие радиусы нужны для вершины основания?",
      "explanation": "Радиусы описанных окружностей равносторонних оснований равны R = 4/√3 и r = 2/√3. Центры соосны, поэтому горизонтальная проекция ребра AA₁ имеет длину R − r = 2/√3 дм.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус описанной окружности равностороннего треугольника."
        },
        {
          "kind": "theorem",
          "text": "Свойства правильной усечённой пирамиды.",
          "theoryId": "theory-034-regular",
