  "steps": [
    {
      "id": "step-1",
      "title": "Сравним боковые рёбра",
      "prompt": "Что известно про AA₁ и CC₁?",
      "explanation": "Все боковые грани — параллелограммы. Поэтому AA₁∥BB₁ и AA₁=BB₁, а BB₁∥CC₁ и BB₁=CC₁. Значит, AA₁∥CC₁ и AA₁=CC₁. Параллельные прямые AA₁ и CC₁ определяют плоскость, содержащую A,C,C₁,A₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Все грани параллелепипеда — параллелограммы.",
