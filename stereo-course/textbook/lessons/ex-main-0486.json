  "help": [
    {
      "id": "h1",
      "question": "Как получить несколько пирамид одной высоты?",
      "text": "Соедини центр шара со всеми вершинами исходного тела. Каждая грань становится основанием отдельной пирамиды.",
      "view": "sum"
    },
    {
      "id": "h2",
      "question": "Почему расстояние до каждой грани равно r?",
      "text": "Шар касается каждой грани. Радиус, проведённый к точке касания, перпендикулярен её плоскости.",
      "view": "face"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Разбей тело",
      "prompt": "На рисунке у квадратной пирамиды четыре боковые грани. Сколько образуется малых пирамид, если взять все грани?",
      "explanation": "Пять. К четырём боковым треугольникам добавляется квадратное основание. У всех пяти пирамид общей вершиной служит I.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждая грань выпуклого многогранника вместе с внутренней точкой определяет одну часть разбиения."
        }
      ],
      "view": "sum",
      "input": {
        "prompt": "Введи количество частей.",
        "accepted": [
          "5"
        ],
        "feedback": "Основание — тоже грань исходной пирамиды."
      }
    },
    {
      "id": "step-2",
      "title": "Проверь вклад основания",
      "prompt": "На модели у квадрата сторона 6 и радиус шара 1,5. Каков объём части над квадратом?",
      "explanation": "Площадь квадрата 36, малая высота IO = 1,5. Объём IABCD равен 36 · 1,5 /3 = 18.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Всякая плоскость касания шара удалена от его центра на радиус."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи объём части над квадратом.",
        "accepted": [
          "18"
        ],
        "feedback": "Малая вершина находится в I. Возьми расстояние от центра шара до основания."
      }
    },
    {
      "id": "step-3",
      "title": "Сложи объёмы всех частей",
      "prompt": "Четыре боковые грани модели имеют суммарную площадь 60. Каков объём всего тела?",
      "explanation": "Слагаемые имеют вид Sᵢr/3. После сложения V = (ΣSᵢ)r/3 = Sr/3. Здесь (36+60) · 1,5 /3 = 48.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Малые пирамиды покрывают всё тело и имеют непересекающиеся внутренности."
        }
      ],
      "view": "face",
      "input": {
        "prompt": "Введи полный объём модели.",
        "accepted": [
          "48"
        ],
        "feedback": "Сложи площадь основания и площади всех боковых граней."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь увеличенный пример",
      "prompt": "У подобной пирамиды всё тело увеличено вдвое. Полная площадь 384, радиус 3. Чему равен объём?",
      "explanation": "V = 384 · 3 /3 = 384. Он в восемь раз больше прежнего объёма 48.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площади подобных тел меняются как квадрат масштаба, радиус — как сам масштаб."
        }
      ],
      "view": "sum",
      "input": {
        "prompt": "Введи новый объём.",
        "accepted": [
          "384"
        ],
        "feedback": "Радиус 3 сократится со знаменателем 3."
      }
    }
  ],
