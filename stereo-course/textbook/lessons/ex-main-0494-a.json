  "help": [
    {
      "id": "h1",
      "question": "Что нужно сделать с радиусом?",
      "text": "Для площади круга возведи радиус в квадрат. Число π можно оставить множителем.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Как связаны объёмы конуса и цилиндра?",
      "text": "Для одного основания и одной высоты конус занимает треть объёма цилиндра.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Начни с радиуса",
      "prompt": "Чему равен квадрат 1,5?",
      "explanation": "1,5² = 2,25, поэтому основание имеет площадь 2,25π см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круга зависит от квадрата радиуса."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи квадрат радиуса.",
        "accepted": [
          "9/4"
        ],
        "feedback": "Число 1,5 умножь на себя; его удвоение даёт диаметр."
      }
    },
    {
      "id": "step-2",
      "title": "Учти высоту",
      "prompt": "Чему равно отношение высоты 3 к трём?",
      "explanation": "Высота, делённая на три, равна 1 см. Это второй множитель после площади.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём конуса равен произведению площади основания на треть высоты."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи треть высоты.",
        "accepted": [
          "1"
        ],
        "feedback": "В формуле есть постоянный делитель 3, даже когда высота равна трём."
      }
    },
    {
      "id": "step-3",
      "title": "Вычисли объём",
      "prompt": "Какой коэффициент перед π в кубических сантиметрах?",
      "explanation": "V = (π · 1,5²) · 3 /3 = 2,25π см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высотой служит перпендикуляр TO, а отрезок OA задаёт радиус основания.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи коэффициент объёма.",
        "accepted": [
          "9/4"
        ],
        "feedback": "Треть высоты уже равна 1, поэтому коэффициент площади сохраняется."
      }
    },
    {
      "id": "step-4",
      "title": "Возьми новые размеры",
      "prompt": "Теперь радиус 2 см, высота 6 см. Найди коэффициент при π в объёме.",
      "explanation": "Радиус в квадрате равен 4, треть высоты равна 2. Объём 8π см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Новый радиус и новая высота независимо изменяют два множителя."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "8"
        ],
        "feedback": "Перемножь квадрат нового радиуса и треть новой высоты."
      }
    }
  ],
  "answer": {
    "mode": "exact",
    "accepted": [
      "9*pi/4"
