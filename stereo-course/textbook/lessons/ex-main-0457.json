  "help": [
    {
      "id": "h1",
      "question": "Где расположена проекция C₁ и чему равна высота треугольника ABC?",
      "text": "Проекция C₁ — вершина C. До стороны AB от неё расстояние a√3/2.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Как в сечении найти луч, перпендикулярный AB?",
      "text": "Возьми середину M стороны AB. Треугольники ABC и ABC₁ равнобедренные.",
      "view": "slope"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Проведи две высоты к AB",
      "prompt": "Почему угол CMC₁ равен 60°?",
      "explanation": "Точки C и C₁ равноудалены от A и B. Поэтому отрезки CM и C₁M перпендикулярны AB и лежат в соответствующих плоскостях. Их угол — линейный угол данного наклона.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскости сечений образуют тот же угол, что и перпендикуляры к линии их пересечения."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди высоту призмы",
      "prompt": "Как связаны CC₁ и MC?",
      "explanation": "MC = a√3/2. В прямоугольном треугольнике MCC₁ получаем CC₁ = MC·tg 60° = 3a/2.",
      "view": "slope",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярное к основанию ребро CC₁ является вертикальным катетом."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Подставь площадь равностороннего треугольника",
      "prompt": "Какой коэффициент будет у a³?",
      "explanation": "V = (√3a²/4)·(3a/2) = 3√3a³/8.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Правильный треугольник со стороной a имеет площадь √3a²/4."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "Если a = 4 см, какова высота этой призмы?",
      "explanation": "CC₁ = 3·4/2 = 6 см.",
      "view": "slope",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Умножь высоту равностороннего основания на tg 60°."
        }
      ],
      "input": {
        "prompt": "Введи высоту в сантиметрах.",
        "accepted": [
