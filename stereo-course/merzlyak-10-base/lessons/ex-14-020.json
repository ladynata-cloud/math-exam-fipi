    {
      "title": "Построй перпендикуляр в α",
      "prompt": "Построй перпендикуляр в α. Объясни свой выбор.",
      "explanation": "Плоскости α,β пересекаются по c. В α через точку c проведём b⊥c. Из α⊥β следует b⊥β.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В двух перпендикулярных плоскостях прямая одной плоскости, перпендикулярная их общей прямой, перпендикулярна другой плоскости."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Сравни направления a,b",
      "prompt": "Сравни направления a,b. Объясни свой выбор.",
      "explanation": "По условию a⊥β. Две прямые, перпендикулярные одной плоскости, параллельны, поэтому a∥b.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Параллельность перпендикуляров к одной плоскости."
        }
      ],
      "view": "lines",
      "id": "step-2"
    },
