  "steps": [
    {
      "title": "Стороны сечения",
      "prompt": "Как выразить их через сторону a и высоту h?",
      "explanation": "Диагональное сечение — прямоугольник со сторонами a√2 и h. Поэтому S=a√2·h.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ квадрата и перпендикулярность боковых рёбер основанию."
        }
      ],
      "view": "section",
      "id": "step-1"
    },
    {
      "title": "Площадь боковых граней",
      "prompt": "Какова сумма четырёх одинаковых прямоугольников?",
      "explanation": "Каждая боковая грань имеет площадь ah; всего их четыре, так что Sбок=4ah.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь прямоугольника."
        }
      ],
      "view": "side",
      "id": "step-2"
    },
    {
      "title": "Исключаем a,h",
      "prompt": "Как использовать известную площадь?",
      "explanation": "ah=S/√2, следовательно Sбок=4S/√2=2√2·S.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подстановка и упрощение."
        }
      ],
