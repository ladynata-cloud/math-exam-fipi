  "steps": [
    {
      "id": "step-1",
      "title": "Вычисли BC",
      "prompt": "Как использовать две стороны и угол между ними?",
      "explanation": "BC² = 5²+3²−2·5·3 cos 120° = 49, поэтому BC = 7 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов относится к стороне, противолежащей заданному углу."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Восстанови высоту",
      "prompt": "Какую сторону умножают на высоту для наибольшей грани?",
      "explanation": "Высота h = 35/7 = 5 см, так как площадь грани BCC₁B₁ равна BC·h.",
      "view": "large",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковые грани прямой призмы — прямоугольники."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Вычисли основание и объём",
      "prompt": "Какова площадь треугольника при угле 120°?",
      "explanation": "S = AB·AC·sin 120°/2 = 15√3/4 см². Затем V = Sh = 75√3/4 см³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь треугольника равна половине произведения двух сторон на синус угла между ними."
        }
      ]
    },
