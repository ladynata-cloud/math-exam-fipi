  "steps": [
    {
      "title": "Используй равенства рёбер",
      "prompt": "Какими отрезками будут AM и DM в двух равнобедренных треугольниках?",
      "explanation": "ABC и DBC равнобедренные с общим основанием BC. Их медианы AM и DM являются высотами. Поэтому AM⊥BC и DM⊥BC.",
      "justifications": [
        {
          "kind": "given",
          "text": "M — середина BC; AB=AC и DB=DC."
        },
        {
          "kind": "theorem",
          "text": "Медиана равнобедренного треугольника к основанию является высотой."
        }
      ],
      "view": "medians",
      "id": "step-1"
    },
    {
      "title": "Проверь, что AM и DM различны",
      "prompt": "Почему A,D,M не лежат на одной прямой?",
      "explanation": "Если бы A,D,M лежали на одной прямой, то плоскость через эту прямую и BC содержала бы A,B,C,D. Это невозможно для тетраэдра. Значит, AM и DM — две различные пересекающиеся прямые плоскости ADM.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Четыре вершины тетраэдра не лежат в одной плоскости.",
          "theoryId": "theory-012",
