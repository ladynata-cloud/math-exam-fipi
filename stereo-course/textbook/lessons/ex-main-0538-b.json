      }
    },
    {
      "id": "step-3",
      "title": "Объём при известной высоте",
      "prompt": "Сколько единиц π содержит объём модели?",
      "explanation": "V = 4π·4 = 16π. Буквенно V = πh³/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Цилиндр одинаков на всех уровнях, поэтому его объём равен площади основания, умноженной на высоту.",
          "theoryId": "theory-055"
        }
      ],
      "view": "section",
      "input": {
