  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Условия симметричны относительно a и h; проверь обе перестановки."
    }
  ],
  "steps": [
    {
      "title": "Система",
      "prompt": "Какие два равенства даёт условие?",
      "explanation": "Пусть a>0 — сторона основания, h>0 — высота. Диагональ грани даёт a²+h²=100; площадь даёт 6ah=288, то есть ah=48.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор и площадь боковой поверхности."
        }
      ],
      "view": "face",
      "id": "step-1"
    },
    {
      "title": "Сумма и разность",
      "prompt": "Как восстановить два числа?",
      "explanation": "(a+h)²=100+96=196, значит a+h=14. (a−h)²=100−96=4, поэтому a−h=2 или −2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формулы квадрата суммы и разности."
        }
      ],
      "view": "face",
      "id": "step-2"
    },
    {
      "title": "Все ответы",
      "prompt": "Можно ли выбрать только одну пару?",
      "explanation": "Получаем (a,h)=(8,6) или (6,8), в сантиметрах. Обе пары дают диагональ 10 и площадь 288, поэтому исключать одну нельзя. Модель показывает a=6,h=8.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проверка обеих положительных пар в исходных условиях."
        }
      ],
      "view": "base",
      "id": "step-3"
    }
  ],
