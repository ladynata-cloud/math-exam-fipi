  "steps": [
    {
      "title": "Пункт 1: построй N",
      "prompt": "Пункт 1: построй N. Объясни свой выбор.",
      "explanation": "EF∥CC₁. Через M проведём MN∥CC₁ до CD; N — середина CD. Соединим N,E. Сечение — EFMN.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойства параллелепипеда."
        }
      ],
      "view": "section",
      "id": "step-1"
    },
    {
      "title": "Пункт 2",
      "prompt": "Пункт 2. Объясни свой выбор.",
      "explanation": "EF∥CC₁, а CC₁⊥ABC. Значит EF⊥ABC; плоскость EFM содержит этот перпендикуляр и потому перпендикулярна ABC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если плоскость содержит прямую, перпендикулярную другой плоскости, то эти плоскости перпендикулярны."
        }
      ],
      "view": "normal",
      "id": "step-2"
    },
    {
      "title": "Пункт 3: найди стороны",
      "prompt": "Пункт 3: найди стороны. Объясни свой выбор.",
      "explanation": "EF=12 см. EN — средняя линия треугольника BCD, поэтому EN=BD/2=√(8²+6²)/2=5 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия треугольника параллельна третьей стороне и равна её половине. Теорема Пифагора."
        }
      ],
      "view": "length",
      "id": "step-3"
    },
    {
      "title": "Вычисли площадь",
      "prompt": "Вычисли площадь. Объясни свой выбор.",
      "explanation": "EF⊥EN, сечение прямоугольное. S=12·5=60 см². Ответ: 60 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь прямоугольника."
        }
      ],
