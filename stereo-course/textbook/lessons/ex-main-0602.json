  "help": [
    {
      "id": "h1",
      "question": "У каких двух концов брать среднее первым?",
      "text": "Для M это A и B. Для K второе усреднение идёт уже между M и D.",
      "view": "first"
    },
    {
      "id": "h2",
      "question": "Как выразить D?",
      "text": "Используй OD=OA+BC и BC=OC−OB. Сохрани минус при b.",
      "view": "second"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Первая середина",
