    {
      "title": "Найди ON в квадрате",
      "prompt": "Какие катеты у прямоугольного треугольника OMN?",
      "explanation": "OM=a/2 и MN=a, поэтому ON²=a²/4+a²=5a²/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
