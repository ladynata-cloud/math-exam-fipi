  "steps": [
    {
      "title": "Найди общую середину диагоналей",
      "prompt": "Где может находиться центр?",
      "explanation": "Диагонали параллелепипеда пересекаются в одной точке O и делятся ею пополам. Прямоугольность не требуется.",
      "view": "center",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойство диагоналей параллелепипеда."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Проверь преобразование тела",
      "prompt": "Что произойдёт с противоположными вершинами?",
      "explanation": "Центральная симметрия относительно O попарно переставляет противоположные вершины. Любая точка параллелепипеда — выпуклая комбинация его вершин, поэтому её образ тоже принадлежит телу.",
      "view": "center",
      "justifications": [
        {
          "kind": "definition",
          "text": "Определение симметрии: образ каждой точки должен принадлежать той же фигуре."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Исключи второй центр",
      "prompt": "Почему второго центра нет?",
      "explanation": "Параллелепипед ограничен. Два разных центра породили бы ненулевой перенос, сохраняющий тело, что невозможно для ограниченного тела. Ответ: 1.",
      "view": "center",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У ограниченной непустой фигуры не более одного центра симметрии."
        }
      ],
      "id": "step-3"
    }
