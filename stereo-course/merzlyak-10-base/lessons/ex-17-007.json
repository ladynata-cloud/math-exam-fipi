  "steps": [
    {
      "title": "Основание",
      "prompt": "Каков квадрат его диагонали?",
      "explanation": "AC²=2²+3²=13.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольнике."
        }
      ],
      "view": "base",
