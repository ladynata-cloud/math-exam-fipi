              49
            ],
            "subpart": "orthogonal"
          }
        },
        {
          "kind": "theorem",
          "text": "Проекция образующей имеет длину R − r.",
          "theoryId": "theory-042",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              96,
