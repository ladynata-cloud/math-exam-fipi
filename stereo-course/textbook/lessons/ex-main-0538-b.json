    },
    {
      "id": "h2",
      "question": "Как связаны высота и радиус?",
      "text": "Вертикальная сторона квадрата имеет длину h. Из равенства сторон получаем 2r = h.",
      "view": "base"
    }
  ],
  "steps": [
    {
