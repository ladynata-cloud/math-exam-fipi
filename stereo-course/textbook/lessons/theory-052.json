  "steps": [
    {
      "id": "step-1",
      "title": "Построй единичный куб",
      "prompt": "Чем различаются 1 см, 1 см² и 1 см³?",
      "explanation": "Один кубический сантиметр — объём куба с ребром 1 см. У бруска 3 × 2 × 2 см в каждом слое по 6 таких кубиков, а слоёв 2. Его объём равен 12 см³.",
      "view": "layers",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Единица объёма задаётся единичным кубом."
        }
      ],
      "input": {
        "prompt": "Введи объём бруска в см³.",
        "accepted": [
          "12"
        ],
        "feedback": "В одном слое 3·2 кубика, слоёв два."
      }
    },
    {
      "id": "step-2",
      "title": "Сравни равные тела",
      "prompt": "Изменится ли объём, если передвинуть или повернуть брусок?",
      "explanation": "Движение совмещает исходное тело с новым. Содержимое каждого кубического элемента переносится целиком, объём сохраняется. При этом равные объёмы сами по себе не определяют форму.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные тела имеют равные объёмы."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Сложи неперекрывающиеся части",
      "prompt": "Что произойдёт, если разрезать брусок поперёк?",
      "explanation": "Две части могут иметь общую грань, ребро или вершину. Если у частей нет общих внутренних точек, их объёмы складываются. При объёме одной части 4 см³ второй достаётся 8 см³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Аддитивность объёма применяется к телам без общих внутренних точек."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Смени единицу",
      "prompt": "Сколько кубиков с ребром 1 мм помещается в кубе с ребром 1 см?",
      "explanation": "В каждом из трёх направлений помещается по 10 кубиков. Общий счёт 10·10·10 = 1000, поэтому 1 см³ = 1000 мм³.",
      "view": "layers",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При увеличении линейного масштаба в k раз объём куба увеличивается в k³ раз."
        }
      ],
      "input": {
        "prompt": "Введи число кубических миллиметров в 1 см³.",
        "accepted": [
          "1000"
        ],
        "feedback": "Число 10 входит в произведение три раза."
      }
    }
