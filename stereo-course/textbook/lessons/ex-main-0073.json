          }
        },
        {
          "kind": "theorem",
          "text": "Прямые, параллельные третьей, параллельны.",
          "theoryId": "theory-005",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "5",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
