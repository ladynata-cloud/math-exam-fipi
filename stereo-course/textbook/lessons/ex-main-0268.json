  "help": [
    {
      "id": "h1",
      "question": "Отношение оснований равно 1:2?",
      "text": "Нет. 1:2 — отношение верхней части высоты к оставшейся. Верхняя часть составляет 1/3 полной высоты, поэтому стороны оснований относятся как 1:3.",
      "theoryIds": [
        "theory-034"
      ],
      "children": [
        {
          "id": "h1-detail",
          "question": "Какая апофема равна 4?",
          "text": "Апофема боковой трапеции усечённой части, а не апофема полной пирамиды."
        }
      ]
    }
  ],
  "steps": [
    {
      "title": "Переведи отношение частей в масштаб",
      "prompt": "Какую долю полной высоты составляет верхняя часть?",
      "explanation": "Обозначим нижнюю сторону через a, верхнюю через b. По условию SQ:QO = 1:2, поэтому SQ/SO = 1/3. Параллельное сечение подобно основанию с этим коэффициентом, значит b = a/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подобие треугольников по двум углам и пропорциональность соответствующих сторон."
        },
        {
          "kind": "theorem",
          "text": "Параллельное сечение пирамиды и определение усечённой пирамиды.",
          "theoryId": "theory-034",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "34",
            "chapter": "III. Многогранники",
