  "help": [
    {
      "id": "help-1",
      "question": "Подсказка к первому шагу",
      "text": "Пусть стороны оснований a>b. Проекция бокового ребра (a−b)/√2=H·ctgα, то есть a−b=√2Hctgα."
    }
  ],
  "steps": [
    {
      "title": "Разность сторон",
      "prompt": "Разность сторон — выполните этот шаг самостоятельно.",
