  "steps": [
    {
      "title": "Проведи два перпендикуляра",
      "prompt": "Какие треугольники получатся в плоскости AB и перпендикуляра BH?",
      "explanation": "Пусть H — проекция B на α, N — проекция M. Если H≠A, то MN∥BH и A,N,H лежат на одной прямой; треугольники AMN и ABH подобны по двум углам. Поэтому MN/BH=AM/AB. Если H=A, то AB само перпендикулярно α и N=A; та же пропорция верна непосредственно по длинам отрезков.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикуляры к одной плоскости параллельны.",
          "theoryId": "theory-016",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "16",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              36,
              37,
              38
            ],
            "pdfPages": [
              38,
              39,
              40
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "Признак подобия треугольников по двум углам."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Используй отношение частей",
      "prompt": "Какую долю всего AB составляет AM?",
      "explanation": "AM/AB=4/(4+5)=4/9. Значит MN=9·4/9=4 см. Точка M внутри отрезка, поэтому расстояние берётся с тем же знаком высоты, независимо от стороны плоскости, на которой находится B.",
      "justifications": [
        {
          "kind": "given",
