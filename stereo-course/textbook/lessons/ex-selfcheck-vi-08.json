  "help": [
    {
      "id": "h1",
      "question": "Как превратить разность в сумму?",
      "text": "Запиши a−b=a+(−b). Чтобы длины сложились, a и −b должны быть сонаправлены.",
      "view": "reason"
    },
    {
      "id": "h2",
      "question": "Что случится при новых вертикальных стрелках?",
      "text": "Вычитание вектора (0,−4,0) добавляет направленный вверх вектор длины 4.",
      "view": "transfer"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Разность",
      "prompt": "Пусть a=(3,0,0), b=(−2,0,0). Найди |a−b|.",
      "explanation": "a−b=(5,0,0); длина равна 5.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Знак вычитания обращает компоненты b.",
          "theoryId": "theory-065"
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Разность",
        "accepted": [
          "5"
        ],
        "feedback": "Ты вычитаешь отрицательную первую компоненту."
      }
    },
    {
      "id": "step-2",
      "title": "Направления исходных",
      "prompt": "Каким должен быть знак коэффициента b=t·a при таком равенстве и ненулевых a,b? Введи «плюс» или «минус».",
      "explanation": "b направлен противоположно a.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Векторы a и −b должны быть сонаправлены.",
          "theoryId": "theory-065"
        }
      ],
      "view": "reason",
      "input": {
        "prompt": "Направления исходных",
        "accepted": [
          "минус",
          "−",
          "-"
        ],
        "feedback": "Сначала установи направление −b, затем вернись к b."
      }
    },
    {
      "id": "step-3",
      "title": "Новый пример",
      "prompt": "Для (0,2,0) и (0,−4,0) найди длину их разности.",
      "explanation": "Разность равна (0,6,0).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Разность противоположно направленных векторов по длине равна сумме длин.",
          "theoryId": "theory-065"
        }
      ],
      "view": "transfer",
      "input": {
        "prompt": "Новый пример",
        "accepted": [
          "6"
        ],
        "feedback": "Вычти −4 из 2."
      }
    }
