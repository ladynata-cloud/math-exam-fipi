  "steps": [
    {
      "title": "Параллельная прямая",
      "prompt": "Параллельная прямая — выполните этот шаг самостоятельно.",
      "explanation": "Пусть K — середина CC₁. Отрезки A₁E и B₁K параллельны как соответствующие отрезки параллельных граней. Искомый угол равен углу AB₁ с B₁K.",
      "view": "transfer",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Три стороны",
      "prompt": "Три стороны — выполните этот шаг самостоятельно.",
      "explanation": "Пусть ребро равно a. AB₁=a√2. В прямоугольном B₁C₁K: B₁K²=a²+(a/2)²=5a²/4. В прямоугольном ACK: AK²=AC²+CK²=2a²+a²/4=9a²/4.",
      "view": "tri",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Теорема косинусов",
      "prompt": "Теорема косинусов — выполните этот шаг самостоятельно.",
      "explanation": "cos∠AB₁K=(AB₁²+B₁K²−AK²)/(2·AB₁·B₁K)=(2+5/4−9/4)/(2√2·√5/2)=1/√10=√10/10.",
      "view": "tri",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Угол между прямыми",
      "prompt": "Угол между прямыми — выполните этот шаг самостоятельно.",
      "explanation": "Полученный косинус положителен, поэтому ∠AB₁K острый и является искомым углом между прямыми. Ответ: √10/10.",
      "view": "tri",
      "justifications": [
