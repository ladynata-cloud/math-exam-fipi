  "help": [
    {
      "question": "Разве шар — только его поверхность?",
      "text": "Нет. Шару принадлежат точки с OX≤R, а сфере — только точки с OX=R. Вопрос относится к шару вместе с внутренними точками.",
      "view": "inside",
      "theoryIds": [
        "theory-043"
      ],
      "id": "help-1"
    }
  ],
  "steps": [
    {
      "title": "Отдели простой случай",
      "prompt": "Что происходит при A=B?",
      "explanation": "Если точки совпадают, отрезок состоит из одной точки и утверждение сразу выполнено. Далее считаем A≠B и рассматриваем прямую AB.",
      "view": "neutral",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение отрезка и условие принадлежности точек шару.",
          "theoryId": "theory-043"
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Найди допустимый промежуток на прямой",
      "prompt": "Как ограничены точки прямой, лежащие в шаре?",
      "explanation": "Пусть H — основание перпендикуляра из O на прямую AB. Для точки X этой прямой OX²=OH²+HX². Если O лежит на прямой, H=O и формула сохраняется. Условие OX≤R задаёт промежуток между двумя граничными точками C и D, возможно совпадающими.",
      "view": "chord",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора и определение шара как множества точек с OX≤R.",
          "theoryId": "theory-043"
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Используй порядок точек",
      "prompt": "Может ли точка между A и B выйти за C или D?",
      "explanation": "Точки A и B принадлежат промежутку CD, значит, весь отрезок AB лежит в нём. Поэтому каждая точка AB принадлежит шару. Шар выпуклый. Для сферы это неверно: например, середина диаметра находится внутри, а не на сфере.",
      "view": "inside",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Отрезок между двумя точками промежутка целиком лежит в этом промежутке.",
          "theoryId": "theory-043"
        }
      ],
      "id": "step-3"
    }
  ],
