  "steps": [
    {
      "title": "Вырази высоту через радиус",
      "prompt": "Как записать условие «на 12 см больше»?",
      "explanation": "Измерим r и h в сантиметрах. Тогда h = r + 12, причём r > 0. Слово «на» означает прибавление 12, а не умножение.",
      "view": "radius",
      "justifications": [
        {
          "kind": "given",
          "text": "Высота на 12 см больше радиуса."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Составь уравнение полной площади",
      "prompt": "Сколько оснований учитывается?",
      "explanation": "Полная площадь равна 2πr(r + h). Подставим h = r + 12: 2πr(2r + 12) = 288π. Разделим на 4π и получим r(r + 6) = 72, или r² + 6r − 72 = 0.",
      "view": "top",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная поверхность цилиндра состоит из боковой поверхности и двух равных кругов: Sполн = 2πrh + 2πr².",
          "theoryId": "theory-039",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "39",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              91,
              92
            ],
            "pdfPages": [
              93,
              94
            ]
          }
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Выбери допустимый корень",
      "prompt": "Почему одно из решений не подходит?",
      "explanation": "Разложение r² + 6r − 72 = (r − 6)(r + 12) даёт корни 6 и −12. Радиус положителен, поэтому r = 6 см. Тогда h = 6 + 12 = 18 см.",
      "view": "radius",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если произведение двух множителей равно нулю, хотя бы один из них равен нулю."
        },
        {
          "kind": "definition",
          "text": "Радиус и высота невырожденного цилиндра положительны.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Проверь оба условия",
      "prompt": "Восстанавливаются ли разность и площадь?",
      "explanation": "Получаем h − r = 18 − 6 = 12 см. Полная площадь 2π · 6 · (6 + 18) = 288π см². Следовательно, r = 6 см, h = 18 см удовлетворяют обоим условиям.",
      "view": "axial",
      "justifications": [
