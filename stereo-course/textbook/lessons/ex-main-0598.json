        "feedback": "Вначале идём вниз, затем против AD и вдоль AB. Расставь в порядке AA₁, AB, AD."
      },
      "explanation": "D₁B=−AA₁+AB−AD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Правило многоугольника позволяет сложить три перемещения.",
          "theoryId": "theory-070"
        }
      ],
      "view": "diagonal"
    },
    {
      "id": "step-3",
      "title": "Дойти до середины",
      "prompt": "Запиши коэффициенты D₁O.",
