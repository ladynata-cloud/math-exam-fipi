  "steps": [
    {
      "title": "Высота и проекция",
      "prompt": "Какие катеты у треугольника ACC₁?",
      "explanation": "CC₁=12 sin30°=6 см; AC=12 cos30°=6√3 см. Это высота и диагональ основания.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение угла с плоскостью, синус и косинус."
        }
      ],
      "view": "triangle",
      "id": "step-1"
    },
    {
      "title": "Сторона основания",
      "prompt": "Как перейти от диагонали квадрата к стороне?",
      "explanation": "AC=a√2, поэтому a=6√3/√2=3√6 см. Площадь двух оснований равна 2a²=108 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ и площадь квадрата."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Полная поверхность",
      "prompt": "Что добавляют четыре прямоугольника?",
      "explanation": "Sбок=4ah=4·3√6·6=72√6 см². Следовательно, Sполн=108+72√6 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная поверхность прямой призмы."
        }
      ],
