  "steps": [
    {
      "title": "Сравни треугольники AA₁B и AA₁C",
      "prompt": "Какие две стороны и угол между ними совпадают?",
      "explanation": "AB=AC, сторона AA₁ общая, а ∠A₁AB=∠A₁AC по условию об углах при A. Треугольники AA₁B и AA₁C равны по двум сторонам и углу между ними. Следовательно A₁B=A₁C.",
      "justifications": [
        {
          "kind": "given",
          "text": "Основание равностороннее; углы ∠A₁AB и ∠A₁AC равны."
        },
        {
          "kind": "theorem",
          "text": "Первый признак равенства треугольников."
        }
      ],
      "view": "equal-triangles",
      "id": "step-1"
    },
    {
      "title": "Построй две медианы",
      "prompt": "Почему AM и A₁M перпендикулярны BC?",
      "explanation": "Пусть M — середина BC. В равнобедренных треугольниках ABC и A₁BC медианы AM и A₁M являются высотами, поэтому обе перпендикулярны BC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Медиана равнобедренного треугольника, проведённая к основанию, является высотой."
        }
      ],
      "view": "median-plane",
      "id": "step-2"
    },
    {
      "title": "Перенеси перпендикулярность на боковую грань",
      "prompt": "Почему BC⊥BB₁?",
      "explanation": "Из BC⊥AM и BC⊥A₁M получаем BC⊥(AMA₁), следовательно BC⊥AA₁. Все боковые рёбра призмы параллельны, поэтому BB₁∥AA₁ и BC⊥BB₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямая, перпендикулярная двум пересекающимся прямым плоскости, перпендикулярна этой плоскости.",
