  "help": [
    {
      "id": "h1",
      "question": "Что даёт отношение P/Q?",
      "text": "В равенствах Q = πr² и P = πrl один множитель πr общий. Получается P/Q = l/r.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Как восстановить пространственную высоту?",
      "text": "Радиус r, высота h и образующая l составляют прямоугольный треугольник.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Восстанови радиус",
      "prompt": "В примере Q = 9π и P = 15π. Каков радиус?",
      "explanation": "r = √(Q/π) = 3. Из площади основания ещё не следует длина образующей.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круглого основания равна πr²."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи радиус примера.",
        "accepted": [
          "3"
        ],
        "feedback": "9 — это квадрат радиуса."
      }
    },
    {
      "id": "step-2",
      "title": "Восстанови образующую",
      "prompt": "Какова длина l в модели?",
      "explanation": "l = P/(πr) = 5. В общем случае l² = P²/(πQ), а h² = l²−r² = (P²−Q²)/(πQ).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковая поверхность полного конуса имеет площадь πrl."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи длину образующей.",
        "accepted": [
          "5"
        ],
        "feedback": "P — площадь боковой поверхности. Делить надо на πr, а не на πr²."
      }
    },
    {
      "id": "step-3",
      "title": "Найди объём",
      "prompt": "Какой коэффициент перед π в объёме примера?",
      "explanation": "h = √(25−9) = 4, поэтому V = Qh/3 = 12π. Вообще V = Q√((P²−Q²)/(πQ))/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для положительной высоты образующая длиннее радиуса, поэтому P больше Q.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи коэффициент исходного объёма модели.",
        "accepted": [
          "12"
        ],
        "feedback": "В формулу подставь вертикальную высоту 4 вместо образующей 5."
      }
    },
    {
      "id": "step-4",
      "title": "Реши на новых площадях",
      "prompt": "Пусть Q = 16π и P = 20π. Найди коэффициент при π в объёме.",
      "explanation": "Радиус 4, образующая 5, поэтому h = 3. Объём равен 16π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В том же прямоугольном треугольнике роли радиуса и высоты могут меняться."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "16"
        ],
        "feedback": "Сначала найди r и l по двум площадям; один прежний размер не определяет новую высоту."
      }
    }
  ],
  "answer": {
    "mode": "manual",
    "prompt": "Запиши формулу объёма через P и Q и укажи, почему корень существует.",
    "feedback": "V = √(πQ(P²−Q²))/(3π), при P > Q > 0."
  },
