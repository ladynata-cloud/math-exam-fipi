  "help": [
    {
      "id": "h1",
      "question": "Какая диагональ основания является проекцией?",
      "text": "У обеих пространственных диагоналей вертикальная составляющая одинакова. Меньшей соответствует короткая диагональ BD основания.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "С чем сравнивать высоту?",
      "text": "В прямоугольном треугольнике BDD₁ при B есть угол 45°, поэтому DD₁ = BD.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Площадь основания",
      "prompt": "Чему равна площадь параллелограмма в см²?",
      "explanation": "S = 7·3√2·sin 45° = 21.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь параллелограмма равна произведению двух смежных сторон и синуса угла между ними."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Площадь в см²",
        "accepted": [
          "21"
        ],
        "feedback": "Угол входит через синус. Не заменяй площадь произведением сторон без поправки."
      }
    },
    {
      "id": "step-2",
      "title": "Проекция диагонали",
      "prompt": "Чему равен квадрат BD?",
      "explanation": "BD² = 7²+(3√2)²−2·7·3√2·cos 45° = 49+18−42 = 25.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В треугольнике ABD сторона напротив угла 45° находится по теореме косинусов."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Квадрат BD",
        "accepted": [
          "25"
        ],
        "feedback": "Для меньшей диагонали смешанное произведение вычитают."
      }
    },
    {
      "id": "step-3",
      "title": "Найди объём",
      "prompt": "Каков объём в см³?",
      "explanation": "Из угла 45° с основанием следует DD₁ = BD = 5. Объём 21·5 = 105 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У прямого параллелепипеда высота перпендикулярна основанию.",
          "theoryId": "theory-054"
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Объём в см³",
        "accepted": [
          "105"
        ],
        "feedback": "Пространственная диагональ наклонна. Высоту даёт катет DD₁."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другую высоту",
      "prompt": "При прежнем основании, но высоте 2 см, каков объём?",
      "explanation": "Площадь по-прежнему 21 см², поэтому V = 42 см³. При новой высоте пространственный угол изменится.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота и площадь основания определяют объём независимо от угла наклона диагонали."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Новый объём",
        "accepted": [
          "42"
        ],
