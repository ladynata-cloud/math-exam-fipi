  "steps": [
    {
      "id": "step-1",
      "title": "а) Найди след в противоположной грани",
      "prompt": "Какую прямую через O содержит плоскость с CC₁?",
      "explanation": "В грани ADD₁A₁ через O проведи прямую PQ∥CC₁, где P∈AD,Q∈A₁D₁. Она лежит в плоскости, заданной CC₁ и O, потому что через O в этой плоскости проходит единственная параллельная CC₁ прямая. Диагонали параллелограмма делятся точкой O пополам; прямая через его центр, параллельная AA₁, проходит через середины AD и A₁D₁. Поэтому P,Q — середины этих рёбер.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямая через точку плоскости, параллельная прямой этой плоскости, лежит в ней.",
          "theoryId": "theory-004",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "4",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
              9,
              10
            ],
            "pdfPages": [
              11,
              12
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "В параллелограмме диагонали делятся пополам; средняя линия через центр параллельна паре сторон."
        }
      ],
      "view": "parta-trace"
    },
    {
      "id": "step-2",
      "title": "а) Замкни сечение",
      "prompt": "Какие отрезки соединяют найденные точки с данным ребром?",
      "explanation": "Соедини P с C в основании и Q с C₁ в верхнем основании. Четырёхугольник PCC₁Q лежит в секущей плоскости и имеет стороны на нижнем основании, ребре CC₁, верхнем основании и противоположной грани. Других сторон нет: на двух гранях, содержащих CC₁, следом служит уже учтённое CC₁, а остальные грани пересекаются только в названных точках или отрезках. Искомое сечение — PCC₁Q.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сечение составлено из всех отрезков пересечения секущей плоскости с гранями.",
