    {
      "title": "Найди высоту",
      "prompt": "Найди высоту. Объясни свой выбор.",
      "explanation": "Проекция каждой боковой стороны на большее основание равна (18−10)/2=4 см. Поэтому высота h=√(8²−4²)=4√3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "original",
      "id": "step-1"
    },
    {
      "title": "Найди исходную площадь",
      "prompt": "Найди исходную площадь. Объясни свой выбор.",
      "explanation": "S=(10+18)h/2=14·4√3=56√3 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь трапеции."
