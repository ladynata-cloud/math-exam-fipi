  "steps": [
    {
      "title": "Построй линейный угол",
      "prompt": "Почему отрезки из C и D к середине AB перпендикулярны?",
      "explanation": "Пусть O — середина AB. В каждом из указанных равнобедренных треугольников медиана к AB является высотой, поэтому CO⊥AB и DO⊥AB. Это стороны линейного угла между перпендикулярными плоскостями, следовательно CO⊥DO.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Медиана равнобедренного треугольника к основанию — высота."
        },
        {
          "kind": "theorem",
          "text": "Определение линейного угла и перпендикулярности плоскостей.",
          "theoryId": "theory-022",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "22",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              50,
