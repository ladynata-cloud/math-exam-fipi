  "help": [
    {
      "id": "h1",
      "question": "Какая диагональ пространственная?",
      "text": "У AC₁ концы не лежат в одной грани. BD лежит в основании, а BC₁ — в боковой грани.",
      "view": "given"
    },
    {
      "id": "h2",
      "question": "Можно ли заменить длину AC в основании известной длиной BD?",
      "text": "Диагонали прямоугольника равны.",
      "view": "vertical"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Восстанови высоту",
      "prompt": "Сравни квадраты AC₁ и AC.",
      "explanation": "Поскольку AC = BD = 12, получаем CC₁² = 13²−12² = 25, значит высота h = 5 см.",
      "view": "vertical",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямая CC₁ перпендикулярна основанию."
        }
      ],
      "input": {
        "prompt": "Введи высоту в сантиметрах.",
        "accepted": [
          "5"
        ],
        "feedback": "Нужна разность квадратов 13 и 12."
      }
    },
    {
      "id": "step-2",
      "title": "Восстанови ширину",
      "prompt": "Как использовать BC₁ = 11?",
      "explanation": "В боковой грани BC² = 11²−5² = 96. Следовательно, BC = 4√6 см.",
      "view": "width",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ прямоугольной грани образует гипотенузу."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Восстанови длину",
      "prompt": "Какая диагональ даёт последнее ребро?",
      "explanation": "По диагонали основания AB² = 12²−96 = 48, значит AB = 4√3 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У прямоугольника квадрат диагонали равен сумме квадратов сторон."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Умножь три измерения",
      "prompt": "Как упростить корень в произведении?",
      "explanation": "V = 5·4√6·4√3 = 80√18 = 240√2 см³.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Корень √18 равен 3√2."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь перенос",
      "prompt": "Для похожего бруска пространственная диагональ равна 17, диагональ основания 15. Какова высота?",
      "explanation": "Нужна положительная длина √(17²−15²) = 8.",
      "view": "vertical",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пространственная диагональ, её проекция и высота образуют прямоугольный треугольник."
        }
      ],
      "input": {
        "prompt": "Введи высоту нового бруска.",
        "accepted": [
          "8"
        ],
        "feedback": "Вычти 15² из 17², затем извлеки корень."
      }
    }
  ],
