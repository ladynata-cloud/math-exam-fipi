  "steps": [
    {
      "title": "Ромб",
      "prompt": "Как восстановить сторону и большую диагональ?",
      "explanation": "Диагонали ромба перпендикулярны и делят углы пополам. Поэтому d=2a sin(α/2), откуда a=d/[2sin(α/2)]. Большая диагональ p=2a cos(α/2)=d cot(α/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямоугольные треугольники из половин диагоналей."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота",
      "prompt": "Как используется наклон β?",
      "explanation": "Проекция большей пространственной диагонали — p. Поэтому tanβ=h/p и h=d cot(α/2)tanβ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Угол прямой с плоскостью и тангенс."
        }
      ],
      "view": "triangle",
      "id": "step-2"
    },
    {
      "title": "Боковая площадь",
      "prompt": "Чему равно 4ah?",
      "explanation": "Sбок=4ah=2d²cot(α/2)tanβ/sin(α/2). Формула применима при 0<α<90°,0<β<90°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр ромба и боковая поверхность прямой призмы."
        }
      ],
      "view": "side",
      "id": "step-3"
    }
