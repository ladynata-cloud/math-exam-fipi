  "steps": [
    {
      "title": "Пункт 1",
      "prompt": "Какой угол образуется с верхним основанием?",
      "explanation": "Проекция D на верхнее основание — D₁, поэтому искомый угол ∠DC₁D₁. tan∠DC₁D₁=DD₁/D₁C₁=12/5. Ответ 1: arctan(12/5).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение угла прямой с плоскостью."
        }
      ],
      "view": "first",
      "id": "step-1"
    },
    {
      "title": "Диагональ основания",
      "prompt": "Какова проекция DB₁ на нижнее основание?",
      "explanation": "Это DB, так как B₁ проектируется в B. DB=√(5²+7²)=√74 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в основании."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Пункт 2",
      "prompt": "Каков угол B₁DB?",
      "explanation": "tan∠B₁DB=BB₁/DB=12/√74. Ответ 2: arctan(12/√74).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс в прямоугольном треугольнике."
        }
      ],
