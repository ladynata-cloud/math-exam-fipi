  "steps": [
    {
      "title": "Найди AD",
      "prompt": "Найди AD. Объясни свой выбор.",
      "explanation": "В прямоугольном ACD получаем AD²=AC²+CD²=9²+12²=225, то есть AD=15 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
