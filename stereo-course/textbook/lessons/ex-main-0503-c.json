  "help": [
    {
      "id": "h1",
      "question": "Зачем делить на 4π?",
      "text": "Уравнение S = 4πR² сначала определяет квадрат радиуса.",
      "view": "disk"
    },
    {
      "id": "h2",
      "question": "Как связать объём с известной площадью?",
      "text": "После нахождения радиуса можно вычислить V = SR/3.",
      "view": "neutral"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Восстанови квадрат радиуса",
      "prompt": "Чему равен R²?",
      "explanation": "R² = 64π/(4π) = 16.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сферическая поверхность равна четырём площадям круга радиуса R."
        }
      ],
      "view": "disk",
      "input": {
        "prompt": "Введи квадрат радиуса.",
        "accepted": [
          "16"
        ],
        "feedback": "64 — коэффициент всей поверхности. Раздели его на 4."
      }
    },
    {
      "id": "step-2",
      "title": "Проверь длину",
      "prompt": "Каков радиус в сантиметрах?",
      "explanation": "Положительный корень из 16 равен 4 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина радиуса положительна."
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Введи радиус в см.",
        "accepted": [
          "4"
        ],
        "feedback": "16 — значение в квадратных сантиметрах. Радиус — его положительный квадратный корень."
      }
    },
    {
      "id": "step-3",
      "title": "Проверь объём",
      "prompt": "Чему равен объём в кубических сантиметрах?",
      "explanation": "V = SR/3 = 64π · 4/3 = 256π/3 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Из S = 4πR² и V = 4πR³/3 следует V/S = R/3.",
          "theoryId": "theory-060"
        }
      ],
      "view": "disk",
      "input": {
        "prompt": "Введи объём в см³.",
        "accepted": [
          "256*pi/3"
        ],
        "feedback": "Умножь площадь на треть длины радиуса. Множитель π сохранится."
      }
    },
    {
      "id": "step-4",
      "title": "Измени исходную площадь",
      "prompt": "Пусть S = 100π. Какой коэффициент перед π в новом объёме?",
      "explanation": "Получаем R² = 25, R = 5. Значит, V = 500π/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Только после извлечения радиуса можно восстановить кубическую величину."
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Введи новый коэффициент объёма.",
        "accepted": [
          "500/3"
        ],
        "feedback": "При новой площади радиус равен 5, а не 25."
      }
    }
