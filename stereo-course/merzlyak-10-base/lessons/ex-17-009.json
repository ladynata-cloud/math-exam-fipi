      "title": "Грань",
      "prompt": "Чему равна диагональ основания?",
      "explanation": "AC=√(a²+a²)=a√2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в квадрате."
        }
      ],
      "view": "face",
      "id": "step-1"
    },
    {
      "title": "Пространство",
      "prompt": "Как найти квадрат AC₁?",
      "explanation": "CC₁⊥AC, поэтому AC₁²=AC²+CC₁²=2a²+a²=3a².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярность ребра плоскости основания."
        }
      ],
      "view": "triangle",
      "id": "step-2"
    },
