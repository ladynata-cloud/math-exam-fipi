  "help": [
    {
      "id": "help-1",
      "question": "Как начать?",
      "text": "Используй два диаметра, которые являются образами взаимно перпендикулярных диаметров окружности."
    }
  ],
  "steps": [
    {
      "title": "Два диаметра",
      "prompt": "Как выбрать второй диаметр по первому?",
      "explanation": "Выбираем A₁C₁ через O₁. Строим хорду, параллельную A₁C₁, берём её середину и проводим через неё и O₁ второй диаметр B₁D₁. В исходной окружности AB и другие стороны пока не проведены; сами диаметры AC и BD перпендикулярны.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Построение задачи 7.33: диаметр через середину хорды перпендикулярен её направлению."
        }
      ],
      "view": "diameters",
      "id": "step-1"
    },
    {
      "title": "Вписанный квадрат",
      "prompt": "Почему четырёхугольник из концов диаметров — квадрат?",
      "explanation": "Соединяем A₁B₁C₁D₁ по порядку на эллипсе. В исходной окружности два перпендикулярных диаметра делят её на четыре равные дуги по 90°. Соответственные хорды равны, а углы четырёхугольника прямые. Следовательно, исходная фигура — квадрат.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные дуги стягиваются равными хордами; угол, опирающийся на диаметр, прямой."
        }
      ],
      "view": "square",
      "id": "step-2"
    },
    {
      "title": "Описанный квадрат",
      "prompt": "Какие касательные пересечь?",
      "explanation": "Через A₁,C₁ проводим прямые, параллельные B₁D₁, а через B₁,D₁ — прямые, параллельные A₁C₁. Это образы касательных в концах перпендикулярных диаметров. Их пересечения P₁,Q₁,R₁,S₁ дают образ описанного квадрата: в исходной окружности противоположные стороны параллельны, соседние перпендикулярны, расстояние между противоположными сторонами равно диаметру 2R.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Касательная перпендикулярна радиусу; проекция сохраняет параллельность."
        }
      ],
      "view": "outer",
      "id": "step-3"
