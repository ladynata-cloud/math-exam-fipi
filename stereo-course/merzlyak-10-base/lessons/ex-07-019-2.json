  "steps": [
    {
      "title": "Центр симметрии",
      "prompt": "Как определить образ произвольной вершины X?",
      "explanation": "Обозначим центр через S: здесь S=M. На прямой XS за S откладываем SX′=SX. Тогда S — середина XX′. Если X=S, образ совпадает с X.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение центральной симметрии."
        }
      ],
      "view": "rule",
      "id": "step-1"
    },
    {
      "title": "Восемь вершин",
      "prompt": "Как применить правило ко всему кубу?",
      "explanation": "Строим A′,B′,C′,D′,A₁′,B₁′,C₁′,D₁′ по одному правилу. Для каждой пары проверяем коллинеарность X,S,X′ и равенство SX=SX′.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение симметрии относительно точки."
        }
      ],
      "view": "image",
      "id": "step-2"
    },
    {
      "title": "Рёбра и грани",
      "prompt": "Какие точки нужно соединить?",
      "explanation": "Соединяем A′B′C′D′A′ и A₁′B₁′C₁′D₁′A₁′, затем A′A₁′,B′B₁′,C′C₁′,D′D₁′. Это образ всех 12 рёбер; грани ограничены соответствующими четырёхугольниками. Центральная симметрия — движение, поэтому получается равный куб.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образ отрезка соединяет образы концов; центральная симметрия сохраняет расстояния."
        }
      ],
