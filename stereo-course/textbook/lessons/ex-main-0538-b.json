    {
      "id": "step-2",
      "title": "Площадь круга",
      "prompt": "Сколько единиц π содержит площадь основания модели?",
      "explanation": "πr² = 4π, то есть коэффициент равен 4. В общем виде Q = πh²/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Квадрат радиуса содержит множитель 1/4 при h²."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Коэффициент площади",
        "accepted": [
