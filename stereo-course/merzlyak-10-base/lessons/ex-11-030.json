    },
    {
      "title": "Найди боковую сторону",
      "prompt": "Как обосновать шаг «найди боковую сторону»?",
      "explanation": "AC — биссектриса ∠BAD, поэтому ∠BAC=∠CAD. Из BC∥AD следует ∠BCA=∠CAD. Значит ∠BAC=∠BCA и AB=BC=5k.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные углы в треугольнике лежат против равных сторон."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Найди масштаб",
      "prompt": "Как обосновать шаг «найди масштаб»?",
      "explanation": "Проекция боковой стороны на большее основание равна (13k−5k)/2=4k. По Пифагору высота √((5k)²−(4k)²)=3k=9, значит k=3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
