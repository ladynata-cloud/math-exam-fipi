  "help": [
    {
      "question": "Какая фигура получится в плоскости через ось?",
      "text": "Осевое сечение имеет стороны 2r и h. Назови, какие из них лежат в основаниях, а какие являются образующими.",
      "theoryIds": [
        "theory-038"
      ],
      "view": "rectangle",
      "id": "h1"
    },
    {
      "question": "Как выбрать прямоугольный треугольник?",
      "text": "Проведи диагональ AB₁. Катеты треугольника ABB₁ — диаметр AB и образующая BB₁. Сначала определи, возле какого катета дан угол.",
      "view": "triangle",
      "id": "h2"
    }
  ],
  "steps": [
    {
      "title": "Рассмотри осевое сечение",
      "prompt": "Какие размеры имеют стороны прямоугольника ABB₁A₁?",
      "explanation": "AB = 2r, BB₁ = h. Диагональ AB₁ = 48 см является гипотенузой прямоугольного треугольника ABB₁.",
      "view": "triangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевое сечение прямого кругового цилиндра — прямоугольник со сторонами 2r и h.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Укажи данный угол",
      "prompt": "У какой вершины находится угол между диагональю и образующей?",
      "explanation": "Угол AB₁B равен 60°. Катет BB₁ прилежит к этому углу, а диаметр AB лежит напротив него. Угол диагонали с основанием здесь не дан непосредственно.",
      "view": "angle",
      "justifications": [
        {
          "kind": "given",
          "text": "По условию угол между диагональю осевого сечения и образующей равен 60°."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Найди диаметр",
      "prompt": "Как выразить катет, лежащий напротив угла 60°?",
      "explanation": "sin 60° = (2r)/48. Поэтому 2r = 48 · (√3/2) = 24√3 см. Это диаметр основания.",
      "view": "angle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Синус острого угла прямоугольного треугольника равен отношению противолежащего катета к гипотенузе."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Перейди от диаметра к радиусу",
      "prompt": "Нужно ли найденную длину ещё разделить на два?",
      "explanation": "r = (24√3)/2 = 12√3 см. Диаметр осевого сечения состоит из двух радиусов.",
      "view": "radius",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диаметр круга равен двум радиусам.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        }
      ],
      "id": "step-4"
    },
    {
      "title": "Вычисли площадь основания",
      "prompt": "Чему равен квадрат найденного радиуса?",
      "explanation": "r² = (12√3)² = 144 · 3 = 432 см². Следовательно, Sосн = πr² = 432π см².",
      "view": "radius",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круга радиуса r равна πr²."
        },
        {
          "kind": "theorem",
          "text": "При возведении произведения в квадрат возводим в квадрат оба множителя: (12√3)² = 12² · 3."
        }
      ],
      "id": "step-5"
    }
