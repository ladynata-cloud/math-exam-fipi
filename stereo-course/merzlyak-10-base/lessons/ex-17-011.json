  "steps": [
    {
      "title": "Возможные размеры",
      "prompt": "Как распределить четыре одинаковых куба по трём направлениям?",
      "explanation": "Рёбра полученного параллелепипеда выражаются положительными целыми числами единичных рёбер. Произведение трёх размеров равно 4. С точностью до перестановки это только(1,1,4) и(1,2,2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подсчёт единичных кубов по слоям и разложения 4 на целые множители."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Первый вариант",
      "prompt": "Какова площадь при 1×1×4?",
      "explanation": "S=2(ab+bc+ac)=2(1+4+4)=18 см². Этот вариант показывает модель.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула поверхности прямоугольного параллелепипеда."
        }
      ],
      "view": "long",
      "id": "step-2"
    },
    {
      "title": "Второй вариант",
      "prompt": "Какова площадь при 1×2×2?",
      "explanation": "S=2(2+4+2)=16 см². Обе укладки возможны, поэтому ответы 16 см² и 18 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь поверхности и проверка второй укладки из двух рядов по два куба."
        }
      ],
