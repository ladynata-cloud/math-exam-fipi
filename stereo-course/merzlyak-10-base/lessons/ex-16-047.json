  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Разбей ромб диагоналями на четыре прямоугольных треугольника."
    }
  ],
  "steps": [
    {
      "title": "Пункт 1: сторона",
      "prompt": "Как большую диагональ связать со стороной?",
      "explanation": "Пусть O — пересечение диагоналей. AC=d, AO=d/2; диагонали ромба перпендикулярны и делят углы пополам. В прямоугольном AOB угол BAO=α/2, поэтому сторона a=AB=d/[2cos(α/2)].",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойства диагоналей ромба и косинус."
        }
      ],
      "view": "triangle",
      "id": "step-1"
    },
    {
      "title": "Пункт 2: малая диагональ",
      "prompt": "Как найти BO?",
      "explanation": "BO=AO·tan(α/2)=(d/2)tan(α/2). Поэтому BD=2BO=d tan(α/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс в прямоугольном треугольнике."
        }
      ],
      "view": "diagonals",
      "id": "step-2"
    },
    {
      "title": "Пункт 3: площадь",
      "prompt": "Как использовать обе диагонали?",
      "explanation": "S=AC·BD/2=(d²/2)tan(α/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь ромба по диагоналям."
        }
      ],
      "view": "diagonals",
      "id": "step-3"
    },
    {
      "title": "Пункт 4: радиус",
      "prompt": "Как выразить расстояние O до AB?",
      "explanation": "Опустим OH⊥AB. В прямоугольном AOH гипотенуза AO=d/2, угол OAH=α/2. Поэтому r=OH=(d/2)sin(α/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Центр вписанной окружности ромба — пересечение биссектрис; синус."
        }
      ],
      "view": "radius",
      "id": "step-4"
    }
