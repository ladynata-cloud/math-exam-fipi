  "steps": [
    {
      "title": "MK и DC",
      "prompt": "В какой точке пересекаются продолжения?",
      "explanation": "По рисунку K,M,R лежат на одной прямой, D,C,R — на другой. Значит, MK∩DC={R}. R находится за C, но прямые не заканчиваются в названных точках.",
      "justifications": [
        {
          "kind": "given",
          "text": "Коллинеарности K,M,R и D,C,R заданы рисунком9."
        },
        {
          "kind": "theorem",
          "text": "Две различные прямые имеют не более одной общей точки."
        }
      ],
      "view": "mk",
      "id": "step-1"
    },
    {
      "title": "B₁C₁ и BP",
      "prompt": "Какая точка одновременно принадлежит обеим прямым?",
      "explanation": "Q лежит на B₁C₁ и на BP=BQ. Поэтому их пересечение — Q.",
      "justifications": [
        {
          "kind": "given",
          "text": "Q∈B₁C₁ и B,P,Q коллинеарны."
        },
        {
          "kind": "theorem",
          "text": "Две различные прямые имеют не более одной общей точки."
        }
      ],
      "view": "back",
      "id": "step-2"
    },
    {
      "title": "C₁M и DC",
      "prompt": "На каком ребре лежит M?",
      "explanation": "M лежит на CC₁, поэтому C₁M=CC₁. С DC эта прямая встречается в C. Ответы по порядку: R, Q, C.",
      "justifications": [
        {
          "kind": "given",
          "text": "C,M,C₁ коллинеарны."
        },
        {
          "kind": "theorem",
          "text": "Две различные прямые имеют единственную точку пересечения, если она существует."
        }
