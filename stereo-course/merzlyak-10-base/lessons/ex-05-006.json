  "help": [
    {
      "id": "help-1",
      "question": "Может ли a пересечь α ровно один раз?",
      "text": "Нет: направление a параллельно α, поэтому при наличии одной общей точки вся прямая оказывается в α."
    }
  ],
  "steps": [
    {
      "title": "Исключи единственное пересечение",
      "prompt": "Исключи единственное пересечение. Объясни свой выбор.",
      "explanation": "Если a встретила бы α в точке M, то прямая через M, параллельная b, лежала бы в α (свойство параллельной плоскости прямой). Это и есть a. Значит пересечение в единственной точке невозможно.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Через точку плоскости прямая, параллельная прямой, параллельной плоскости, лежит в этой плоскости."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Первый случай",
      "prompt": "Первый случай. Объясни свой выбор.",
      "explanation": "a может не иметь общих точек с α, то есть a∥α. На модели a=A₁B₁, b=C₁D₁, α=(ABCD).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение параллельности."
        }
      ],
      "view": "outside",
      "id": "step-2"
    },
    {
      "title": "Второй случай",
      "prompt": "Второй случай. Объясни свой выбор.",
      "explanation": "a может целиком лежать в α. На той же модели заменим a на AB. Ответ: a∥α или a⊂α.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Классификация расположений прямой и плоскости."
        }
      ],
      "view": "inside",
      "id": "step-3"
    }
