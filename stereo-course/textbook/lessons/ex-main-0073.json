  "steps": [
    {
      "id": "step-1",
      "title": "Найдём направления двух сторон",
      "prompt": "Какие средние линии видны в ABC и BCD?",
      "explanation": "MN — средняя линия ABC, поэтому MN∥AC и MN=5 см. NP — средняя линия BCD, поэтому NP∥BD и NP=6 см. Прямые MN и NP не совпадают: иначе AC и BD были бы параллельны, хотя противоположные рёбра тетраэдра скрещиваются. Поэтому M,N,P задают плоскость.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия треугольника равна половине третьей стороны и параллельна ей."
        },
        {
          "kind": "theorem",
          "text": "Противоположные рёбра тетраэдра не лежат в одной плоскости.",
          "theoryId": "theory-012",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "12",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
              25,
              26
            ],
            "pdfPages": [
              27,
              28
            ]
          }
        }
      ],
      "view": "three"
    },
    {
      "id": "step-2",
      "title": "Докажем принадлежность K",
      "prompt": "Как связать K с уже известной прямой NP?",
      "explanation": "Пусть K — середина AD. В треугольнике ABD отрезок MK — средняя линия, значит, MK∥BD. Но NP∥BD, поэтому MK∥NP. Через M в плоскости MNP проходит единственная прямая, параллельная NP; прямая MK имеет это направление, следовательно, MK лежит в этой плоскости и K∈(MNP).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия треугольника."
        },
        {
          "kind": "theorem",
          "text": "Единственная параллельная прямая через точку лежит в плоскости, заданной точкой и исходной прямой.",
          "theoryId": "theory-004",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "4",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
