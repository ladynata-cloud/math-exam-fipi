  "help": [
    {
      "id": "h1",
      "question": "Как объединить две порции?",
      "text": "Два равных полушария составляют по объёму один полный шар.",
      "view": "portions"
    },
    {
      "id": "h2",
      "question": "Какие радиусы сравниваются?",
      "text": "Края стаканчика и порций имеют диаметр 5 см. В формулах радиус равен 2,5 см.",
      "view": "cup"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди вместимость",
      "prompt": "Какой коэффициент при π у вместимости конуса?",
      "explanation": "Vст = π(5/2)² · 12/3 = 25π см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вместимость стаканчика вычисляется как объём конуса до края."
        }
      ],
      "view": "cup",
      "input": {
        "prompt": "Введи коэффициент вместимости.",
        "accepted": [
          "25"
        ],
        "feedback": "Сначала раздели диаметр 5 на два. Глубина уже равна вертикальной высоте."
      }
    },
    {
      "id": "step-2",
      "title": "Найди общий объём порций",
      "prompt": "Какой коэффициент при π у двух полушарий?",
      "explanation": "Вместе они занимают объём шара с R = 5/2: V = (4/3)π · 125/8 = 125π/6 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждая порция составляет половину шара одного и того же радиуса."
        }
      ],
      "view": "portions",
      "input": {
        "prompt": "Введи коэффициент объёма мороженого.",
        "accepted": [
          "125/6"
        ],
        "feedback": "Обе порции вместе дают один шар. Удваивать объём целого шара не требуется."
      }
    },
    {
      "id": "step-3",
      "title": "Сравни с вместимостью",
      "prompt": "Какой коэффициент при π у оставшегося свободного объёма?",
      "explanation": "25−125/6 = 25/6 > 0. Мороженое займёт меньше места, чем вмещает стаканчик. Оно не перельётся.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если вместимость минус объём содержимого положительна, часть стаканчика останется свободной.",
          "theoryId": "theory-060"
        }
      ],
      "view": "cup",
      "input": {
        "prompt": "Введи коэффициент свободного объёма.",
        "accepted": [
          "25/6"
        ],
        "feedback": "Приведи 25 к знаменателю 6 и вычти 125/6, сохраняя направление сравнения."
      }
    },
    {
      "id": "step-4",
      "title": "Измени глубину",
      "prompt": "Глубина нового стаканчика 9 см, диаметры прежние. На сколько объём порций превысит его вместимость? Введи коэффициент при π.",
      "explanation": "Новая вместимость 75π/4. Разность 125π/6−75π/4 = 25π/12 см³, поэтому в новом случае часть мороженого перельётся.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При неизменном радиусе вместимость конуса прямо пропорциональна глубине."
        }
      ],
      "view": "cup",
      "input": {
        "prompt": "Введи новый коэффициент избытка.",
        "accepted": [
          "25/12"
        ],
        "feedback": "У нового стаканчика вместимость меньше. Теперь нужно вычесть её из объёма обеих порций."
      }
    }
  ],
