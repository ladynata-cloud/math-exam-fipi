  "help": [
    {
      "id": "h1",
      "question": "Какое из рёбер перпендикулярно именно этой грани?",
      "text": "Сторона b лежит в выбранной грани. Поперёк неё направлена сторона a.",
      "view": "sideangle"
    },
    {
      "id": "h2",
      "question": "Как восстановить высоту через диагональ и основание?",
      "text": "Сложи квадраты трёх взаимно перпендикулярных измерений.",
      "view": "face"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Оцени поперечную составляющую",
      "prompt": "Какое равенство даёт sin 30°?",
      "explanation": "Поперечную составляющую диагонали d даёт ребро a. Поэтому a = d sin 30° = d/2, значит d = 2a.",
      "view": "sideangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расстояние от конца диагонали до противоположной боковой плоскости равно длине перпендикулярного ребра."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди высоту",
      "prompt": "Как выразить h² через d, a и b?",
      "explanation": "h² = d²−a²−b² = 4a²−a²−b² = 3a²−b². У невырожденного тела a > 0 и h > 0. Поэтому естественное условие на вторую сторону основания: 0 < b < √3a.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Квадрат пространственной диагонали равен сумме квадратов трёх рёбер."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Сложи данные об основании и высоте",
      "prompt": "Какова площадь основания?",
      "explanation": "S = ab. Умножение на найденную высоту даёт V = ab√(3a²−b²).",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула объёма прямоугольного параллелепипеда имеет вид V = Sh."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь численный пример",
      "prompt": "Если a = 2 и b = √3, чему равна высота?",
      "explanation": "Под корнем остаётся 3·4−3 = 9. Положительная высота равна 3.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Выбор положительного квадратного корня учитывает геометрический смысл длины."
        }
      ],
      "input": {
        "prompt": "Введи высоту для приведённого примера.",
        "accepted": [
          "3"
        ],
        "feedback": "Подставь квадрат b = √3, равный 3."
      }
    }
  ],
