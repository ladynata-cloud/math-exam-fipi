# This template is never loaded automatically. Do not add real secrets to Git.
# Local-only, zero-cost demo: npm --prefix assistant-service start
ASSISTANT_MODE=offline
HOST=127.0.0.1
PORT=3000
ASSISTANT_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Production requires HTTPS origin, a random 43+ character pilot key, writable
# own /data volume, ASSISTANT_DB_PATH=/data/assistant.sqlite and explicit
# ASSISTANT_PERSISTENCE_CONFIRMED=1. Do not share board/cabinet databases.

# API mode is intentionally NOT configured. Before any activation: separate
# owner approval, live isolated evaluation and provider privacy/price review.
# Required keys (no defaults for paid mode):
# ASSISTANT_MODE=api
# ASSISTANT_EXTERNAL_ENABLED=1
# ASSISTANT_PROVIDER_DATA_REVIEWED=1
# ASSISTANT_PILOT_KEY=<hosting secret, never in this file>
# ASSISTANT_PROVIDER=deepseek (or amvera)
# ASSISTANT_MODEL=deepseek-flash (or qwen3_30b / qwen3_235b on Amvera)
# ASSISTANT_API_KEY=<separate hosting secret>
# ASSISTANT_CURRENCY=USD (DeepSeek) or RUB (Amvera)
# ASSISTANT_INPUT_PER_MILLION=<confirmed peak/cache-miss currency units>
# ASSISTANT_OUTPUT_PER_MILLION=<confirmed currency units>
# ASSISTANT_DAILY_BUDGET=<explicit positive currency units>
# ASSISTANT_MONTHLY_BUDGET=<explicit currency units, at least daily budget>
# ASSISTANT_PRICE_REVIEWED_ON=<YYYY-MM-DD UTC, expires after seven days>
# Optional bounded controls: ASSISTANT_DAILY_API_REQUESTS=100,
# ASSISTANT_DAILY_REQUESTS=1000, ASSISTANT_SESSION_REQUESTS=60,
# ASSISTANT_CONCURRENCY=2, ASSISTANT_MAX_OUTPUT_TOKENS=500,
# ASSISTANT_TIMEOUT_MS=15000.

# Optional cabinet bridge; see CABINETS.md. No pupil is selected by these values.
# Supply the same random secret privately on both servers, distinct from pilot/API keys.
# ASSISTANT_CABINET_BRIDGE_KEY=<protected hosting secret>
# Keep pupil external inference disabled even if the standalone UI uses API mode:
ASSISTANT_CABINET_EXTERNAL_ENABLED=0
