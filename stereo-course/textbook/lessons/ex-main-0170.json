  "steps": [
    {
      "id": "step-1",
      "title": "Найдём расстояние до прямой",
      "prompt": "Где находится основание H высоты из B на AC?",
      "explanation": "Так как ∠BAC=150° — тупой, H лежит на продолжении AC за A. Острый угол BAH равен 30°. В прямоугольном ABH высота BH=AB·sin30°=1 см. Это расстояние от B до прямой AC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение высоты к прямой стороны; сумма смежных углов; синус острого угла."
        }
      ],
      "view": "work"
    },
    {
      "id": "step-2",
      "title": "Построим линейный угол",
      "prompt": "Почему ∠BHB₁ равен данным 45°?",
      "explanation": "BH⊥AC. Его проекция B₁H на α также перпендикулярна AC по обратной теореме о трёх перпендикулярах. Поэтому ∠BHB₁ — линейный угол BACB₁ и равен 45°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обратная теорема о трёх перпендикулярах; определение линейного угла.",
