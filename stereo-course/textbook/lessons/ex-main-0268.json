      "view": "face",
      "id": "step-2"
    },
    {
      "title": "Найди стороны оснований",
      "prompt": "Как выбрать допустимый корень?",
      "explanation": "Уравнение раскладывается: (a − 9)(5a + 93) = 0. Поскольку a>0, получаем a = 9 дм, b = 3 дм. Проверка: 81 + 9 + 8·12 = 186.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Решение квадратного уравнения и положительность геометрических длин."
        }
      ],
