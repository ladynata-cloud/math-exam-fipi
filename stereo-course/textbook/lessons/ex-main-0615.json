      "view": "inverse"
    },
    {
      "id": "step-2",
      "title": "Проверка кандидата",
      "prompt": "У выражения [a+(−b)]+b какой коэффициент при a после сокращения?",
      "input": {
        "prompt": "Проверка кандидата",
        "accepted": [
          "1"
        ],
        "feedback": "Воспользуйся сочетательностью: −b и b можно сложить первыми."
      },
      "explanation": "[a+(−b)]+b=a+0=a.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Разность — единственный вектор, который при сложении с b даёт a.",
          "theoryId": "theory-070"
        }
      ],
      "view": "check"
    },
