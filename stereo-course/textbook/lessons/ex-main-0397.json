  "help": [
    {
      "id": "h1",
      "question": "Как увидеть угол с плоскостью?",
      "text": "Опусти из C перпендикуляр CC′ к нижнему основанию. Угол между BC и основанием — это угол между BC и её проекцией BC′.",
      "view": "angle",
      "theoryIds": [
        "theory-038"
      ]
    },
    {
      "id": "h2",
      "question": "Как связать радиус с прямоугольником?",
      "text": "Рассмотри ортогональную проекцию ABC′D′. Докажи, что это прямоугольник с вершинами на окружности, и найди его диагональ.",
      "view": "diameter",
      "theoryIds": [
        "theory-038"
      ]
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Построй проекцию",
      "prompt": "Чему равна длина CC′?",
      "explanation": "Проектируем C и D на нижнее основание в C′ и D′. Так как основания лежат в параллельных плоскостях, CC′ = DD′ = h = a. Проекции C′ и D′ лежат на окружности нижнего основания.",
      "view": "projection",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Образующая прямого цилиндра равна высоте; основания переносятся друг в друга вдоль оси.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вычисли проекцию стороны BC",
      "prompt": "Какой катет известен в треугольнике BCC′?",
      "explanation": "В прямоугольном треугольнике BCC′ угол CBC′ равен 60°, противолежащий катет CC′ = a. Поэтому BC′ = a/tg 60° = a/√3.",
      "view": "angle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Угол между прямой и плоскостью — угол между прямой и её ортогональной проекцией."
        },
        {
          "kind": "theorem",
          "text": "Тангенс острого угла равен отношению противолежащего катета к прилежащему; tg 60° = √3."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Докажи прямоугольность проекции",
      "prompt": "Почему AB перпендикулярна BC′?",
      "explanation": "AB ⟂ BC по условию и AB ⟂ CC′, поскольку CC′ перпендикулярна основанию. Из разложения BC на BC′ и CC′ следует AB ⟂ BC′. Параллельные стороны прямоугольника проектируются в параллельные стороны, поэтому ABC′D′ — прямоугольник. Его стороны a и a/√3.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ортогональная проекция сохраняет параллельность неперпендикулярных плоскости направлений."
        },
        {
          "kind": "theorem",
          "text": "Если прямая перпендикулярна наклонной и направлению проектирования, она перпендикулярна проекции наклонной."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Найди диаметр основания",
      "prompt": "Почему AC′ является диаметром?",
      "explanation": "Прямоугольник ABC′D′ вписан в окружность. Его прямой угол ABC′ опирается на диаметр AC′. По теореме Пифагора AC′² = a² + a²/3 = 4a²/3, поэтому 2r = 2a/√3.",
      "view": "diameter",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вписанный прямой угол опирается на диаметр окружности."
        },
        {
          "kind": "theorem",
          "text": "Квадрат диагонали прямоугольника равен сумме квадратов его сторон."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Запиши радиус",
      "prompt": "Как перейти от диаметра к радиусу?",
      "explanation": "Делим найденный диаметр пополам: r = a/√3 = a√3/3. Параметр a положителен как длина образующей.",
      "view": "diameter",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус равен половине диаметра."
        }
      ]
    }
