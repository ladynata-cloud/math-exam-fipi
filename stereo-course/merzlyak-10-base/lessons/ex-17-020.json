  "steps": [
    {
      "title": "Расстояние до CD",
      "prompt": "Как получить AH из AD?",
      "explanation": "CD∥AB, поэтому расстояние A до прямой CD равно AD sin∠BAD=8sin30°=4 см. Обозначим основание перпендикуляра H; оно может лежать на продолжении CD.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Расстояние между параллельными прямыми."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Линейный угол",
      "prompt": "Почему ∠AHA₁=45°?",
      "explanation": "AH⊥CD, а AA₁⊥основанию. По теореме о трёх перпендикулярах A₁H⊥CD. Значит угол между AH и A₁H равен данному углу между плоскостями,45°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейный угол и теорема о трёх перпендикулярах."
        }
      ],
      "view": "angle",
      "id": "step-2"
    },
    {
      "title": "Высота",
      "prompt": "Каков катет AA₁?",
      "explanation": "В прямоугольном AA₁H имеем AA₁=AH tan45°=4 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс в прямоугольном треугольнике."
        }
      ],
      "view": "angle",
      "id": "step-3"
