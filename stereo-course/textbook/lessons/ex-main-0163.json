  "help": [
    {
      "id": "start",
      "question": "Как найти проекцию?",
      "text": "Опусти перпендикуляр AH к плоскости. Соедини его основание H с M: HM — искомый отрезок.",
      "view": "a",
      "children": [
        {
          "id": "deeper",
          "question": "Нужен синус или косинус?",
          "text": "Проекция HM прилежит к углу между AM и плоскостью. Поэтому HM/AM=cosφ.",
          "view": "a"
        }
      ],
      "theoryIds": [
        "theory-021"
      ]
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Запишем общую формулу",
      "prompt": "Какая сторона прямоугольного AHM является проекцией?",
      "explanation": "Опустим AH⊥α. Проекция наклонной AM — HM, а ∠AMH=φ. В прямоугольном AHM гипотенуза AM=d, поэтому HM=d·cosφ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение угла прямой с плоскостью; косинус острого угла.",
          "theoryId": "theory-021",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "21",
            "chapter": "II. Перпендикулярность прямых и плоскостей",
            "printedPages": [
              45,
              46,
              47
            ],
            "pdfPages": [
              47,
              48,
              49
            ],
            "subpart": "orthogonal"
          }
        }
      ],
      "view": "a"
    },
    {
      "id": "step-2",
      "title": "а) Случай 45°",
      "prompt": "Подставь cos45° в общую формулу.",
      "explanation": "При φ=45° получаем HM=d√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "cos45°=√2/2."
        }
      ],
      "view": "a"
    },
    {
      "id": "step-3",
      "title": "б) Случай 60°",
      "prompt": "Подставь cos60° в общую формулу.",
      "explanation": "При φ=60° получаем HM=d/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "cos60°=1/2."
        }
      ],
      "view": "b"
    },
    {
      "id": "step-4",
      "title": "в) Случай 30°",
      "prompt": "Подставь cos30° в общую формулу.",
      "explanation": "При φ=30° получаем HM=d√3/2. При одной и той же наклонной меньшему углу соответствует большая проекция.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "cos30°=√3/2."
