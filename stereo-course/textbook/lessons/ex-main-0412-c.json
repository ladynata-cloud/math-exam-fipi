  "help": [
    {
      "id": "h1",
      "question": "Что нужно для площади боковой поверхности?",
      "text": "Периметр основания и апофема SM — высота боковой грани. Боковое ребро SA и апофема SM различаются.",
      "view": "apothem",
      "theoryIds": [
        "theory-033-area"
      ]
    },
    {
      "id": "h2",
      "question": "Как найти апофему основания?",
      "text": "В треугольнике OMA угол AOM равен 180°/n. Поэтому AM = 3 sin(180°/n), OM = 3 cos(180°/n).",
      "view": "base",
      "theoryIds": []
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди размеры основания",
      "prompt": "Чему равны сторона, периметр и OM?",
      "explanation": "Радиус описанной окружности основания OA = 3 см. Сторона AB = 2 · 3 sin(180°/6), OM = 3 cos(180°/6). AB = 3 см, P = 18 см, OM = (3√3)/2 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "given",
          "text": "Радиус конуса — радиус описанной окружности основания пирамиды."
        },
        {
          "kind": "theorem",
          "text": "Радиус к середине стороны правильного многоугольника перпендикулярен этой стороне."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди апофему пирамиды",
      "prompt": "Почему используем OM, а не OA?",
      "explanation": "SO = 4 см. Треугольник SOM прямоугольный, поэтому SM = √(4² + ((3√3)/2)²) = √91/2 см. Боковое ребро SA равно 5 см, но оно не является высотой боковой грани.",
      "view": "apothem",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота правильной пирамиды проходит через центр основания.",
          "theoryId": "theory-033",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "33",
            "chapter": "III. Многогранники",
            "printedPages": [
              73,
              74
            ],
            "pdfPages": [
              75,
              76
            ],
            "subpart": "properties"
          }
        },
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в треугольнике SOM."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Вычисли площадь основания",
      "prompt": "Как использовать периметр и OM?",
      "explanation": "Основание состоит из 6 равных треугольников с общей вершиной O. Поэтому Sосн = (P · OM)/2. Sосн = (18 · (3√3)/2)/2 = (27√3)/2 см².",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь правильного многоугольника равна половине произведения его периметра на апофему."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Вычисли боковую площадь",
      "prompt": "Какую высоту имеют все боковые грани?",
      "explanation": "Все боковые грани имеют высоту SM. Поэтому Sбок = (P · SM)/2. Sбок = (18 · √91/2)/2 = (9√91)/2 см².",
      "view": "surface",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковая площадь правильной пирамиды равна половине произведения периметра основания на апофему.",
          "theoryId": "theory-033-area",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "33",
            "chapter": "III. Многогранники",
            "printedPages": [
              74
            ],
            "pdfPages": [
              76
            ],
            "subpart": "area"
          }
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Добавь одно основание",
      "prompt": "Как получить полную площадь?",
      "explanation": "S = Sбок + Sосн. S = (9(√91 + 3√3))/2 см².",
      "view": "surface",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная поверхность пирамиды состоит из боковых граней и одного основания."
        }
      ]
    }
