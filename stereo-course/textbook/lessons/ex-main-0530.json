  "help": [
    {
      "id": "h1",
      "question": "Как связаны расстояния от M и S до основания?",
      "text": "Одна вершина ребра лежит в основании. У его середины высота составляет половину полной высоты.",
      "view": "neutral"
    },
    {
      "id": "h2",
      "question": "Входит ли в угол половина стороны квадрата?",
      "text": "Проекция бокового ребра идёт в вершину квадрата. Её длина — половина диагонали основания.",
      "view": "projection"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Полная высота",
      "prompt": "Если m = 1, сколько составляет SO?",
      "explanation": "h = 2m = 2. У середины отрезка вертикальная координата вдвое меньше, чем у вершины S.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ортогональное проектирование сохраняет середину отрезка."
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Высота SO",
        "accepted": [
          "2"
        ],
        "feedback": "Отрезок MK — половина SO."
      }
    },
    {
      "id": "step-2",
      "title": "Площадь квадратного основания",
      "prompt": "Пусть дополнительно φ = 45°. Чему равна площадь основания?",
      "explanation": "AO = h/tan φ = 2. Диагональ AC = 4, площадь S = AC²/2 = 8. Вообще S = 2h²/tan²φ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали квадрата перпендикулярны и равны."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Площадь основания",
        "accepted": [
          "8"
        ],
        "feedback": "AO — половина диагонали, а не половина стороны."
      }
    },
    {
      "id": "step-3",
      "title": "Объём модели",
      "prompt": "Чему равен объём при m = 1 и φ = 45°?",
      "explanation": "V = 8·2/3 = 16/3. Подставляя h = 2m в общую формулу, получаем 16m³/(3tan²φ).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём пирамиды равен трети объёма призмы с тем же основанием и высотой.",
          "theoryId": "theory-058"
        }
      ],
      "view": "projection",
      "input": {
        "prompt": "Объём модели",
        "accepted": [
          "16/3"
        ],
        "feedback": "Площадь основания ещё нужно умножить на SO и разделить на три."
      }
    },
    {
      "id": "step-4",
      "title": "Измени расстояние",
      "prompt": "Если m = 2 при тех же 45°, каков объём?",
      "explanation": "Коэффициент длины 2 даёт множитель 8 для объёма. Получится 128/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У подобных пирамид объёмы относятся как кубы высот."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Новый объём",
        "accepted": [
          "128/3"
        ],
        "feedback": "m в формуле возводится в куб."
      }
    }
  ],
