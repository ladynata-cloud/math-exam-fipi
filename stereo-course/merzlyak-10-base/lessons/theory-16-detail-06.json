  "steps": [
    {
      "id": "step-1",
      "title": "Как проверить основание?",
      "prompt": "Как проверить основание?",
      "explanation": "Нижнее и верхнее основания — правильные шестиугольники: у каждого шесть равных сторон и шесть углов по 120°. Одного равенства сторон в общем случае недостаточно: в правильном многоугольнике равны и углы.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение правильного многоугольника."
        }
      ],
      "view": "base"
    },
    {
      "id": "step-2",
      "title": "Почему призма прямая?",
      "prompt": "Почему призма прямая?",
      "explanation": "Каждое боковое ребро перпендикулярно плоскостям оснований. Поэтому призма прямая, её боковые грани — прямоугольники, а длина бокового ребра равна высоте тела.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение прямой призмы."
        }
      ],
      "view": "side"
    },
    {
      "id": "step-3",
      "title": "Какие два условия дают правильную призму?",
      "prompt": "Какие два условия дают правильную призму?",
      "explanation": "Призма прямая и её основание — правильный многоугольник; значит, она правильная. Всего у неё 8 граней: два основания и 6 прямоугольных боковых граней. Наклонная призма с таким же правильным основанием уже не была бы правильной.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение правильной призмы; подсчёт боковых граней."
        }
      ],
      "view": "base"
    }
