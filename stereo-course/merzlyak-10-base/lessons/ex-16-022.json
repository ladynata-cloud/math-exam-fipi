  "steps": [
    {
      "title": "Квадраты диагоналей основания",
      "prompt": "Как вычесть вклад высоты?",
      "explanation": "Если диагонали основания p,q, то p²=16²−4²=240, q²=10²−4²=84.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в диагональных сечениях."
        }
      ],
      "view": "space",
      "id": "step-1"
    },
    {
      "title": "Сторона ромба",
      "prompt": "Как она связана с половинами диагоналей?",
      "explanation": "Диагонали ромба перпендикулярны и делятся пополам. Поэтому a²=(p/2)²+(q/2)²=(p²+q²)/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в четверти ромба."
        }
      ],
      "view": "side",
      "id": "step-2"
    },
    {
      "title": "Ответ",
      "prompt": "Чему равен положительный корень?",
      "explanation": "a²=(240+84)/4=81, значит a=9 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Подстановка и извлечение положительного корня."
        }
      ],
      "view": "side",
