  "steps": [
    {
      "id": "step-1",
      "title": "Докажем перпендикулярность AD основанию",
      "prompt": "Какие две пересекающиеся прямые перпендикулярны AD?",
      "explanation": "Из данных углов AD⊥AB и AD⊥AC. Прямые AB и AC пересекаются, поэтому AD⊥(ABC). В прямоугольном ACB: AB²=5²+5²=50.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости; теорема Пифагора.",
