  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Проведи из B высоту к AD; её наклонное продолжение к B₁ задаёт линейный угол."
    }
  ],
  "steps": [
    {
      "title": "Линейный угол",
      "prompt": "Как выбрать перпендикуляр к линии пересечения AD?",
      "explanation": "Опустим BH⊥AD. BH=AB sin45°=3√2 см. По теореме о трёх перпендикулярах B₁H⊥AD, поэтому ∠B₁HB=60° — линейный угол данных плоскостей.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота ромба и линейный угол двугранного угла."
        }
      ],
      "view": "angle",
      "id": "step-1"
    },
    {
      "title": "Пункт 1",
      "prompt": "Чему равна высота BB₁?",
      "explanation": "В прямоугольном BHB₁ имеем h=BB₁=BH tan60°=3√2·√3=3√6 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Тангенс в прямоугольном треугольнике."
        }
      ],
      "view": "angle",
      "id": "step-2"
    },
    {
      "title": "Пункт 2",
      "prompt": "Каковы основание и высота сечения?",
      "explanation": "Сечение — параллелограмм AB₁C₁D, так как B₁C₁∥AD. Его высота HB₁=BH/cos60°=6√2 см. Площадь S=AD·HB₁=6·6√2=36√2 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Параллельность оснований призмы и площадь параллелограмма."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
