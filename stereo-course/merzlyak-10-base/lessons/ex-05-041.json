  "steps": [
    {
      "title": "Обозначь боковые стороны",
      "prompt": "Обозначь боковые стороны. Объясни свой выбор.",
      "explanation": "Пусть высота AB=3x, наклонная сторона CD=5x. Опустим CH⊥AD. Тогда CH=3x, HD=AD−BC=16.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойства прямоугольной трапеции."
        }
      ],
