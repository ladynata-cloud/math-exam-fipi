    {
      "title": "Два уравнения",
      "prompt": "Как связаны a,h и диагонали?",
      "explanation": "Для боковой грани a²+h²=16. Для пространственной диагонали 2a²+h²=25.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Дважды теорема Пифагора."
        }
      ],
      "view": "space",
      "id": "step-1"
    },
    {
      "title": "Размеры призмы",
      "prompt": "Что даёт вычитание уравнений?",
      "explanation": "a²=25−16=9, значит a=3 см. Тогда h²=16−9=7, h=√7 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Положительность длин и решение системы."
        }
      ],
      "view": "face",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Какова сумма площадей?",
      "explanation": "Sполн=2a²+4ah=18+12√7 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула полной поверхности правильной четырёхугольной призмы."
        }
      ],
