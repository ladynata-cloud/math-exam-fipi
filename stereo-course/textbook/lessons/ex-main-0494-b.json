  "help": [
    {
      "id": "h1",
      "question": "Как найти искомую величину в V = πr²h/3?",
      "text": "Сначала умножь объём на 3. Высота останется после деления на площадь основания.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Что произойдёт с π?",
      "text": "Оно входит и в данный объём, и в площадь круга. При делении множители π сократятся.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди основание",
      "prompt": "Какой коэффициент перед π в площади основания?",
      "explanation": "πr² = 16π см² при r = 4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Круг радиуса 4 имеет площадь π · 4²."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи коэффициент площади.",
        "accepted": [
          "16"
        ],
        "feedback": "Вместо радиуса в формулу площади подставляют его квадрат."
      }
    },
    {
      "id": "step-2",
      "title": "Верни множитель три",
      "prompt": "Какой коэффициент перед π у утроенного объёма?",
      "explanation": "3V = 3 · 48π = 144π. По формуле это равно площади основания, умноженной на искомую высоту.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Умножение обеих частей равенства на 3 убирает знаменатель объёма."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи коэффициент утроенного объёма.",
        "accepted": [
          "144"
        ],
        "feedback": "Объём 48π нужно умножить на 3 до деления на площадь."
      }
    },
    {
      "id": "step-3",
      "title": "Найди высоту",
      "prompt": "Сколько сантиметров в высоте?",
      "explanation": "h = 144π/(16π) = 9 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Деление величины в кубических сантиметрах на площадь в квадратных сантиметрах даёт длину.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи высоту.",
        "accepted": [
          "9"
        ],
        "feedback": "Делитель равен 16π, а делимое — 144π."
      }
    },
    {
      "id": "step-4",
      "title": "Реши новую обратную задачу",
      "prompt": "У другого конуса радиус 3 и объём 18π. Какова высота?",
      "explanation": "h = 3 · 18π/(9π) = 6.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Выражение h = 3V/(πr²) работает при положительном радиусе."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи новую высоту.",
        "accepted": [
          "6"
        ],
        "feedback": "У нового основания площадь 9π; подставь именно её."
      }
    }
  ],
