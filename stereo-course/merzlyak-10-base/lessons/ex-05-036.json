  "help": [
    {
      "id": "help-1",
      "question": "Почему разрешено выходить за границы куба?",
      "text": "Вспомогательные следы строятся в плоскостях граней, которые продолжаются бесконечно. В само сечение входят только участки внутри граней."
    }
  ],
  "steps": [
    {
      "title": "Построй вспомогательную среднюю линию",
      "prompt": "Построй вспомогательную среднюю линию. Объясни свой выбор.",
      "explanation": "В треугольнике DAB₁ точка E — середина DA. Отметим середину T диагонали AB₁. Тогда ET∥DB₁, и T лежит в искомой секущей плоскости.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия треугольника параллельна третьей стороне и равна её половине."
        }
      ],
      "view": "middle",
      "id": "step-1"
    },
    {
      "title": "Найди след на левой грани",
      "prompt": "Найди след на левой грани. Объясни свой выбор.",
      "explanation": "Продлим EF до пересечения U с прямой AB. U и T лежат одновременно в секущей плоскости и в плоскости ABB₁A₁. Прямая UT пересечёт AA₁ в P и BB₁ в Q.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Метод следов; Через две различные точки прямой в плоскости вся прямая лежит в этой плоскости (A3)."
        }
      ],
      "view": "left",
      "id": "step-2"
    },
    {
      "title": "Найди R на CC₁",
      "prompt": "Найди R на CC₁. Объясни свой выбор.",
      "explanation": "Продлим EF до пересечения V с прямой BC. В плоскости BCC₁B₁ проведём VQ. Она пересечёт CC₁ в R.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "V,Q — две общие точки секущей плоскости и грани."
        }
      ],
      "view": "back",
      "id": "step-3"
    },
    {
      "title": "Замкни сечение",
      "prompt": "Замкни сечение. Объясни свой выбор.",
      "explanation": "Соединим P,Q,R,F,E по соседним граням. Получается пятиугольник PQRFE. Плоскость содержит ET∥DB₁ и не содержит DB₁, поэтому условие параллельности выполнено.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если прямая не лежит в плоскости и параллельна прямой этой плоскости, то она параллельна плоскости."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
