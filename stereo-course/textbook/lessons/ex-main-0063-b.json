  "steps": [
    {
      "id": "step-1",
      "title": "Установим пропорцию",
      "prompt": "Как выразить A₂B₂ через AA₂?",
      "explanation": "По свойству параллельных плоскостей A₁B₁∥A₂B₂. Треугольники AA₁B₁ и AA₂B₂ подобны по двум углам независимо от того, какая секущая ближе к A. Положим x=AA₂>0. Тогда A₂B₂/18=x/24, значит, A₂B₂=3x/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пересечения параллельных плоскостей третьей — параллельные прямые.",
          "theoryId": "theory-011",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "11",
            "chapter": "I. Параллельность прямых и плоскостей",
            "printedPages": [
              22
            ],
            "pdfPages": [
              24
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "Подобие по двум углам и пропорциональность соответствующих сторон."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Случай A—A₁—A₂",
      "prompt": "Как записать A₁A₂, когда A₂ дальше от A?",
      "explanation": "Если x>24, то A₁A₂=x−24. Условие даёт x=(3/2)(x−24), или 2x=3x−72, поэтому x=72. Неравенство x>24 выполнено. Тогда A₂B₂=3·72/4=54 см. Для этого порядка AA₂=72 см и A₂B₂=54 см.",
      "justifications": [
        {
          "kind": "given",
          "text": "AA₂=(3/2)A₁A₂ и AA₁=24."
        },
        {
          "kind": "theorem",
          "text": "На одном луче расстояние между точками — разность их расстояний от начала луча."
        }
      ],
      "input": {
        "prompt": "Для порядка A—A₁—A₂ чему равно AA₂?",
