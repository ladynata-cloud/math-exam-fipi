  "help": [
    {
      "id": "h1",
      "question": "Какая величина у тел совпадает?",
      "text": "Из равенства диаметров следует, что и основание цилиндра имеет радиус R.",
      "view": "cylinder"
    },
    {
      "id": "h2",
      "question": "Какие множители можно сократить?",
      "text": "Сравни πR²H и 4πR³/3. Радиус положителен.",
      "view": "ball"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди объём шара",
      "prompt": "При R = 3 какой коэффициент при π в объёме шара?",
      "explanation": "Vш = 4π · 3³/3 = 36π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём шара пропорционален кубу радиуса."
        }
      ],
      "view": "ball",
      "input": {
        "prompt": "Введи коэффициент объёма.",
        "accepted": [
          "36"
        ],
        "feedback": "Радиус равен 3; его куб равен 27."
      }
    },
    {
      "id": "step-2",
      "title": "Найди площадь, на которую делится объём",
      "prompt": "Какой коэффициент при π в площади основания цилиндра?",
      "explanation": "Радиус основания тоже 3, площадь 9π. Высоту цилиндра получаем делением общего объёма на эту площадь.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём цилиндра равен площади основания, умноженной на высоту."
        }
      ],
      "view": "cylinder",
      "input": {
        "prompt": "Введи коэффициент площади основания.",
        "accepted": [
          "9"
        ],
        "feedback": "Площадь основания цилиндра — площадь круга, а не вся поверхность шара."
      }
    },
    {
      "id": "step-3",
      "title": "Сравни объёмы",
      "prompt": "Какова высота модели?",
      "explanation": "В примере H = 36π/(9π) = 4. В общем виде H = (4πR³/3)/(πR²) = 4R/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Одинаковые радиусы дают общий множитель πR² в выражениях обоих объёмов.",
          "theoryId": "theory-060"
        }
      ],
      "view": "cylinder",
      "input": {
        "prompt": "Введи высоту цилиндра при R = 3.",
        "accepted": [
          "4"
        ],
        "feedback": "Не подставляй диаметр вместо высоты. Из равенства объёмов получается отношение H/R = 4/3."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другой радиус",
      "prompt": "Пусть общий радиус стал равен 6. Какой высоты нужен цилиндр?",
      "explanation": "H = 4 · 6/3 = 8. При таком изменении все три линейные величины удваиваются.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сохранение отношения H/R обеспечивает равенство объёмов и при другом масштабе."
        }
      ],
      "view": "cylinder",
      "input": {
        "prompt": "Введи новую высоту.",
        "accepted": [
          "8"
        ],
        "feedback": "Умножь новый радиус на 4/3, а не на квадрат прежней высоты."
      }
    }
  ],
