  "help": [
    {
      "id": "h1",
      "question": "Какие стороны у осевого сечения?",
      "text": "Одна равна высоте, другая — диаметру цилиндра.",
      "view": "section"
    },
    {
      "id": "h2",
      "question": "Как восстановить радиус из Q?",
      "text": "Начни с равенства Q = πr².",
      "view": "base"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Вырази радиус",
      "prompt": "Почему нужно брать положительный корень?",
      "explanation": "r = √(Q/π), поскольку радиус положителен.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь круга равна πr²."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вырази высоту",
      "prompt": "Как связана площадь прямоугольника S с r и h?",
      "explanation": "S = 2rh, поэтому h = S/(2r). Важно сохранить множитель 2 от диаметра.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость через ось пересекает цилиндр по прямоугольнику."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Найди объём",
      "prompt": "Что получается после подстановки?",
      "explanation": "V = Q·S/(2r) = (S/2)√(πQ). Размерность согласована: S — площадь, √Q — длина.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём цилиндра равен произведению площади основания на высоту."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "Если Q = 4π см² и S = 20 см², чему равна высота?",
      "explanation": "Радиус равен 2 см, диаметр 4 см, поэтому h = 20/4 = 5 см.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь осевого прямоугольника дели на диаметр."
        }
      ],
      "input": {
        "prompt": "Введи высоту в сантиметрах.",
        "accepted": [
          "5"
        ],
        "feedback": "Площадь осевого прямоугольника дели на диаметр."
      }
    }
