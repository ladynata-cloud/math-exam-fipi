  "help": [
    {
      "id": "h1",
      "question": "Какую длину нужно перевести?",
      "text": "Чтобы получить кубические метры, используй метры для всех размеров. Радиус 5 м относится к основанию.",
      "view": "foot"
    },
    {
      "id": "h2",
      "question": "Можно ли обойтись без заданного радиуса всего шара?",
      "text": "Из сечения верно a² = 2Rh−h². Вырази R через радиус основания a и высоту h.",
      "view": "cap"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Согласуй единицы",
      "prompt": "Какова высота в метрах?",
      "explanation": "h = 60/100 = 0,6 м. Основание имеет радиус a = 5 м.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В формуле для объёма все линейные данные выражают в одной единице длины."
        }
      ],
      "view": "foot",
      "input": {
        "prompt": "Введи высоту в метрах.",
        "accepted": [
          "3/5"
        ],
        "feedback": "В метре 100 сантиметров. Число 60 относится к длине, поэтому дели на 100."
      }
    },
    {
      "id": "step-2",
      "title": "Восстанови радиус всего шара",
      "prompt": "Чему равен R в метрах?",
      "explanation": "Из a²+(R−h)² = R² получаем R = (a²+h²)/(2h). При наших данных R = (25+0,36)/1,2 = 317/15 м.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В меридиональном сечении расстояние от центра шара до основания сегмента равно R−h."
        }
      ],
      "view": "cap",
      "input": {
        "prompt": "Введи радиус всего шара в метрах.",
        "accepted": [
          "317/15"
        ],
        "feedback": "5 м — радиус плоского основания. Радиус большого шара вычисли из a² и h²."
      }
    },
    {
      "id": "step-3",
      "title": "Вычисли объём почвы",
      "prompt": "Какой коэффициент при π в объёме земли?",
      "explanation": "V = πh²(R−h/3) = πh(3a²+h²)/6. Поэтому V = (942/125)π м³, то есть примерно 23,7 м³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём шарового сегмента можно выразить через высоту и радиус его основания.",
          "theoryId": "theory-061-a"
        }
      ],
      "view": "cap",
      "input": {
        "prompt": "Введи коэффициент объёма в м³.",
        "accepted": [
          "942/125"
        ],
        "feedback": "Подставь h = 0,6 в метрах и квадрат радиуса основания 25."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другую клумбу",
      "prompt": "У другого сегмента радиус основания 2 м, а высота 1 м. Какой коэффициент при π в его объёме?",
      "explanation": "V/π = 1 · (3 · 2²+1²)/6 = 13/6.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула через a и h применима и при иных пропорциях сегмента."
        }
      ],
      "view": "foot",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "13/6"
        ],
        "feedback": "Сначала вычисли 3a²+h² для новых размеров, потом умножь на h/6."
      }
    }
  ],
