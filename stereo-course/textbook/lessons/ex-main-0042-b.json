  "steps": [
    {
      "id": "step-1",
      "title": "Точки касания",
      "prompt": "Какие пары отрезков равны?",
      "explanation": "Обозначим точки касания с AB,BE,EK,KA через P,Q,R,S. Отрезки касательных из одной точки равны: AP=AS, BP=BQ, EQ=ER, KR=KS.",
      "justifications": [
        {
          "kind": "given",
          "text": "Окружность касается всех четырёх сторон трапеции."
        },
        {
          "kind": "theorem",
          "text": "Отрезки двух касательных к окружности, проведённых из одной точки, равны (планиметрия)."
        }
      ],
      "view": "tangencies"
    },
    {
      "id": "step-2",
      "title": "Суммы противоположных сторон",
      "prompt": "Чему равна сумма боковых сторон?",
      "explanation": "AB+EK=(AP+PB)+(ER+RK). Заменяя равные отрезки, получаем AS+BQ+EQ+KS=AK+BE. Значит, сумма боковых сторон равна сумме оснований: AK+BE=22,5+27,5=50 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные отрезки касательных из каждой вершины; сложение частей отрезка."
        }
      ],
      "view": "tangencies"
    },
    {
      "id": "step-3",
      "title": "Периметр",
      "prompt": "Как сложить основания и боковые стороны?",
      "explanation": "Периметр равен AB+BE+EK+KA=(AB+EK)+(BE+KA)=50+50=100 см. Равенство боковых сторон для решения не требуется; симметричная трапеция на модели — один допустимый пример.",
      "justifications": [
        {
          "kind": "definition",
          "text": "Периметр — сумма длин всех сторон."
        }
      ],
