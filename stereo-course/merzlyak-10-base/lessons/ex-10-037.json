  "steps": [
    {
      "title": "Задай координаты",
      "prompt": "Как обосновать шаг «задай координаты»?",
      "explanation": "Возьмём A=(0,0,0), B=(1,0,0), D=(0,1,0), A₁=(0,0,1). Тогда C=(1,1,0), B₁=(1,0,1).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Координаты в ортонормированном базисе вдоль рёбер куба."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Построй кандидата",
      "prompt": "Как обосновать шаг «построй кандидата»?",
      "explanation": "Пусть P — середина AC: P=(1/2,1/2,0). На B₁D возьмём Q с B₁Q:QD=2:1: Q=(1/3,2/3,1/3).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула деления отрезка."
        }
      ],
      "view": "perp",
      "id": "step-2"
    },
    {
      "title": "Проверь прямые углы",
      "prompt": "Как обосновать шаг «проверь прямые углы»?",
      "explanation": "PQ=(−1/6,1/6,1/3). Его скалярные произведения с AC=(1,1,0) и B₁D=(−1,1,−1) равны 0: −1/6+1/6=0 и 1/6+1/6−1/3=0. Поэтому PQ — общий перпендикуляр.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В ортонормированных координатах u⊥v тогда и только тогда, когда uₓvₓ+uᵧvᵧ+u_zv_z=0."
        }
      ],
      "view": "perp",
      "id": "step-3"
    },
    {
      "title": "Найди длину",
      "prompt": "Как обосновать шаг «найди длину»?",
      "explanation": "PQ=√(1/36+1/36+1/9)=√6/6 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула расстояния в прямоугольных координатах."
        }
      ],
      "view": "perp",
