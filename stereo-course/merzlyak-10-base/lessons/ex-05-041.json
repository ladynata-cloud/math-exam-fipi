    },
    {
      "title": "Найди высоту",
      "prompt": "Найди высоту. Объясни свой выбор.",
      "explanation": "В CHD: (5x)²=(3x)²+16². Отсюда 16x²=256, x=4, высота h=12 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "height",
      "id": "step-2"
    },
    {
      "title": "Найди основания",
      "prompt": "Найди основания. Объясни свой выбор.",
      "explanation": "Меньшая диагональ соединяет вершины при меньшем основании: AC²=AB²+BC². Поэтому BC=√(13²−12²)=5 см. AD=5+16=21 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "diagonal",
      "id": "step-3"
    },
