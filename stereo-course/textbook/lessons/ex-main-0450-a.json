  "help": [
    {
      "id": "h1",
      "question": "Как связаны AC и пространственная диагональ?",
      "text": "AC — её ортогональная проекция на основание.",
      "view": "face"
    },
    {
      "id": "h2",
      "question": "С какой прямой дан второй угол?",
      "text": "Задана прямая AB, поэтому нужна проекция на прямую.",
      "view": "project"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди высоту и диагональ основания",
      "prompt": "Отрезок AC₁ = 1 м наклонён к своей проекции AC на 45°. Каковы катеты?",
      "explanation": "Получаем AC = cos 45° = √2/2 м, CC₁ = sin 45° = √2/2 м.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямоугольный треугольник ACC₁ имеет гипотенузу AC₁."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вычисли сторону AB",
      "prompt": "Где находится ортогональная проекция AC₁ на AB?",
      "explanation": "Из ∠C₁AB = 60° следует AB = AC₁ cos 60° = 1/2 м. Плоскость боковой грани через BB₁ и BC перпендикулярна AB.",
      "view": "project",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проекция пространственной диагонали на направление ребра равна длине этого ребра."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Восстанови вторую сторону",
      "prompt": "Что даёт прямоугольный треугольник ABC?",
      "explanation": "BC² = AC²−AB² = 1/2−1/4 = 1/4. Берём положительную длину BC = 1/2 м.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ основания равна гипотенузе треугольника ABC."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Рассчитай объём",
      "prompt": "Какова доля кубического метра?",
      "explanation": "V = (1/2)·(1/2)·(√2/2) = √2/8 м³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Все три измерения выражены в метрах."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь перенос",
      "prompt": "У отрезка длиной 2 м, расположенного под углом 60° к прямой, какова длина проекции на прямую?",
      "explanation": "Проекция равна 2 cos 60° = 1 м.",
      "view": "project",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина ортогональной проекции зависит от косинуса угла с прямой."
        }
      ],
      "input": {
        "prompt": "Введи длину проекции в метрах.",
        "accepted": [
          "1"
        ],
        "feedback": "Проекция равна половине длины отрезка."
      }
    }
  ],
