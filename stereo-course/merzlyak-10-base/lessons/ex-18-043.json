  "steps": [
    {
      "title": "Линейный угол",
      "prompt": "Линейный угол — выполните этот шаг самостоятельно.",
      "explanation": "Пусть боковое ребро равно l. Опустим из A и C перпендикуляры к прямой SB. Их основания совпадают в H, так как SA=SC и ∠ASB=∠CSB=α. Искомый двугранный угол φ равен ∠AHC.",
      "view": "normal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Длины в сечении",
      "prompt": "Длины в сечении — выполните этот шаг самостоятельно.",
      "explanation": "AH=CH=l sinα. Сторона равнобедренной грани AC=2l sin(α/2).",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Половина линейного угла",
      "prompt": "Половина линейного угла — выполните этот шаг самостоятельно.",
      "explanation": "В равнобедренном AHC sin(φ/2)=AC/(2AH)=sin(α/2)/sinα=1/(2cos(α/2)).",
      "view": "normal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Ответ",
      "prompt": "Ответ — выполните этот шаг самостоятельно.",
      "explanation": "φ=2arcsin(1/(2cos(α/2))). Для невырожденной правильной треугольной пирамиды 0°<α<120°.",
      "view": "normal",
