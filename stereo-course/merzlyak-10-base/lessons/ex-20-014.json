  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Пусть O — середина обоих диаметров, O₁ — её проекция на α по заданному направлению. Параллельное проецирование сохраняет середины."
    }
  ],
  "steps": [
    {
      "title": "Используй общий центр",
      "prompt": "Как обосновать шаг «используй общий центр»?",
      "explanation": "Пусть O — середина обоих диаметров, O₁ — её проекция на α по заданному направлению. Параллельное проецирование сохраняет середины.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойство параллельного проецирования."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Найди средний отрезок",
      "prompt": "Как обосновать шаг «найди средний отрезок»?",
      "explanation": "Окружность целиком с одной стороны α, поэтому направленные отрезки до α имеют одинаковый знак. По средней линии трапеции OO₁=(AA₁+BB₁)/2=7 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия трапеции; отсутствие пересечения окружности с плоскостью."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Используй второй диаметр",
      "prompt": "Как обосновать шаг «используй второй диаметр»?",
      "explanation": "Также OO₁=(CC₁+DD₁)/2. Поэтому CC₁=2·7−3=11 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Средняя линия второй трапеции."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    }
