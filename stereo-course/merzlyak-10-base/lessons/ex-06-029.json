  "help": [
    {
      "id": "help-1",
      "question": "Как начать?",
      "text": "Продли нижний след EF до AB; затем свяжи его с верхним следом."
    }
  ],
  "steps": [
    {
      "title": "Нижний след",
      "prompt": "Какая прямая известна сразу?",
      "explanation": "Прямая EF лежит в основании и в секущей. Её часть EF является нижней стороной сечения.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две данные точки секущей в одной грани."
        }
      ],
      "view": "bottom",
      "id": "step-1"
    },
    {
      "title": "Верхний след",
      "prompt": "Как использовать K?",
      "explanation": "Через K в верхней грани проводим прямую, параллельную EF. В положении модели она пересекает A₁B₁ в P; PK — верхняя сторона сечения.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Следы в параллельных гранях параллельны."
        }
      ],
      "view": "top",
      "id": "step-2"
    },
    {
      "title": "Одна боковая грань",
      "prompt": "Как найти точку на AA₁?",
      "explanation": "Продлим EF до U=EF∩AB. Верхний след пересекает A₁B₁ в P. Прямая UP — след секущей в ABB₁A₁; она пересекает AA₁ в Q. Через F в противоположной грани DCC₁D₁ проводим прямую, параллельную UP, до CC₁ в S.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Метод следов и параллельность противоположных граней."
        }
      ],
      "view": "section",
      "id": "step-3"
    },
    {
      "title": "Замыкание",
      "prompt": "Какие отрезки завершают контур?",
      "explanation": "Соединяем Q с E в передней грани и S с K в задней. Для показанного расположения сечение — EFSKPQ. Каждая пара соседних вершин лежит в одной грани и в построенной плоскости.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сечение выпуклого многогранника."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
