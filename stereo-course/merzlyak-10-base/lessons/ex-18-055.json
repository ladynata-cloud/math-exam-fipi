  "steps": [
    {
      "title": "Параллельные направления",
      "prompt": "Параллельные направления — выполните этот шаг самостоятельно.",
      "explanation": "Выберем противоположные рёбра AB и SC. Они перпендикулярны: если K — середина AB, то CK и SK — высоты равносторонних граней, AB ⟂ (SCK), следовательно AB ⟂ SC.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Форма сечения",
      "prompt": "Форма сечения — выполните этот шаг самостоятельно.",
      "explanation": "Пусть P∈AC, Q∈BC, R∈BS, T∈AS — вершины сечения. Из параллельности получаем PQ ∥ TR ∥ AB и PT ∥ QR ∥ SC. Поэтому сечение — прямоугольник.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Сумма сторон",
      "prompt": "Сумма сторон — выполните этот шаг самостоятельно.",
      "explanation": "Пусть AP/AC=t, 0<t<1. Из подобия треугольников PQ=(1−t)AB=1−t, PT=t·CS=t. Значит площадь S=t(1−t).",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Максимум",
      "prompt": "Максимум — выполните этот шаг самостоятельно.",
      "explanation": "S=1/4−(t−1/2)²≤1/4. Равенство достигается при t=1/2: сечение проходит через середины четырёх рёбер и является квадратом со стороной 1/2. Ответ: 1/4 см².",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
