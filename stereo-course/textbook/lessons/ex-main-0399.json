  "help": [
    {
      "id": "h1",
      "question": "Что меняется при выборе другой оси вращения?",
      "text": "Обозначь AD = a и AB = b. При вращении вокруг AD высота равна a, радиус — b. При вращении вокруг AB эти роли меняются.",
      "view": "second",
      "theoryIds": [
        "theory-038",
        "theory-039"
      ]
    },
    {
      "id": "h2",
      "question": "Как исключить сами стороны?",
      "text": "Сложи формулы полных площадей, а затем сложи их квадраты. В одной сумме появится (a + b)², в другой — ещё и a² + b².",
      "view": "sum",
      "theoryIds": [
        "theory-039"
      ]
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Запиши первую площадь",
      "prompt": "Какие r и h у цилиндра с осью AD?",
      "explanation": "Пусть AD = a, AB = b. При вращении вокруг AD получаем h = a, r = b. Его полная площадь S₁ = 2πb² + 2πab = 2πb(a + b).",
      "view": "first",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Полная площадь цилиндра равна 2πr² + 2πrh.",
          "theoryId": "theory-039",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "39",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              91,
              92
            ],
            "pdfPages": [
              93,
              94
            ]
          }
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Запиши вторую площадь",
      "prompt": "Как выглядит формула при оси AB?",
      "explanation": "При вращении вокруг AB получаем h = b, r = a. Поэтому S₂ = 2πa² + 2πab = 2πa(a + b). Обозначения S₁ и S₂ можно поменять местами: итоговая формула будет симметричной.",
      "view": "second",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При смене оси вращения стороны прямоугольника меняются ролями радиуса и высоты.",
          "theoryId": "theory-038",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "38",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              89,
              90,
              91
            ],
            "pdfPages": [
              91,
              92,
              93
            ]
          }
        },
        {
          "kind": "theorem",
          "text": "Полная площадь цилиндра равна сумме боковой площади и площадей двух оснований.",
          "theoryId": "theory-039",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "39",
            "chapter": "IV. Цилиндр, конус и шар",
            "printedPages": [
              91,
              92
            ],
            "pdfPages": [
              93,
              94
            ]
          }
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Найди квадрат суммы сторон",
      "prompt": "Что даёт сумма S₁ + S₂?",
      "explanation": "S₁ + S₂ = 2π(a + b)(b + a) = 2π(a + b)². Значит, (a + b)² = (S₁ + S₂)/(2π).",
      "view": "sum",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Вынесение общего множителя и формула квадрата суммы."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Найди сумму квадратов сторон",
      "prompt": "Как выразить a² + b² через площади?",
      "explanation": "S₁² + S₂² = 4π²(a + b)²(a² + b²). Подставляем найденное значение (a + b)² и получаем a² + b² = (S₁² + S₂²)/(2π(S₁ + S₂)). Знаменатель положителен, поскольку обе площади положительны.",
      "view": "diagonal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если два выражения равны, их квадраты равны; затем складываем равенства."
        },
        {
          "kind": "theorem",
          "text": "Длины a и b положительны, поэтому S₁ + S₂ > 0."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Вычисли диагональ",
      "prompt": "Как выбрать знак квадратного корня?",
      "explanation": "По теореме Пифагора d² = a² + b². Диагональ имеет положительную длину, поэтому d = √((S₁² + S₂²)/(2π(S₁ + S₂))).",
      "view": "diagonal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ прямоугольника является гипотенузой треугольника с катетами a и b."
        },
        {
          "kind": "theorem",
          "text": "Для длины выбирается положительный квадратный корень."
        }
      ]
    }
