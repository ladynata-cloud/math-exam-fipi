  "steps": [
    {
      "title": "Неизвестная и ограничения",
      "prompt": "Как выразить измерения через d?",
      "explanation": "Пусть диагональ равна d. Тогда измерения d−9,d−8,d−5; все положительны, поэтому d>9.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Условие задачи и положительность длин."
        }
      ],
      "view": "edges",
      "id": "step-1"
    },
    {
      "title": "Уравнение",
      "prompt": "Как применить формулу диагонали?",
      "explanation": "d²=(d−9)²+(d−8)²+(d−5)². Раскрывая скобки, получаем d²−22d+85=0, то есть(d−17)(d−5)=0.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула диагонали и алгебраическое упрощение."
        }
      ],
      "view": "diagonal",
      "id": "step-2"
    },
    {
      "title": "Допустимый корень",
      "prompt": "Почему ответ не 5?",
      "explanation": "d=5 нарушает d>9. При d=17 измерения 8,9,12 положительны и 8²+9²+12²=289=17². Ответ 17 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проверка ограничения и исходного равенства."
        }
      ],
      "view": "edges",
      "id": "step-3"
    }
