  "help": [
    {
      "id": "h1",
      "question": "Как увидеть угол между плоскостями?",
      "text": "Проведи к их линии пересечения AB два перпендикуляра: OM в основании и SM в сечении.",
      "view": "dihedral",
      "theoryIds": []
    },
    {
      "id": "h2",
      "question": "Как найти хорду?",
      "text": "В равнобедренном OAB проведи OM к середине AB. Центральный угол 120° разделится пополам.",
      "view": "base",
      "theoryIds": []
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди половину хорды",
      "prompt": "Чему равны AM и OM?",
      "explanation": "Пусть M — середина хорды AB, O — центр основания. OM ⟂ AB, ∠AOM = 60°. Поэтому AM = 4 sin 60° = 2√3 см, OM = 4 cos 60° = 2 см. Значит, AB = 4√3 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикуляр из центра окружности делит хорду и её центральный угол пополам."
        }
      ]
    },
    {
      "id": "step-2",
