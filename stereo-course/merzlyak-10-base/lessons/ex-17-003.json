  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Сначала найди диагональ основания."
    }
  ],
  "steps": [
    {
      "title": "Проекция диагонали",
      "prompt": "Чему равна диагональ основания?",
      "explanation": "AC=√(5²+12²)=13 см. Это ортогональная проекция пространственной диагонали AC₁ на основание.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор и перпендикулярность CC₁ основанию."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Угол с основанием",
      "prompt": "Какой угол равен 60°?",
      "explanation": "∠C₁AC=60°. В прямоугольном ACC₁ катет CC₁=h противолежит этому углу, а AC=13 прилежит. Поэтому tan60°=h/13.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение угла прямой с плоскостью."
        }
      ],
      "view": "triangle",
      "id": "step-2"
    },
    {
      "title": "Ответ",
      "prompt": "Чему равна высота?",
      "explanation": "h=13tan60°=13√3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "tan60°=√3."
        }
      ],
      "view": "triangle",
      "id": "step-3"
    }
  ],
