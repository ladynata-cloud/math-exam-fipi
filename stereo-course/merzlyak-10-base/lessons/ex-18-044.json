  "help": [
    {
      "id": "help-1",
      "question": "Подсказка к первому шагу",
      "text": "Обозначим искомый плоский угол γ, боковое ребро l, сторону основания a. Основания перпендикуляров из A,C к SB совпадают в H. Поэтому ∠AHC=α и AH=CH=l sinγ."
    }
  ],
  "steps": [
    {
      "title": "Линейный угол",
      "prompt": "Линейный угол — выполните этот шаг самостоятельно.",
      "explanation": "Обозначим искомый плоский угол γ, боковое ребро l, сторону основания a. Основания перпендикуляров из A,C к SB совпадают в H. Поэтому ∠AHC=α и AH=CH=l sinγ.",
      "view": "normal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Диагональ основания",
      "prompt": "Диагональ основания — выполните этот шаг самостоятельно.",
      "explanation": "AC=a√2, причём a=2l sin(γ/2). В равнобедренном AHC sin(α/2)=AC/(2AH).",
      "view": "normal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Выразим половину искомого угла",
      "prompt": "Выразим половину искомого угла — выполните этот шаг самостоятельно.",
      "explanation": "sin(α/2)=√2·sin(γ/2)/sinγ=√2/(2cos(γ/2)). Значит cos(γ/2)=√2/(2sin(α/2)).",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Ответ",
      "prompt": "Ответ — выполните этот шаг самостоятельно.",
      "explanation": "γ=2arccos(√2/(2sin(α/2))). Для такой пирамиды 90°<α<180°, 0°<γ<90°.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
