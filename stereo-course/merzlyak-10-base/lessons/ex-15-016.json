  "steps": [
    {
      "title": "Определи проекцию",
      "prompt": "Определи проекцию. Объясни свой выбор.",
      "explanation": "Пусть AB=a. Так как плоскость проходит через MK и пересекает три боковых ребра, это рёбра через B,C,D. Проекция сечения на основание — пятиугольник MBCDK.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Положение плоскости относительно линии MK в основании."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Найди его площадь",
      "prompt": "Найди его площадь. Объясни свой выбор.",
      "explanation": "Площадь AMK равна (a/2)(a/2)/2=a²/8. Поэтому площадь проекции a²−a²/8=7a²/8.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь прямоугольного треугольника."
        }
      ],
      "view": "corner",
      "id": "step-2"
    },
    {
      "title": "Примени теорему и вырази a",
      "prompt": "Примени теорему и вырази a. Объясни свой выбор.",
      "explanation": "S cosα=7a²/8. Следовательно AB=a=√(8S cosα/7). Ответ: √(8S cosα/7).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о площади ортогональной проекции: S₁=S·cosφ, где φ — угол между плоскостями."
        }
      ],
