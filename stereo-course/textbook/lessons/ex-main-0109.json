  "steps": [
    {
      "id": "step-1",
      "title": "Обозначим общие точки",
      "prompt": "Какие точки принадлежат обеим плоскостям?",
      "explanation": "Это плоскости ACC1A1 и BDD1B1. Пусть O = AC ∩ BD и O1 = A1C1 ∩ B1D1. Обе точки лежат в обеих плоскостях, поэтому их общая прямая — OO1.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали параллелограмма пересекаются.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        },
        {
          "kind": "theorem",
          "text": "Две общие точки различных плоскостей определяют их общую прямую.",
          "theoryId": "atanasyan2024-theory-002-a3"
        }
      ],
      "view": "line"
    },
    {
      "id": "step-2",
      "title": "Направление общей прямой",
      "prompt": "Почему OO1 параллельна боковым рёбрам?",
      "explanation": "В параллелограмме ACC1A1 точки O и O1 — середины противоположных сторон AC и A1C1. Соединяющий их отрезок параллелен и равен AA1. Следовательно a ∥ AA1 и всем остальным боковым рёбрам.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Отрезок между серединами противоположных сторон параллелограмма параллелен двум другим сторонам.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        },
        {
          "kind": "theorem",
          "text": "Все боковые рёбра параллелепипеда параллельны.",
          "theoryId": "theory-013"
        }
      ],
      "view": "line"
    },
    {
      "id": "step-3",
      "title": "Пересечение с диагоналями",
      "prompt": "Где находятся середины четырёх диагоналей?",
      "explanation": "Диагонали AC1 и CA1 параллелограмма ACC1A1 пересекаются в его центре S, лежащем в середине OO1. Диагонали BD1 и DB1 параллелограмма BDD1B1 также пересекаются в середине того же OO1, значит в S. Таким образом a проходит через общую точку всех четырёх диагоналей.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагонали параллелограмма делятся пополам; центр лежит в середине отрезка между серединами противоположных сторон.",
          "theoryId": "atanasyan2024-theory-002-planimetry"
        }
      ],
