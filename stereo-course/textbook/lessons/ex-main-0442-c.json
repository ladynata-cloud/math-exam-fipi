  "help": [
    {
      "id": "h1",
      "question": "Как связать заданный отрезок с ребром?",
      "text": "Выдели на модели подходящий прямоугольный треугольник.",
      "view": "mid"
    },
    {
      "id": "h2",
      "question": "Что делать после нахождения ребра?",
      "text": "Все три измерения куба совпадают.",
      "view": "sides"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Вырази заданную длину",
      "prompt": "Какие катеты имеют треугольник DAE?",
      "explanation": "AD = a, AE = a/2, угол DAE прямой. Значит, DE² = a²+a²/4 = 5a²/4. При DE = 1 см ребро a = 2/√5 см.",
      "view": "mid",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора связывает катеты прямоугольного треугольника с его гипотенузой."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вычисли объём",
      "prompt": "В какую степень возводить найденную длину?",
      "explanation": "Из (2/√5)³ = 8/(5√5) получаем 8√5/25. Получаем V = 8√5/25 см³.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём куба с ребром a равен a³."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Проверь изменение масштаба",
      "prompt": "Если данный в условии отрезок увеличить вдвое при сохранении формы куба, во сколько раз возрастёт V?",
      "explanation": "Все линейные размеры увеличатся в 2 раза, значит объём — в 2³ = 8 раз.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У подобных тел объёмы пропорциональны кубу линейного масштаба."
        }
      ],
