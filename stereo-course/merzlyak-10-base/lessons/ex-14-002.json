  "help": [
    {
      "id": "help-1",
      "question": "Достаточно ли общей прямой двух плоскостей?",
      "text": "Нет: нужно показать угол 90° или найти в одной плоскости прямую, перпендикулярную другой."
    }
  ],
  "steps": [
    {
      "title": "Пара 1",
      "prompt": "Пара 1. Объясни свой выбор.",
      "explanation": "Да: плоскость CDD₁ содержит CC₁, перпендикулярную плоскости верхней грани A₁B₁C₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если плоскость содержит прямую, перпендикулярную другой плоскости, то эти плоскости перпендикулярны."
        }
      ],
      "view": "one",
      "id": "step-1"
    },
    {
      "title": "Пара 2",
      "prompt": "Пара 2. Объясни свой выбор.",
      "explanation": "Нет: плоскости нижней и верхней граней куба параллельны, угол между ними равен 0°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойства куба."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Пара 3",
      "prompt": "Пара 3. Объясни свой выбор.",
      "explanation": "Да: плоскость AA₁C₁ содержит AA₁⊥(ABC).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Если плоскость содержит прямую, перпендикулярную другой плоскости, то эти плоскости перпендикулярны."
        }
      ],
      "view": "three",
      "id": "step-3"
    },
    {
      "title": "Пара 4",
      "prompt": "Пара 4. Объясни свой выбор.",
      "explanation": "Да. AC⊥BD как диагонали квадрата и AC⊥DD₁ как горизонтальная прямая вертикальному ребру. Значит AC⊥(BDD₁); плоскость ACC₁ содержит AC и перпендикулярна BDD₁.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Прямая, перпендикулярная двум пересекающимся прямым плоскости, перпендикулярна этой плоскости. Если плоскость содержит прямую, перпендикулярную другой плоскости, то эти плоскости перпендикулярны."
        }
      ],
      "view": "four",
      "id": "step-4"
    }
