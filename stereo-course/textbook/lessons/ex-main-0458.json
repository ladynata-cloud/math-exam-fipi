  "help": [
    {
      "id": "h1",
      "question": "Куда проектируется наибольшая пространственная диагональ?",
      "text": "У всех диагоналей высота одинаковая, поэтому наибольшая имеет наибольшую проекцию в основании.",
      "view": "diagonal"
    },
    {
      "id": "h2",
      "question": "Как соотносятся сторона и длинная диагональ правильного шестиугольника?",
      "text": "Длинная диагональ проходит через центр и равна двум радиусам окружности основания.",
      "view": "sector"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди высоту и горизонтальную проекцию",
      "prompt": "Какую составляющую даёт косинус угла с вертикалью?",
      "explanation": "DD₁ = 8 cos 30° = 4√3 см. Проекция AD = 8 sin 30° = 4 см.",
      "view": "diagonal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В прямоугольном треугольнике косинус относится к прилежащему катету."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди сторону основания",
      "prompt": "Почему AD = 2a?",
      "explanation": "В правильном шестиугольнике радиус описанной окружности равен стороне. Значит, a = AD/2 = 2 см.",
      "view": "sector",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Шесть центральных треугольников правильного шестиугольника равносторонние."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Вычисли S и V",
      "prompt": "Сколько равносторонних треугольников нужно сложить?",
      "explanation": "Основание имеет S = 6·(√3·2²/4) = 6√3 см². Умножение на 4√3 даёт V = 72 см³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём прямой призмы равен произведению площади основания на высоту."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "В такой же призме пространственная диагональ увеличена до 10 см, угол по-прежнему 30°. Найди длинную диагональ основания.",
      "explanation": "Горизонтальная составляющая равна 10 sin 30° = 5 см.",
      "view": "diagonal",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Горизонтальный катет противолежит углу с вертикалью."
        }
      ],
      "input": {
        "prompt": "Введи длину в сантиметрах.",
        "accepted": [
          "5"
        ],
        "feedback": "Горизонтальный катет противолежит углу с вертикалью."
      }
    }
