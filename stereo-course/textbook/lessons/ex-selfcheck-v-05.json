  "help": [
    {
      "id": "h1",
      "question": "Определяют ли четыре стороны углы?",
      "text": "Сравни квадрат и ромб с острым углом 30° при одной и той же стороне.",
      "view": "first"
    },
    {
      "id": "h2",
      "question": "Какой размер ромба меняет его площадь?",
      "text": "Высота ромба к данной стороне равна a sin α.",
      "view": "next"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Первое основание",
      "prompt": "У квадрата сторона 2. Чему равна его площадь?",
      "explanation": "Площадь квадрата равна 4. У пирамиды высоты 3 с таким основанием объём тоже 4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём пирамиды равен трети произведения площади основания и высоты."
        }
      ],
      "view": "first",
      "input": {
        "prompt": "Первое основание",
        "accepted": [
          "4"
        ],
        "feedback": "Умножь длину стороны саму на себя."
      }
    },
    {
      "id": "step-2",
      "title": "Контрпример",
      "prompt": "Пусть другое основание — ромб со стороной 2 и углом 30°. Чему равна его площадь?",
      "explanation": "2² sin 30° = 4·1/2 = 2. Пирамида той же высоты 3 имеет объём 2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь ромба определяется двумя сторонами и углом между ними.",
          "theoryId": "theory-058"
        }
      ],
      "view": "next",
      "input": {
        "prompt": "Контрпример",
        "accepted": [
          "2"
        ],
        "feedback": "Сторона ромба не равна его высоте, когда угол острый."
      }
    },
    {
      "id": "step-3",
      "title": "Сравни объёмы",
      "prompt": "Чему равно отношение второго объёма к первому на модели?",
      "explanation": "2/4 = 1/2. Уже этот пример показывает, что равенство сторон и высот не гарантирует равенства объёмов.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При равных высотах объёмы пирамид относятся как площади оснований."
        }
      ],
      "view": "next",
      "input": {
        "prompt": "Сравни объёмы",
        "accepted": [
          "1/2"
        ],
        "feedback": "Сравни площади, а не равные длины сторон."
      }
    }
