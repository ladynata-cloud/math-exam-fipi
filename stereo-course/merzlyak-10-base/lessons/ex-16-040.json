  "steps": [
    {
      "title": "Построение",
      "prompt": "Как провести нужное направление через центр?",
      "explanation": "Выберем диагональ основания AC и диагональ призмы BD₁. Они скрещиваются. Пусть O — центр основания. В треугольнике DBD₁ точка O — середина DB; прямая через O параллельно BD₁ пересекает DD₁ в середине M. Плоскость ACM — искомая.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о средней линии треугольника."
        }
      ],
      "view": "parallel",
      "id": "step-1"
    },
    {
      "title": "Размеры",
      "prompt": "Чему равны AC и OM?",
      "explanation": "AC=BD=(4√2)√2=8 см. BD₁=√(8²+6²)=10 см. Поэтому OM=BD₁/2=5 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ квадрата, Пифагор и средняя линия."
        }
      ],
      "view": "diagonal",
      "id": "step-2"
    },
    {
      "title": "Высота треугольника",
      "prompt": "Почему OM перпендикулярен AC?",
      "explanation": "AC перпендикулярен BD и вертикальному направлению DD₁, поэтому перпендикулярен плоскости BDD₁ и её прямой OM. Значит S_ACM=AC·OM/2=8·5/2=20 см². Симметрия квадрата даёт тот же ответ для остальных допустимых выборов.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
