  "steps": [
    {
      "title": "Общие длины",
      "prompt": "Как связать диагональ грани и сторону основания?",
      "explanation": "Пусть сторона основания a, длина диагонали боковой грани L. Тогда L²=a²+h², а BD=a√2. Искомое сечение — равнобедренный треугольник BA₁D с углом α между сторонами L.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пифагор и строение сечения."
        }
      ],
      "view": "section",
      "id": "step-1"
    },
    {
      "title": "Косинус угла",
      "prompt": "Что даёт теорема косинусов?",
      "explanation": "BD²=2L²(1−cosα), то есть 2a²=2L²(1−cosα). Вычитая a² из L², получаем h²=L²cosα. Поэтому L²=h²/cosα; для невырожденной призмы 0<α<90°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов."
        }
      ],
      "view": "base",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Как использовать две стороны и угол?",
      "explanation": "S=L²sinα/2=h²sinα/(2cosα)=(h²/2)tanα.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь треугольника по двум сторонам и углу."
        }
      ],
      "view": "face",
      "id": "step-3"
    }
