  "help": [
    {
      "question": "Почему число 12 не следует только из угла 324°?",
      "text": "Угол ограничивает вид вершины. Число граней можно вывести из трёх уравнений двойного подсчёта и Эйлера; это сделано в карточке о подсчёте элементов.",
      "theoryIds": [
        "theory-036-euler-count"
      ],
      "id": "h1"
    },
    {
      "question": "Почему при вершине не могут встретиться четыре пятиугольника?",
      "text": "Тогда сумма углов была бы 4·108° = 432°, больше полного оборота.",
      "view": "vertex",
      "id": "h2"
    }
  ],
  "steps": [
    {
      "title": "Посчитай углы одной грани",
      "prompt": "Какой внутренний угол у правильного пятиугольника?",
      "explanation": "Сумма пяти внутренних углов равна 3·180° = 540°. Каждый угол равен 540°/5 = 108°.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сумма углов выпуклого пятиугольника равна 540°, а у правильного все углы равны."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Сложи углы при вершине",
      "prompt": "Сколько пятиугольников здесь встречается?",
      "explanation": "При каждой вершине встречаются три грани. Сумма плоских углов равна 3·108° = 324°. Она меньше 360°, как и требуется для выпуклого многогранника.",
      "view": "vertex",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В данной вершине три одинаковых плоских угла по 108°."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Подсчитай рёбра",
      "prompt": "Сколько граней составляет поверхность?",
      "explanation": "У додекаэдра f = 12 граней. Их стороны дают 12·5 = 60 подсчётов. Каждое ребро учтено дважды, поэтому k = 30.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Двенадцать пятиугольных граней; каждое ребро принадлежит двум граням."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Подсчитай вершины",
      "prompt": "Как разделить число концов всех рёбер?",
      "explanation": "У тридцати рёбер 60 концов с повторениями. В каждой вершине соединены три конца, поэтому e = 60/3 = 20. Проверка: 12 + 20 − 30 = 2.",
      "view": "vertex",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждое ребро имеет два конца, а степень каждой вершины равна трём."
        }
      ],
      "id": "step-4"
    },
    {
      "title": "Свяжи модель с построением",
      "prompt": "Из какой уже рассмотренной фигуры можно получить вершины додекаэдра?",
      "explanation": "Они получаются как центры двадцати граней правильного икосаэдра. В отдельной карточке проверяется, почему пять центров вокруг каждой вершины икосаэдра образуют правильный пятиугольник.",
      "view": "face",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Конструкция из центров граней рассматривается в замечании 2 к пункту 36.",
          "theoryId": "theory-036-dodecahedron-existence"
        }
      ],
      "id": "step-5"
    }
