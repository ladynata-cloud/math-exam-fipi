  "help": [
    {
      "id": "h1",
      "question": "Какую длину можно найти из площади одного основания?",
      "text": "Круг имеет площадь Q = πr². Положительный радиус равен √(Q/π).",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Можно ли избежать отдельного вычисления высоты?",
      "text": "Перепиши объём πr²h как r·(2πrh)/2. В скобках стоит площадь боковой поверхности S.",
      "view": "section"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Восстанови радиус",
      "prompt": "На модели Q = 9π и S = 24π. Каков радиус?",
      "explanation": "r = √(9π/π) = 3. Диаметр модели равен 6.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Q относится к одному основанию."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Радиус",
        "accepted": [
          "3"
        ],
        "feedback": "Раздели Q на π и извлеки положительный корень."
      }
    },
    {
      "id": "step-2",
      "title": "Найди высоту",
      "prompt": "Чему равна высота модели?",
      "explanation": "Площадь боковой поверхности есть длина окружности, умноженная на высоту: 24π = 6πh, откуда h = 4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При развёртывании боковая поверхность даёт прямоугольник со сторонами 2πr и h."
        }
      ],
      "view": "section",
      "input": {
        "prompt": "Высота",
        "accepted": [
          "4"
        ],
        "feedback": "В боковой площади участвует длина окружности 2πr."
      }
    },
    {
      "id": "step-3",
      "title": "Объём через заданные площади",
      "prompt": "Сколько единиц π содержит объём выбранного цилиндра?",
      "explanation": "V = Qh = 36π. Для любых S и Q подставь r = √(Q/π) в V = Sr/2: V = (S/2)√(Q/π).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В произведении 2πrh содержится только одна степень радиуса.",
          "theoryId": "theory-055"
        }
      ],
      "view": "section",
      "input": {
        "prompt": "Коэффициент",
        "accepted": [
          "36"
        ],
        "feedback": "Для численного объёма умножь 9π на 4. Введи только коэффициент при π."
      }
    },
    {
      "id": "step-4",
      "title": "Другие основания",
      "prompt": "При прежней боковой площади 24π, но Q = 4π найди новый коэффициент при π в объёме.",
      "explanation": "Радиус равен 2. Из V = Sr/2 получаем 24π. При постоянной боковой площади меньший радиус даёт меньший объём.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При изменённом радиусе высоту определяет заданная боковая площадь."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Новый коэффициент",
        "accepted": [
          "24"
        ],
        "feedback": "Пересчитай радиус по новому основанию и используй Sr/2."
      }
    }
  ],
