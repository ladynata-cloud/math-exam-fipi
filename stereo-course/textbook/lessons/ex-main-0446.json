  "help": [
    {
      "id": "h1",
      "question": "Как извлечь измерение, перпендикулярное боковой грани?",
      "text": "Подумай, какой катет противолежит углу между диагональю и её проекцией.",
      "view": "sideangle"
    },
    {
      "id": "h2",
      "question": "С чем образует 45° диагональ?",
      "text": "С вертикалью. Для вертикального катета здесь нужен косинус.",
      "view": "edgeangle"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди поперечное измерение",
      "prompt": "Какова длина D₁C₁, перпендикулярная выбранной грани?",
      "explanation": "D₁C₁ = 18 sin 30° = 9 см. Этой же длине равно AB.",
      "view": "sideangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Синус угла между прямой и плоскостью равен отношению перпендикулярной составляющей отрезка к его длине."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди вертикаль",
      "prompt": "Какова проекция диагонали на направление бокового ребра?",
      "explanation": "Высота h = 18 cos 45° = 9√2 см.",
      "view": "edgeangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина ортогональной проекции отрезка на прямую равна длине отрезка, умноженной на косинус угла."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Восстанови последнее ребро",
      "prompt": "Чему равен квадрат ребра AD?",
      "explanation": "Для пространственной диагонали выполняется 18² = 9²+AD²+(9√2)². Отсюда AD² = 81 и AD = 9 см.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Квадрат диагонали прямоугольного параллелепипеда равен сумме квадратов трёх измерений."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Вычисли объём",
      "prompt": "Сколько составляет площадь основания?",
      "explanation": "Основание имеет стороны 9 и 9 см, его площадь 81 см². Тогда V = 81·9√2 = 729√2 см³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём равен произведению площади прямоугольного основания на высоту."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь другой отрезок",
      "prompt": "Отрезок длины 10 образует с плоскостью угол 30°. Найди длину перпендикулярной составляющей.",
      "explanation": "Её длина 10·1/2 = 5.",
      "view": "sideangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярную составляющую даёт синус угла с плоскостью."
        }
      ],
      "input": {
        "prompt": "Введи длину составляющей.",
        "accepted": [
          "5"
        ],
        "feedback": "К длине отрезка примени sin 30°."
      }
    }
  ],
  "answer": {
    "mode": "exact",
    "prompt": "Введи точный объём в см³, используя sqrt для корня.",
