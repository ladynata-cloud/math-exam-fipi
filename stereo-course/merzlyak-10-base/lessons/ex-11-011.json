  "steps": [
    {
      "title": "Найди прямой угол",
      "prompt": "Как обосновать шаг «найди прямой угол»?",
      "explanation": "Вписанный угол ACB опирается на диаметр AB, поэтому равен 90°. AC⊥BC.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема об угле, опирающемся на диаметр."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Обоснуй EC=10",
      "prompt": "Как обосновать шаг «обоснуй ec=10»?",
      "explanation": "AC — проекция EC. По теореме о трёх перпендикулярах EC⊥BC, следовательно EC — заданное расстояние 10 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах: прямая плоскости перпендикулярна наклонной тогда и только тогда, когда перпендикулярна её проекции."
        }
      ],
      "view": "distance",
      "id": "step-2"
    },
    {
      "title": "Вычисли AC",
      "prompt": "Как обосновать шаг «вычисли ac»?",
      "explanation": "AC=AB·sin30°=6 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Синус в прямоугольном ABC."
        }
      ],
      "view": "projection",
      "id": "step-3"
    },
    {
      "title": "Найди высоту",
      "prompt": "Как обосновать шаг «найди высоту»?",
      "explanation": "AE=√(EC²−AC²)=√(100−36)=8 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "distance",
      "id": "step-4"
    }
