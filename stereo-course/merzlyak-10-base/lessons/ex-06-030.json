  "steps": [
    {
      "title": "Боковой след",
      "prompt": "Что определяют M и N?",
      "explanation": "В плоскости ABB₁A₁ проведём MN и продлим до пересечения с прямой AB в U. Точка U лежит в основании и в секущей.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Метод следов: две точки задают прямую секущей."
        }
      ],
      "view": "left",
      "id": "step-1"
    },
    {
      "title": "Нижняя и верхняя грани",
      "prompt": "Как найти следы оснований?",
      "explanation": "Соединяем U с K. В модели прямая UK пересекает AD в P, поэтому PK — нижняя сторона. Через N в верхней грани проводим прямую, параллельную UK; она пересекает B₁C₁ в R.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Следы в параллельных основаниях параллельны."
        }
      ],
      "view": "bottom",
      "id": "step-2"
    },
    {
      "title": "Противоположная боковая грань",
      "prompt": "Как провести след через K?",
      "explanation": "В грани DCC₁D₁ через K проводим прямую, параллельную MN. Она пересекает CC₁ в Q. Соединяем Q с R в задней грани, P с M — в передней.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Следы в параллельных боковых гранях параллельны."
        }
      ],
      "view": "section",
      "id": "step-3"
    },
    {
      "title": "Проверка",
      "prompt": "Каков порядок обхода?",
      "explanation": "Для показанных положений получается шестиугольник MPKQRN. Все его вершины на рёбрах; противоположные следы согласованы по параллельности, поэтому весь контур принадлежит MNK. При ином выборе точек берут фактические выходы тех же следов на рёбра.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Пересечение плоскости с гранями выпуклого куба."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
