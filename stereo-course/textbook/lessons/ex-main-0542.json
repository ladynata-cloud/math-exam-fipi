  "help": [
    {
      "id": "h1",
      "question": "Что является диаметром круга?",
      "text": "Круг касается двух параллельных сторон ромба. Расстояние между ними равно высоте ромба a sin φ и диаметру вписанного круга.",
      "view": "inradius"
    },
    {
      "id": "h2",
      "question": "Как связаны высота и образующая?",
      "text": "У прямоугольного треугольника SOK длина горизонтального катета r, а наклонная SK образует с ним угол θ.",
      "view": "generator"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Высота ромба",
      "prompt": "При a = 4 и φ = 30° чему равно расстояние между AB и CD?",
      "explanation": "d = a sin φ = 4·1/2 = 2. Это длина диаметра вписанной в ромб окружности.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота ромба является катетом при стороне a."
        }
      ],
      "view": "inradius",
      "input": {
        "prompt": "Расстояние",
        "accepted": [
          "2"
        ],
        "feedback": "Искомое расстояние — перпендикуляр к стороне, поэтому нужен синус острого угла."
      }
    },
    {
      "id": "step-2",
      "title": "Радиус круга",
      "prompt": "Каков радиус основания конуса?",
      "explanation": "r = d/2 = 1. Всегда r = a sin φ/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Центр вписанной окружности равноудалён от всех сторон ромба."
        }
      ],
      "view": "inradius",
      "input": {
        "prompt": "Радиус",
        "accepted": [
          "1"
        ],
        "feedback": "Диаметр связывает две стороны. Сравни его с одним радиусом."
      }
    },
    {
      "id": "step-3",
      "title": "Объём вписанного конуса",
      "prompt": "При θ = 45° найди коэффициент при π в объёме.",
      "explanation": "H = r tan θ = 1. Поэтому V = π/3. Для произвольных данных V = πa³sin³φ tan θ/24.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Три множителя r появляются из площади круга и высоты.",
          "theoryId": "theory-059"
        }
      ],
      "view": "generator",
      "input": {
        "prompt": "Коэффициент объёма",
        "accepted": [
          "1/3"
        ],
        "feedback": "Дели πr²H на три. Используй радиус вписанного круга."
      }
    },
    {
      "id": "step-4",
      "title": "Увеличь сторону",
      "prompt": "При тех же углах a увеличили с 4 до 8. Чему равен новый коэффициент при π?",
      "explanation": "Радиус и высота удваиваются. Объём возрастает в восемь раз и равен 8π/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При одинаковых углах тела подобны."
        }
      ],
      "view": "generator",
      "input": {
        "prompt": "Новый коэффициент",
        "accepted": [
          "8/3"
        ],
        "feedback": "Два линейных множителя приходят из площади, ещё один — из высоты."
      }
    }
