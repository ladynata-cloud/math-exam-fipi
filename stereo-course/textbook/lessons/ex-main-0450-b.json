  "help": [
    {
      "id": "h1",
      "question": "Какой из углов измерен от вертикали?",
      "text": "Угол 45° образован с ребром AA₁.",
      "view": "edgeangle"
    },
    {
      "id": "h2",
      "question": "Что означает угол с боковой плоскостью?",
      "text": "Выдели треугольник из диагонали, её проекции и перпендикулярной составляющей.",
      "view": "sideangle"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди высоту",
      "prompt": "Пространственная диагональ AC₁ = 24 см образует с вертикалью AA₁ угол 45°. Какова её вертикальная составляющая?",
      "explanation": "Проекция на AA₁ равна 24 cos 45° = 12√2 см. Длина проекции на основание AC тоже равна 12√2 см.",
      "view": "edgeangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В прямоугольном треугольнике с углом 45° катеты равны."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди сторону поперёк грани",
      "prompt": "Какая часть диагонали определяется углом 30° к боковой плоскости?",
      "explanation": "Её составляющая, перпендикулярная плоскости, равна 24 sin 30° = 12 см. Можно выбрать обозначения так, что это AB.",
      "view": "sideangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковые грани прямоугольного параллелепипеда вертикальны, поэтому их нормали горизонтальны."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Найди второе ребро основания",
      "prompt": "Чему равно второе ребро основания?",
      "explanation": "Из диагонали AC² = 288 вычитаем AB² = 144. Получаем BC = √144 = 12 см.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В основании прямой угол между соседними рёбрами."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Рассчитай объём",
      "prompt": "Какие три измерения нужно перемножить?",
      "explanation": "V = 12·12·12√2 = 1728√2 см³.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При умножении трёх длин в сантиметрах получается объём в кубических сантиметрах."
        }
      ]
    },
    {
      "id": "step-5",
      "title": "Проверь прямую и плоскость",
      "prompt": "У отрезка длиной 8 см угол с вертикальной боковой плоскостью 30°. Какова перпендикулярная этой плоскости составляющая?",
      "explanation": "Она равна 8 sin 30° = 4 см.",
      "view": "sideangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для составляющей поперёк плоскости используется синус угла с плоскостью."
        }
      ],
      "input": {
        "prompt": "Введи длину составляющей в сантиметрах.",
        "accepted": [
          "4"
        ],
        "feedback": "Примени sin 30° к длине 8."
      }
    }
  ],
