  "help": [
    {
      "id": "h1",
      "question": "От чего равноудалён центр сферы?",
      "text": "От плоскостей всех боковых граней.",
      "view": "first"
    },
    {
      "id": "h2",
      "question": "Сколько таких плоскостей нужно для определения оси?",
      "text": "Возьми две соседние вершины основания B и C.",
      "view": "second"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Рассмотри соседние грани",
      "prompt": "Какая плоскость делит внутренний угол при боковом ребре SB?",
      "explanation": "Плоскость SOB является плоскостью симметрии правильной пирамиды. Она меняет местами боковые грани с общим ребром SB и проходит внутри двугранного угла. Значит, это его внутренняя биссекторная плоскость.",
      "view": "first",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Симметрия правильного основания относительно прямой OB продолжается до симметрии пирамиды относительно плоскости SOB."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Используй касание сферы",
      "prompt": "Где должен лежать центр I?",
      "explanation": "Центр находится внутри двугранного угла и равноудалён от его граней. Поэтому I лежит в SOB. По той же причине I лежит в SOC при соседней вершине C.",
      "view": "second",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Точки внутри двугранного угла, равноудалённые от его граней, лежат в его биссекторной плоскости."
        }
      ]
    },
    {
      "id": "step-3",
