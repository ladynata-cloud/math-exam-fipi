  "steps": [
    {
      "id": "step-1",
      "title": "Подготовь площадь",
      "prompt": "Каков квадрат стороны основания?",
      "explanation": "a² = 13² = 169. Площадь равностороннего треугольника равна a²√3/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота равностороннего треугольника равна a√3/2."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи квадрат стороны основания.",
        "accepted": [
          "169"
        ],
        "feedback": "Сторону умножают на саму себя."
      }
    },
    {
      "id": "step-2",
      "title": "Сохрани множитель √3",
      "prompt": "Какой коэффициент перед √3 в площади?",
      "explanation": "S = 169√3/4 см². Множитель перед √3 равен 169/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь — половина произведения стороны на высоту треугольника."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи коэффициент в площади.",
        "accepted": [
          "169/4"
        ],
        "feedback": "В формуле площади подставь 169 вместо a² и раздели на 4."
      }
    },
    {
      "id": "step-3",
      "title": "Примени высоту всей пирамиды",
      "prompt": "Каков коэффициент при √3 в объёме?",
      "explanation": "V = (169√3/4) · 12/3 = 169√3 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В объёме пирамиды используется высота TO, а площадь уже содержит высоту плоского треугольника."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи коэффициент в объёме.",
        "accepted": [
          "169"
        ],
        "feedback": "Значение 12/3 равно 4 и сокращает знаменатель площади."
      }
    },
    {
      "id": "step-4",
      "title": "Измени оба размера",
      "prompt": "При стороне 6 см и высоте 9 см чему равен коэффициент при √3 в объёме?",
      "explanation": "Площадь 9√3, а высота, делённая на 3, равна 3. Получаем 27√3 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула для равностороннего основания сохраняется при любом размере."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "27"
        ],
        "feedback": "Сначала раздели 6² на 4, затем умножь на 9/3."
      }
    }
