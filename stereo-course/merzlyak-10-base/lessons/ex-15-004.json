  "steps": [
    {
      "title": "Запиши равенство",
      "prompt": "Запиши равенство. Объясни свой выбор.",
      "explanation": "24=S cos30°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о площади ортогональной проекции: S₁=S·cosφ, где φ — угол между плоскостями."
        }
      ],
      "view": "projection",
      "id": "step-1"
    },
    {
      "title": "Вырази S",
      "prompt": "Вырази S. Объясни свой выбор.",
      "explanation": "cos30°=√3/2, поэтому S=24/(√3/2)=48/√3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Решение уравнения относительно S."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Упрости ответ",
