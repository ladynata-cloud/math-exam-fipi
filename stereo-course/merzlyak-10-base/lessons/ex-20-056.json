  "steps": [
    {
      "title": "Определи основание",
      "prompt": "Как обосновать шаг «определи основание»?",
      "explanation": "Пусть MA=MB=MC=l. Каждый из треугольников AMB,BMC,CMA прямоугольный равнобедренный, поэтому AB=BC=CA=l√2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Найди проекцию и высоту",
      "prompt": "Как обосновать шаг «найди проекцию и высоту»?",
      "explanation": "Проекция O точки M — центр описанной окружности равностороннего ABC. R=OA=l√2/√3. Тогда MO²=l²−R²=l²/3, MO=l/√3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные наклонные имеют равные проекции; Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "height",
      "id": "step-2"
    },
    {
      "title": "Вычисли угол",
      "prompt": "Как обосновать шаг «вычисли угол»?",
      "explanation": "Для каждой наклонной sinθ=MO/l=1/√3. Ответ θ=arcsin(1/√3).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Синус угла прямой с плоскостью."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    }
