          "theoryId": "theory-070"
        }
      ],
      "view": "side"
    },
    {
      "id": "step-2",
      "title": "Целая диагональ",
      "prompt": "Запиши коэффициенты D₁B, двигаясь D₁ → D → A → B.",
      "input": {
        "prompt": "Целая диагональ",
        "accepted": [
          "-1;1;-1"
