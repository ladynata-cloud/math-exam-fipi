  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Сравни треугольники с общей стороной AA₁ и проведи медианы к BC."
    }
  ],
  "steps": [
    {
      "title": "Равные треугольники",
      "prompt": "Почему A₁B=A₁C?",
      "explanation": "В треугольниках AA₁B и AA₁C стороны AA₁ общая, AB=AC=a, углы между ними равны 45°. По двум сторонам и углу треугольники равны, значит A₁B=A₁C.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак равенства треугольников."
        }
      ],
      "view": "equal",
      "id": "step-1"
    },
    {
      "title": "Пункт 1",
      "prompt": "Как использовать середину M стороны BC?",
      "explanation": "Так как AB=AC и A₁B=A₁C, медианы AM и A₁M перпендикулярны BC. Эти две пересекающиеся прямые лежат в плоскости AA₁M, поэтому BC⊥(AA₁M), в частности BC⊥AA₁ по направлению.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Медиана равнобедренного треугольника и признак перпендикулярности прямой плоскости."
        }
      ],
      "view": "perpendicular",
      "id": "step-2"
    },
    {
      "title": "Две боковые грани",
      "prompt": "Каковы их площади?",
      "explanation": "Грани при AB и AC — параллелограммы со сторонами a,a и углом 45°. Площадь каждой a²sin45°=a²√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь параллелограмма."
        }
      ],
      "view": "equal",
      "id": "step-3"
    },
    {
      "title": "Пункт 2",
      "prompt": "Какова площадь третьей грани?",
      "explanation": "BB₁∥AA₁, поэтому BB₁⊥BC. Третья грань — квадрат со стороной a и площадью a². Общая площадь Sбок=a²√2+a²=a²(1+√2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Параллельность боковых рёбер и сумма площадей."
        }
      ],
      "view": "face",
      "id": "step-4"
    }
  ],
