  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Сначала вырази диагональ через известное ребро и cosβ."
    }
  ],
  "steps": [
    {
      "title": "Диагональ и высота",
      "prompt": "Что дают углы β и α?",
      "explanation": "Если длина диагонали d, то cosβ=a/d, значит d=a/cosβ. Высота h=d sinα=a sinα/cosβ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ортогональная проекция диагонали на ребро и угол с основанием."
        }
      ],
      "view": "edgeangle",
      "id": "step-1"
    },
    {
      "title": "Вторая сторона",
      "prompt": "Как найти b?",
      "explanation": "b²=d²−a²−h²=d²(sin²β−sin²α). Значит b=a√(sin²β−sin²α)/cosβ. Положительность b требует 0<α<β<90°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула диагонали и положительность измерений."
        }
      ],
      "view": "baseangle",
      "id": "step-2"
    },
    {
      "title": "Поверхность",
      "prompt": "Как подставить в 2(a+b)h?",
      "explanation": "Sбок=2a²sinα[cosβ+√(sin²β−sin²α)]/cos²β.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр основания и боковая поверхность прямой призмы."
        }
      ],
      "view": "edges",
      "id": "step-3"
    }
  ],
