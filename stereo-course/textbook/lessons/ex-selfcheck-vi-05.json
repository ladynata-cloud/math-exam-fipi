  "help": [
    {
      "id": "h1",
      "question": "Что вычесть, чтобы получить b?",
      "text": "Для a≠0 запиши a+b=t·a и вычти a. Если a=0, нулевой вектор коллинеарен любому.",
      "view": "reason"
    },
    {
      "id": "h2",
      "question": "Как меняется коэффициент?",
      "text": "Коэффициент b по a всегда на единицу меньше коэффициента суммы.",
      "view": "transfer"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Конкретный множитель",
      "prompt": "Пусть a+b=−2a. Чему равен t в b=t·a?",
      "explanation": "b=−2a−a=−3a.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равенство векторов допускает вычитание одного слагаемого.",
          "theoryId": "theory-065"
        }
      ],
      "view": "reason",
      "input": {
        "prompt": "Конкретный множитель",
        "accepted": [
          "-3"
        ],
        "feedback": "Из −2 вычти единицу."
      }
    },
    {
      "id": "step-2",
      "title": "Общий вывод",
      "prompt": "Может ли при таком условии b иметь ненулевую составляющую поперёк ненулевого a?",
      "explanation": "Поперечная составляющая сохранилась бы в a+b, вопреки коллинеарности.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Линейная комбинация векторов одного направления остаётся на той же прямой.",
          "theoryId": "theory-065"
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Общий вывод",
        "accepted": [
          "нет"
        ],
        "feedback": "Вычитание самого a не может создать поперечную составляющую."
      }
    },
    {
      "id": "step-3",
      "title": "Новые данные",
      "prompt": "В другом примере a+b=3a. Каков коэффициент b по a?",
      "explanation": "b=2a.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Разность 3a−a равна 2a.",
          "theoryId": "theory-065"
        }
      ],
      "view": "transfer",
      "input": {
        "prompt": "Новые данные",
        "accepted": [
          "2"
        ],
        "feedback": "Отнимай единичный коэффициент a."
      }
    }
  ],
