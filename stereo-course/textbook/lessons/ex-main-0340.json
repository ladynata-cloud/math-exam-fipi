  "steps": [
    {
      "title": "Приведи размеры к одной единице",
      "prompt": "Как записать диаметр в метрах?",
      "explanation": "Диаметр D = 20 см = 0,2 м, длина трубы h = 4 м. Для трубы учитываем боковую поверхность: круглые торцевые крышки не требуются.",
      "view": "diameter",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В одном метре 100 сантиметров."
