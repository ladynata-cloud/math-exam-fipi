  "steps": [
    {
      "id": "step-1",
      "title": "Сравни радиусы",
      "prompt": "Куда проецируется центр X сферы?",
      "explanation": "Если H — проекция X, то для любой вершины основания A верно HA² = XA²−XH². Значит, H равноудалена от вершин и совпадает с O. Если X уже лежит в основании, то X = O по той же причине.",
      "view": "projection",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Неперпендикулярные радиусы и их проекции образуют прямоугольные треугольники."
        }
      ]
    },
    {
      "id": "step-2",
