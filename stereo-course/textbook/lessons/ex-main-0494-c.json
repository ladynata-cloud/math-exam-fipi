  "help": [
    {
      "id": "h1",
      "question": "Почему появится квадратный корень?",
      "text": "В формуле объёма неизвестный радиус входит в квадрате. Геометрическая длина положительна.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "В каком порядке выполнить действия?",
      "text": "Умножь p на три, раздели на πm, после этого извлеки корень.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Вырази квадрат радиуса",
      "prompt": "Для проверки возьми m = 3 и p = 16π. Каков r²?",
      "explanation": "Из V = πr²m/3 следует r² = 3p/(πm). В числовом примере получается 16.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус определяет площадь основания через πr²."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи квадрат радиуса модели.",
        "accepted": [
          "16"
        ],
        "feedback": "Квадрат равен 3 · 16π / (3π), а не самому объёму с множителем π."
      }
    },
    {
      "id": "step-2",
      "title": "Выбери геометрическую длину",
      "prompt": "Чему равен радиус в примере?",
      "explanation": "r = √16 = 4. В общем виде r = √(3p/(πm)).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус — положительная длина, поэтому выбираем положительный квадратный корень."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи радиус модели.",
        "accepted": [
          "4"
        ],
        "feedback": "Полученные 16 — это r²; извлеки корень."
      }
    },
    {
      "id": "step-3",
      "title": "Проверь обратной подстановкой",
      "prompt": "Какой коэффициент при π вернётся в объёме?",
      "explanation": "Подставив r = 4 и m = 3, получим π · 16 · 3/3 = 16π. Для общего корня квадрат равен 3p/(πm), и получается p.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Обратная подстановка должна восстановить именно данную величину.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи проверочный коэффициент.",
        "accepted": [
          "16"
        ],
        "feedback": "В подстановке нужно возвести найденный радиус в квадрат."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другие данные",
      "prompt": "Теперь m = 6 и p = 18π. Каков радиус?",
      "explanation": "r² = 54π/(6π) = 9, значит r = 3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При решении обратной задачи уменьшается число неизвестных, но формула объёма та же."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи новый радиус.",
        "accepted": [
          "3"
        ],
        "feedback": "В конце извлеки положительный корень из 9."
      }
    }
  ],
