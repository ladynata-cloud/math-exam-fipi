  "help": [
    {
      "id": "h1",
      "question": "Как сравнить C и B₁?",
      "text": "Вектор от заряда в S равен kq·SP/|SP|³ в точке P. Для C и B₁ два заряда находятся на расстоянии a и один на a√3. Перестановка осей сохраняет длину суммы. Если q=0, поля всюду нулевые.",
      "view": "atB1"
    },
    {
      "id": "h2",
      "question": "Куда смотрят вклады в F?",
      "text": "От B и D точки F одинаково далеки. Их горизонтальные части противоположны, а вертикальные складываются. Поле от A₁ лежит в верхней грани.",
      "view": "atF"
    },
    {
      "id": "h3",
      "question": "Как посчитать сумму в O?",
      "text": "В единицах ребра положи O=(½,½,½), A₁=(0,0,1), B=(1,0,0), D=(0,1,0). Для трёх вкладов знаменатели одинаковы.",
      "view": "atO"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Точка C",
      "prompt": "Положи t=1/(3√3). При q>0 компоненты поля в C равны (1+t,1+t,−t) в единицах U. Какой модуль? Введи, например, корень через sqrt(...).",
      "input": {
        "prompt": "Точка C",
        "accepted": [
          "sqrt(19+4*sqrt(3))/3"
        ],
        "feedback": "Сложи квадраты, а не модули трёх вкладов. Получается 2+4t+3t²."
      },
      "explanation": "После подстановки t²=1/27 имеем |E(C)|²/U²=(19+4√3)/9.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Модуль вектора равен корню из суммы квадратов его перпендикулярных компонент.",
          "theoryId": "theory-065"
        }
      ],
      "view": "atC"
    },
    {
      "id": "step-2",
      "title": "Точка B₁",
      "prompt": "В B₁ компоненты равны (1+t,−t,1+t). Найди отношение |E(B₁)|/|E(C)|.",
      "input": {
        "prompt": "Точка B₁",
        "accepted": [
          "1"
        ],
        "feedback": "Изменился только порядок компонент. Сравни обе суммы квадратов."
      },
      "explanation": "Следовательно, |E(B₁)|=U√(19+4√3)/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина сохраняется при перестановке осей.",
          "theoryId": "theory-065"
        }
      ],
      "view": "atB1"
    },
    {
      "id": "step-3",
      "title": "Центр грани F",
      "prompt": "Для F горизонтальная часть имеет длину 2U от A₁, а вертикальная от B и D вместе равна (4√6/9)U. Найди |E(F)|/U.",
      "input": {
        "prompt": "Центр грани F",
        "accepted": [
          "2*sqrt(105)/9",
          "sqrt(140/27)"
        ],
        "feedback": "Складывай квадраты перпендикулярных частей: 2²+(4√6/9)²."
      },
      "explanation": "Расстояние до A₁ равно a/√2. Для B и D квадрат расстояния равен 3a²/2. Их горизонтальные части гасятся; наклонные вертикальные части складываются. |E(F)|²/U²=140/27.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Разложение на горизонтальную плоскость и перпендикуляр.",
          "theoryId": "theory-065"
        }
      ],
      "view": "atF"
    },
    {
      "id": "step-4",
      "title": "Центр куба O",
      "prompt": "Векторы A₁O+BO+DO в сумме равны AO. Длина AO=a√3/2; это также расстояние от каждого заряда. Найди |E(O)|/U.",
      "input": {
        "prompt": "Центр куба O",
        "accepted": [
          "4/3"
        ],
        "feedback": "Сначала сложи векторы с общим знаменателем. После взятия модуля остаётся a²/|AO|²."
      },
      "explanation": "Длина суммы равна k|q|/|AO|²=4U/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные расстояния позволяют вынести один скалярный коэффициент.",
          "theoryId": "theory-065"
        }
      ],
      "view": "atO"
    },
    {
