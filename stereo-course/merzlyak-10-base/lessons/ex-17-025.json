  "steps": [
    {
      "title": "Треугольник основания",
      "prompt": "Почему CD перпендикулярен BD?",
      "explanation": "BD²=8²+4²−2·8·4 cos60°=48. Тогда BD²+CD²=48+16=64=BC², поэтому ∠BDC=90°. Расстояние C до BD равно CD=4 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема косинусов и обратная теорема Пифагора."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота",
      "prompt": "Как использовать угол плоскостей?",
      "explanation": "CD⊥BD и CC₁⊥основанию, поэтому C₁D⊥BD. Угол CDC₁=30° — линейный угол плоскостей. Значит h=CC₁=CD tan30°=4/√3 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах и тангенс."
        }
      ],
      "view": "angle",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Каков периметр основания?",
      "explanation": "P=2(8+4)=24 см. Поэтому Sбок=Ph=24·4/√3=32√3 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь боковой поверхности прямой призмы."
        }
      ],
      "view": "section",
      "id": "step-3"
    }
