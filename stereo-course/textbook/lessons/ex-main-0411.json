  "help": [
    {
      "id": "h1",
      "question": "На какие части удобно разделить трапецию?",
      "text": "Опусти высоты из концов меньшего основания. В центре будет прямоугольник, по краям — равные прямоугольные треугольники.",
      "view": "height",
      "theoryIds": []
    },
    {
      "id": "h2",
      "question": "Какие поверхности остаются снаружи?",
      "text": "Боковая поверхность цилиндра и две боковые поверхности конусов. Два общих круга скрыты внутри тела.",
      "view": "cones",
      "theoryIds": [
        "theory-039",
        "theory-041"
      ]
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди проекции боковых сторон",
      "prompt": "Как разделить разность оснований?",
      "explanation": "Обозначим AB = 10 см, DC = 6 см. Опустим DH и CK на AB. Так как трапеция равнобедренная, AH = KB = (10 − 6)/2 = 2 см.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проекции боковых сторон равнобедренной трапеции на большее основание равны."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди радиус и образующую",
      "prompt": "Что даёт прямоугольный треугольник AHD?",
      "explanation": "∠DAH = 60°. Радиус вращения r = DH = 2 tan 60° = 2√3 см. Боковая сторона AD = AH/cos 60° = 4 см; BC тоже равна 4 см.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определения тангенса и косинуса острого угла прямоугольного треугольника."
        }
      ]
    },
    {
      "id": "step-3",
