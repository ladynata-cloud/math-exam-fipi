  "help": [
    {
      "id": "help-1",
      "question": "Как начать?",
      "text": "Предположи общую точку и примени единственность параллельной плоскости."
    }
  ],
  "steps": [
    {
      "title": "Предположение от противного",
      "prompt": "Что означало бы пересечение α и γ?",
      "explanation": "Предположим, что различные α и γ имеют общую точку X. Так как α∥β, точка X не лежит в β. Обозначение X в рассуждении относится к предполагаемому пересечению, которого в модели нет.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение параллельных плоскостей."
        }
      ],
      "view": "alpha",
      "id": "step-1"
    },
    {
      "title": "Единственность",
      "prompt": "Сколько плоскостей через X параллельно β?",
      "explanation": "Через точку X вне β проходит единственная плоскость, параллельная β. Но и α, и γ проходили бы через X и были бы параллельны β. Значит, α=γ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о единственности параллельной плоскости через внешнюю точку."
        }
      ],
      "view": "beta",
      "id": "step-2"
    },
    {
      "title": "Противоречие",
      "prompt": "Почему α и γ не могут иметь общую точку?",
      "explanation": "Условие требует α≠γ, поэтому получено противоречие. Общих точек нет, следовательно, α∥γ.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение параллельных плоскостей."
        }
      ],
      "view": "gamma",
      "id": "step-3"
    }
  ],
