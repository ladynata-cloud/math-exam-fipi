      "title": "Расстояние AO",
      "prompt": "Чему равна половина диагонали?",
      "explanation": "Диагональ квадрата 8√2, поэтому AO=4√2 см. Боковое ребро AA₁=6 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Диагональ квадрата и её середина."
        }
      ],
      "view": "base",
