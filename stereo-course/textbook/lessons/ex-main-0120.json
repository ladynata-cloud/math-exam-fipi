  "steps": [
    {
      "title": "Найди расстояние от центра до вершины",
      "prompt": "Чему равна половина диагонали квадрата?",
      "explanation": "Диагональ квадрата равна a√2. Диагонали равны и делятся точкой O пополам, поэтому OA=OB=OC=OD=a√2/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора для квадрата; свойства его диагоналей."
        }
      ],
      "view": "triangle",
      "id": "step-1"
    },
    {
      "title": "Используй прямоугольный треугольник",
      "prompt": "Почему угол KOA прямой?",
      "explanation": "OK перпендикулярен плоскости квадрата, значит OK⊥OA. По теореме Пифагора KA²=OK²+OA²=b²+a²/2, поэтому KA=√(b²+a²/2).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Перпендикулярность прямой и плоскости.",
          "theoryId": "theory-016",
          "source": {
            "bookId": "atanasyan-2024-10-11",
