  "steps": [
    {
      "title": "Нижняя общая точка",
      "prompt": "Каковы следы заданных плоскостей в основании?",
      "explanation": "ACC₁ пересекает основание по AC, а BED — по BD. Обозначим O=AC∩BD; это первая общая точка плоскостей.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Общие точки следов принадлежат обеим секущим плоскостям."
        }
      ],
      "view": "bottom",
      "id": "step-1"
    },
    {
      "title": "Верхняя общая точка",
      "prompt": "Как найти след BED в верхней грани?",
      "explanation": "Через E проводим прямую, параллельную BD. Она пересекает A₁C₁, верхний след ACC₁, в P. Поэтому P принадлежит обеим заданным плоскостям.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Следы секущей в параллельных гранях параллельны."
        }
      ],
      "view": "top",
      "id": "step-2"
    },
    {
      "title": "Линия пересечения",
      "prompt": "Почему двух точек достаточно?",
      "explanation": "O находится в нижней грани, P — в верхней, значит O≠P. Прямая OP и есть ACC₁∩BED.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две различные общие точки определяют линию пересечения разных плоскостей."
        }
      ],
