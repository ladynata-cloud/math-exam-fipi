  "steps": [
    {
      "id": "step-1",
      "title": "Вырази площадь осевого сечения",
      "prompt": "Какие размеры имеет осевой прямоугольник?",
      "explanation": "Его ширина равна 2r, высота — h. Поэтому S = 2rh. Это связь размеров цилиндра с известной площадью.",
      "view": "axial",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевое сечение цилиндра — прямоугольник со сторонами 2r и h.",
          "theoryId": "theory-038",
