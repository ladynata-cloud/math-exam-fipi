  "steps": [
    {
      "title": "Высота трапеции",
      "prompt": "Как использовать равные боковые стороны?",
      "explanation": "AH=(21−11)/2=5 см. В прямоугольном ABH получаем BH=√(13²−5²)=12 см. Горизонтальная проекция диагонали AC равна (21+11)/2=16 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высоты равнобедренной трапеции и теорема Пифагора."
        }
      ],
      "view": "base",
      "id": "step-1"
    },
    {
      "title": "Высота призмы",
      "prompt": "Какова диагональ основания?",
      "explanation": "AC=√(16²+12²)=20 см. Диагональное сечение — прямоугольник AC·h=180, поэтому h=9 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора и площадь прямоугольника."
        }
      ],
      "view": "diagonal",
      "id": "step-2"
    },
    {
      "title": "Пункт 1",
      "prompt": "Каков периметр основания?",
      "explanation": "P=11+21+13+13=58 см, Sбок=Ph=58·9=522 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Боковая поверхность прямой призмы."
        }
      ],
      "view": "diagonal",
      "id": "step-3"
    },
    {
      "title": "Пункт 2",
      "prompt": "Какова высота трапеции AB₁C₁D?",
      "explanation": "Её основания AD=21 и B₁C₁=11. Отрезок HB₁ перпендикулярен AD, его длина √(BH²+BB₁²)=√(144+81)=15 см. Поэтому Sсеч=(21+11)·15/2=240 см². Ответ:1)522 см²;2)240 см².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах, Пифагор и площадь трапеции."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
