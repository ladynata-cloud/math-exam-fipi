  "help": [
    {
      "id": "h1",
      "question": "Какая сторона такого треугольника является диаметром окружности?",
      "text": "Посмотри на сторону, противолежащую прямому углу.",
      "view": "diam"
    },
    {
      "id": "h2",
      "question": "Как восстановить гипотенузу по прилежащему катету?",
      "text": "Косинус α — отношение прилежащего катета AB к BC.",
      "view": "base"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Определи гипотенузу",
      "prompt": "Как связаны BC и AB?",
      "explanation": "Из cos α = AB/BC получаем BC = a/cos α. Гипотенуза BC стягивает прямой вписанный угол A и поэтому является диаметром.",
      "view": "diam",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Центр окружности, описанной около прямоугольного треугольника, — середина гипотенузы."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Найди радиус круга",
      "prompt": "Где появляется множитель 2?",
      "explanation": "r = BC/2 = a/(2cos α). После возведения в квадрат r² = a²/(4cos²α).",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Радиус равен половине диаметра."
        }
      ]
    },
    {
