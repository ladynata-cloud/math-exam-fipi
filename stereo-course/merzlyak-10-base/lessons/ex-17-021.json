  "help": [
    {
      "id": "help-1",
      "question": "С чего начать?",
      "text": "Синус угла диагонали с гранью выделяет измерение, перпендикулярное этой грани."
    }
  ],
  "steps": [
    {
      "title": "Два измерения",
      "prompt": "Как использовать синусы углов с плоскостями?",
      "explanation": "Обозначим высоту h, стороны основания x,y, причём y перпендикулярна выбранной боковой грани. Тогда h=d sinα, y=d sinβ: каждый перпендикулярный катет равен диагонали, умноженной на синус её угла с плоскостью.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Угол прямой с плоскостью и синус."
        }
      ],
      "view": "faceangle",
      "id": "step-1"
    },
    {
      "title": "Третье измерение",
      "prompt": "Как найти x?",
      "explanation": "d²=x²+y²+h², поэтому x=d√(1−sin²α−sin²β)=d√(cos²β−sin²α). Для существования невырожденного параллелепипеда подкоренное выражение положительно.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула диагонали прямоугольного параллелепипеда."
        }
      ],
      "view": "baseangle",
      "id": "step-2"
    },
    {
      "title": "Площадь",
      "prompt": "Как выразить 2(x+y)h?",
      "explanation": "Sбок=2d²sinα[sinβ+√(cos²β−sin²α)]. Все углы берутся острыми; условие существования учитывается вместе с формулой.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Периметр прямоугольного основания и боковая поверхность."
        }
      ],
      "view": "edges",
      "id": "step-3"
    }
  ],
