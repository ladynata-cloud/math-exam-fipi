  "help": [
    {
      "id": "help-1",
      "question": "Подсказка к первому шагу",
      "text": "BH=√(25²−7²)=24 см. S(ABC)=14·24/2=168 см²."
    }
  ],
  "steps": [
    {
      "title": "Высота и площадь основания",
      "prompt": "Высота и площадь основания — выполните этот шаг самостоятельно.",
      "explanation": "BH=√(25²−7²)=24 см. S(ABC)=14·24/2=168 см².",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Радиус окружности",
      "prompt": "Радиус окружности — выполните этот шаг самостоятельно.",
      "explanation": "Полупериметр p=(25+25+14)/2=32. Радиус r=S/p=168/32=21/4.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Высота малого треугольника",
      "prompt": "Высота малого треугольника — выполните этот шаг самостоятельно.",
      "explanation": "Касательные AC и MK расположены по разные стороны окружности, расстояние между ними 2r=21/2. Поэтому BT=24−21/2=27/2.",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    },
    {
      "title": "Подобие и площадь",
      "prompt": "Подобие и площадь — выполните этот шаг самостоятельно.",
      "explanation": "MBK ∼ ABC, коэффициент BT/BH=(27/2)/24=9/16. S(MBK)=168·(9/16)²=1701/32 см².",
      "view": "section",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
