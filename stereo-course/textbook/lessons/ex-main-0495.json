  "help": [
    {
      "id": "h1",
      "question": "Откуда откладываются 2 см?",
      "text": "Расстояние дано от вершины. Оно равно высоте малого конуса TK. Полная высота TO равна 5 см.",
      "view": "small"
    },
    {
      "id": "h2",
      "question": "В какой степени берут отношение высот?",
      "text": "Параллельный срез даёт подобные конусы. Отношение площадей квадратичное, а объёмов кубическое.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Сравни высоты",
      "prompt": "Какую долю полной высоты составляет TK?",
      "explanation": "k = 2/5. На столько же уменьшились радиус основания и образующая малого конуса.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плоскость сечения параллельна основанию, поэтому осевые треугольники подобны."
        }
      ],
      "view": "small",
      "input": {
        "prompt": "Введи линейную долю малого конуса.",
        "accepted": [
          "2/5"
        ],
        "feedback": "Отсчитывай 2 см от вершины, а не оставшиеся 3 см снизу."
      }
    },
    {
      "id": "step-2",
      "title": "Перейди к объёмам",
      "prompt": "Какую долю исходного объёма составляет малый конус?",
      "explanation": "Vмал/V = (2/5)³ = 8/125.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В произведении r²h при подобии масштаб входит три раза."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Введи долю объёма малого конуса.",
        "accepted": [
          "8/125"
        ],
        "feedback": "Доля 4/25 относится к площади, а в объёме есть ещё множитель высоты."
      }
    },
    {
      "id": "step-3",
      "title": "Восстанови большой конус",
      "prompt": "Каков исходный объём в см³?",
      "explanation": "Если 8/125 полного объёма составляют 24 см³, то V = 24 · 125/8 = 375 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Чтобы по доле найти целое, данную часть делят на эту долю.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи полный объём.",
        "accepted": [
          "375"
        ],
        "feedback": "Данный объём относится к меньшему конусу; исходное тело должно быть больше."
      }
    },
    {
      "id": "step-4",
      "title": "Измени положение среза",
      "prompt": "У другой пары высота от вершины до сечения равна трети полной, а малый объём равен 10. Найди полный объём.",
      "explanation": "Отношение объёмов равно 1/27, поэтому полное тело занимает 270.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Куб отношения высот применим к любому параллельному сечению конуса."
        }
      ],
      "view": "small",
      "input": {
        "prompt": "Введи новый полный объём.",
        "accepted": [
