  "help": [
    {
      "id": "h1",
      "question": "Как получить сумму и разность радиусов?",
      "text": "Формула боковой поверхности S = π(R+r)l даёт сумму. Прямоугольный треугольник с гипотенузой l даёт разность.",
      "view": "height"
    },
    {
      "id": "h2",
      "question": "Каковы основания осевой трапеции?",
      "text": "Это диаметры 2R и 2r. Их полусумма равна R+r.",
      "view": "neutral"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди сумму радиусов",
      "prompt": "В модели h = 4, l = 5 и S = 45π. Чему равно R+r?",
      "explanation": "Обозначим u = R+r = S/(πl). В примере u = 45π/(5π) = 9.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь боковой поверхности усечённого конуса равна π(R+r)l."
        }
      ],
      "view": "bases",
      "input": {
        "prompt": "Введи сумму радиусов модели.",
        "accepted": [
          "9"
        ],
        "feedback": "S — уже боковая площадь. Раздели её на πl без прибавления площадей дисков."
      }
    },
    {
      "id": "step-2",
      "title": "Найди разность радиусов",
      "prompt": "Какова величина R−r в этом же примере?",
      "explanation": "Обозначим d = R−r. По треугольнику AKC d² = l²−h². В модели d = √(25−16) = 3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Проекция наклонной образующей на плоскость основания равна разности радиусов."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи разность радиусов.",
        "accepted": [
          "3"
        ],
        "feedback": "Вычти квадрат вертикальной высоты из квадрата образующей."
      }
    },
    {
      "id": "step-3",
      "title": "Проверь первый результат",
      "prompt": "Какова площадь осевого сечения в модели?",
      "explanation": "Площадь равна (2R+2r)h/2 = uh = Sh/(πl). При u = 9 и h = 4 это 36.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевой плоскостью усечённый конус пересекается по равнобедренной трапеции высотой h.",
          "theoryId": "theory-059"
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Введи площадь осевого сечения.",
        "accepted": [
          "36"
        ],
        "feedback": "Здесь нужны диаметры трапеции. Их полусумма равна уже найденной сумме радиусов."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь второй результат",
      "prompt": "Какой коэффициент при π получается в объёме?",
      "explanation": "R²+Rr+r² = (3u²+d²)/4. Поэтому V = (πh/12)(l²−h²+3S²/(π²l²)). В модели V = (4π/12)(243+9) = 84π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Из u² = R²+2Rr+r² и d² = R²−2Rr+r² получается 3u²+d² = 4(R²+Rr+r²)."
        }
      ],
      "view": "bases",
      "input": {
        "prompt": "Введи коэффициент объёма модели.",
        "accepted": [
          "84"
        ],
        "feedback": "В числителе стоит 3 · 9² + 3². Умножь это на 4/12."
      }
    },
    {
      "id": "step-5",
      "title": "Проверь новую площадь",
      "prompt": "Теперь h = 12, l = 13, S = 169π. Какова площадь осевого сечения?",
      "explanation": "Сумма радиусов 13, а разность 5. Площадь сечения равна 13 · 12 = 156.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В площади осевой трапеции важна сумма радиусов."
        }
      ],
      "view": "neutral",
      "input": {
        "prompt": "Введи новую площадь.",
        "accepted": [
          "156"
        ],
        "feedback": "У новой фигуры сумма радиусов 169/13 = 13."
      }
    },
    {
      "id": "step-6",
      "title": "Проверь новый объём",
      "prompt": "Для тех же новых данных чему равен коэффициент при π в объёме?",
      "explanation": "R = (13+5)/2 = 9 и r = (13−5)/2 = 4. Объём равен π · 12(81+36+16)/3 = 532π.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сумма и разность положительных радиусов вместе определяют оба радиуса."
        }
      ],
      "view": "height",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "532"
        ],
        "feedback": "Подставь радиусы 9 и 4 и вертикальную высоту 12."
      }
    }
  ],
