  "help": [
    {
      "id": "h1",
      "question": "Какие произведения дают площади?",
      "text": "Обозначь выходящие из A рёбра через a, b и c. Три площади имеют вид ab, bc, ca.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Сколько раз повторяется каждое ребро?",
      "text": "В произведении трёх площадей множители a, b и c встречаются по два раза.",
      "view": "side"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Свяжи площади с объёмом",
      "prompt": "Какую степень имеет каждое ребро в S₁S₂S₃?",
      "explanation": "(ab)(bc)(ca) = a²b²c² = V². Каждое ребро встречается дважды.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Две из трёх смежных граней содержат каждое ребро."
        }
      ],
      "view": "side",
      "input": {
        "prompt": "Показатель степени",
        "accepted": [
          "2"
        ],
        "feedback": "Посмотри, в каких двух гранях присутствует выбранное ребро."
      }
    },
    {
      "id": "step-2",
      "title": "Численный квадрат",
      "prompt": "Чему равно V² для указанных площадей?",
      "explanation": "6·12·18 = 1296 дм⁶. Чтобы вернуться к объёму, нужно извлечь квадратный корень.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём прямоугольного параллелепипеда равен abc."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Число дм⁶",
        "accepted": [
          "1296"
        ],
        "feedback": "Перемножь все три площади без сложения и деления на три."
      }
    },
    {
      "id": "step-3",
      "title": "Положительный объём",
      "prompt": "Чему равен объём в дм³?",
      "explanation": "√1296 = 36. Общая формула V = √(S₁S₂S₃).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Невырожденное тело имеет положительные размеры и объём.",
          "theoryId": "theory-053"
        }
      ],
      "view": "side",
      "input": {
        "prompt": "Объём в дм³",
        "accepted": [
          "36"
        ],
        "feedback": "После извлечения корня из дм⁶ получается дм³."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь новые грани",
      "prompt": "При площадях 6, 10 и 15 каков объём?",
      "explanation": "√(6·10·15) = √900 = 30 кубических единиц.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Связь V² с тремя площадями сохраняется для любых положительных рёбер."
        }
      ],
      "view": "base",
      "input": {
        "prompt": "Новый объём",
        "accepted": [
          "30"
        ],
        "feedback": "Измени все три площади, затем снова извлеки квадратный корень."
      }
    }
