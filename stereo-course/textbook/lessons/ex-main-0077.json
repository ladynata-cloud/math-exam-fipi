  "steps": [
    {
      "id": "step-1",
      "title": "Выделим три группы",
      "prompt": "Сколько рёбер каждой длины?",
      "explanation": "По свойствам граней AB=CD=A₁B₁=C₁D₁=a; BC=AD=B₁C₁=A₁D₁=b; AA₁=BB₁=CC₁=DD₁=c. Всего четыре ребра каждой длины, поэтому 4(a+b+c)=120, или a+b+c=30.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Грани параллелепипеда — параллелограммы, противоположные стороны которых равны.",
          "theoryId": "theory-013",
          "source": {
            "bookId": "atanasyan-2024-10-11",
            "collection": "theory",
            "point": "13",
            "chapter": "I. Параллельность прямых и плоскостей",
