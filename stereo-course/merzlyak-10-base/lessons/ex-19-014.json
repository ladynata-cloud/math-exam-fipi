  "help": [
    {
      "id": "help-1",
      "question": "Подсказка к первому шагу",
      "text": "В равнобокой трапеции горизонтальный отрезок от нижнего угла до основания высоты равен q=(a−b)/2. Поэтому апофема l=q·tanα."
    }
  ],
  "steps": [
    {
      "title": "Высота боковой трапеции",
      "prompt": "Высота боковой трапеции — выполните этот шаг самостоятельно.",
      "explanation": "В равнобокой трапеции горизонтальный отрезок от нижнего угла до основания высоты равен q=(a−b)/2. Поэтому апофема l=q·tanα.",
      "view": "angle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-1"
    },
    {
      "title": "Проекция апофемы",
      "prompt": "Проекция апофемы — выполните этот шаг самостоятельно.",
      "explanation": "Проекция апофемы на плоскость основания тоже равна q. Значит H²=l²−q²=q²(tan²α−1).",
      "view": "apothem",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-2"
    },
    {
      "title": "Ответ и допустимость",
      "prompt": "Ответ и допустимость — выполните этот шаг самостоятельно.",
      "explanation": "H=(a−b)√(tan²α−1)/2=(a−b)√(−cos2α)/(2cosα). Положительная высота требует 45°<α<90°.",
      "view": "apothem",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Используем данное условие и свойства указанной фигуры."
        }
      ],
      "id": "step-3"
    }
