  "steps": [
    {
      "title": "Возьми любую сторону",
      "prompt": "Как обосновать шаг «возьми любую сторону»?",
      "explanation": "Обозначим центр O, радиус r, точку касания со стороной — T. Тогда OT=r и OT перпендикулярен прямой стороны. Точка T принадлежит самой стороне.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Свойство вписанной окружности."
        }
      ],
      "view": "side1",
      "id": "step-1"
    },
    {
      "title": "Подними перпендикуляр",
      "prompt": "Как обосновать шаг «подними перпендикуляр»?",
      "explanation": "MO перпендикулярен плоскости. По теореме о трёх перпендикулярах MT перпендикулярен прямой стороны, следовательно MT — расстояние до стороны.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема о трёх перпендикулярах: прямая плоскости перпендикулярна наклонной тогда и только тогда, когда перпендикулярна её проекции."
        }
      ],
      "view": "side1",
      "id": "step-2"
    },
    {
      "title": "Сравни длины",
      "prompt": "Как обосновать шаг «сравни длины»?",
      "explanation": "MT²=MO²+OT²=MO²+r². Эта величина одинакова для всех сторон, поэтому все расстояния равны.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
