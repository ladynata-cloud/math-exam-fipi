  "help": [
    {
      "id": "h1",
      "question": "Почему основание высоты равноудалено от вершин?",
      "text": "Для любого бокового ребра длина горизонтальной проекции равна h/tan φ₃. Значит O — центр описанной окружности основания.",
      "view": "inclination"
    },
    {
      "id": "h2",
      "question": "Как восстановить площадь по углам?",
      "text": "Третий угол равен 180°−φ₁−φ₂. В формуле площади можно использовать две стороны, вычисленные по теореме синусов.",
      "view": "circumcircle"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Описанный радиус",
      "prompt": "При h = 2 и φ₃ = 45° найди R.",
      "explanation": "OA = OB = OC = h/tan φ₃ = 2. Центр O может оказаться вне тупоугольного треугольника.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У прямоугольных треугольников с общим катетом SO и равными углами одинаковы вторые катеты."
        }
      ],
      "view": "inclination",
      "input": {
        "prompt": "Радиус основания",
        "accepted": [
          "2"
        ],
        "feedback": "Искомая длина — проекция бокового ребра, а не само наклонное ребро."
      }
    },
    {
      "id": "step-2",
      "title": "Стороны основания",
      "prompt": "Пусть дополнительно φ₁ = φ₂ = 30°. Чему равна сторона напротив каждого такого угла?",
      "explanation": "По теореме синусов a = 2R sin 30° = 2. Третий угол равен 120°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сторона треугольника равна произведению диаметра описанной окружности на синус противолежащего угла."
        }
      ],
      "view": "circumcircle",
      "input": {
        "prompt": "Длина стороны",
        "accepted": [
          "2"
        ],
        "feedback": "В теореме синусов участвует диаметр 2R."
      }
    },
    {
      "id": "step-3",
      "title": "Площадь основания",
      "prompt": "Чему равна площадь треугольника в этой модели?",
      "explanation": "S = (1/2)·2·2·sin 120° = √3. Вообще S = 2R² sin φ₁ sin φ₂ sin(φ₁+φ₂).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Синус внутреннего угла равен синусу дополнительного к нему угла.",
          "theoryId": "theory-058"
        }
      ],
      "view": "circumcircle",
      "input": {
        "prompt": "Площадь",
        "accepted": [
          "sqrt(3)"
        ],
        "feedback": "Обе найденные стороны ограничивают третий угол 120°."
      }
    },
    {
      "id": "step-4",
      "title": "Собери объём",
      "prompt": "Чему равен объём модели?",
      "explanation": "V = 2√3/3. В общем случае V = 2h³ sin φ₁ sin φ₂ sin(φ₁+φ₂)/(3tan²φ₃).",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём определяется площадью основания и перпендикулярной высотой вне зависимости от положения её основания."
        }
      ],
      "view": "inclination",
      "input": {
        "prompt": "Объём",
        "accepted": [
          "2*sqrt(3)/3"
        ],
        "feedback": "Радиус заменяется на h/tan φ₃, площадь умножается на h/3."
      }
    },
    {
      "id": "step-5",
      "title": "Проверь новое основание",
      "prompt": "При тех же h и φ₃, но φ₁ = 30°, φ₂ = 60°, какой получится объём?",
      "explanation": "Третий угол прямой. Гипотенуза равна диаметру 4, катеты 2 и 2√3. Площадь 2√3, объём 4√3/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У прямоугольного треугольника центр описанной окружности лежит на середине гипотенузы."
        }
      ],
      "view": "circumcircle",
      "input": {
        "prompt": "Новый объём",
        "accepted": [
          "4*sqrt(3)/3"
        ],
        "feedback": "Площадь треугольника надо пересчитать для новых углов."
      }
    }
  ],
  "answer": {
