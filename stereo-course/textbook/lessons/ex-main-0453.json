  "help": [
    {
      "id": "h1",
      "question": "Что делает высота из вершины равнобедренного треугольника?",
      "text": "Она делит угол φ пополам.",
      "view": "triangle"
    },
    {
      "id": "h2",
      "question": "Какое значение надо подставить вместо высоты призмы?",
      "text": "По условию BB₁ = BD.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Найди BD",
      "prompt": "Как BD расположена относительно угла φ/2?",
      "explanation": "В треугольнике BDC гипотенуза равна m, угол CBD равен φ/2. Следовательно, BD = m cos(φ/2).",
      "view": "triangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В равнобедренном треугольнике высота из вершины также является биссектрисой."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Вычисли площадь основания",
      "prompt": "Как получить площадь непосредственно из m и φ?",
      "explanation": "Стороны AB и BC образуют угол φ, поэтому S = (m²·sin φ)/2.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь треугольника равна половине произведения двух сторон на синус угла между ними."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Подставь высоту призмы",
      "prompt": "Что получится при умножении S на BD?",
      "explanation": "V = m³·sin φ·cos(φ/2)/2. Половинный угол нужен в косинусе, а полный угол — в синусе площади основания.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота прямой призмы равна её боковому ребру."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь способ на новом примере",
      "prompt": "Если m = 2, φ = 120°, чему равна длина BD?",
      "explanation": "Получаем BD = 2 cos 60° = 1.",
      "view": "triangle",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Высота при вершине делит угол 120° на два угла по 60°."
        }
      ],
      "input": {
        "prompt": "Введи длину BD.",
        "accepted": [
          "1"
        ],
        "feedback": "Высота при вершине делит угол 120° на два угла по 60°."
      }
    }
