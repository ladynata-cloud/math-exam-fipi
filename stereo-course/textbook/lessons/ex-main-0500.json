  "help": [
    {
      "id": "h1",
      "question": "О чём говорит угол 60°?",
      "text": "Дуга такого сектора занимает шестую часть окружности радиуса l. Она должна равняться окружности основания.",
      "view": "sector"
    },
    {
      "id": "h2",
      "question": "Что входит в полную поверхность?",
      "text": "Сложи площадь диска πr² и боковую площадь πrl. Образующую l можно заменить выражением через r.",
      "view": "axial"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Сравни два радиуса",
      "prompt": "Во сколько раз образующая больше радиуса основания?",
      "explanation": "2πr = (60/360) · 2πl. Значит, l = 6r.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина граничной дуги развёртки равна длине окружности основания."
        }
      ],
      "view": "sector",
      "input": {
        "prompt": "Введи отношение образующей к радиусу.",
        "accepted": [
          "6"
        ],
        "feedback": "Дуга занимает одну шестую полного круга радиуса l, поэтому l больше r."
      }
    },
    {
      "id": "step-2",
      "title": "Используй всю поверхность",
      "prompt": "Найди r² из площади 45π дм².",
      "explanation": "Полная площадь равна πr² + πr · 6r = 7πr². Отсюда r² = 45/7 дм².",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь полной поверхности складывается из площади основания и боковой поверхности."
        }
      ],
      "view": "sector",
      "input": {
        "prompt": "Введи квадрат радиуса основания.",
        "accepted": [
          "45/7"
        ],
        "feedback": "Одной площади сектора 6πr² недостаточно: добавь площадь круга основания."
      }
    },
    {
      "id": "step-3",
      "title": "Вычисли высоту и объём",
      "prompt": "Сколько дециметров составляет вертикальная высота?",
      "explanation": "h² = l²−r² = 35r² = 225, значит h = 15 дм. Объём V = π · (45/7) · 15/3 = 225π/7 дм³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Осевое сечение даёт прямоугольный треугольник с гипотенузой l, а в объёме участвует катет h.",
          "theoryId": "theory-059"
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи высоту в дм.",
        "accepted": [
          "15"
        ],
        "feedback": "Из 36r² вычти r². Берётся положительный корень из 225."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь новые данные",
      "prompt": "У другого конуса угол сектора 90°, полная площадь 20π. Если V = kπ√15, каков k?",
      "explanation": "Теперь l = 4r, поэтому 5πr² = 20π, r = 2 и h = 2√15. Объём равен (8/3)π√15.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Новый угол меняет отношение l/r, поэтому коэффициент при площади надо пересчитать."
        }
      ],
      "view": "sector",
      "input": {
        "prompt": "Введи новый коэффициент.",
        "accepted": [
          "8/3"
        ],
        "feedback": "При угле 90° радиус основания равен четверти образующей. Учти это в полной площади."
      }
    }
  ],
  "answer": {
    "mode": "exact",
    "accepted": [
      "225*pi/7"
    ],
    "prompt": "Введи исходный объём в дм³. Для π можно написать pi.",
    "feedback": "V = 225π/7 дм³."
  },
