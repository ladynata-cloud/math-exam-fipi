  "help": [
    {
      "id": "h1",
      "question": "Какие два вектора усреднять?",
      "text": "Нужны векторы с одинаковым началом D и концами B, C. Середины берутся по их концам.",
      "view": "average"
    },
    {
      "id": "h2",
      "question": "Где участвует DA?",
      "text": "Чтобы из D попасть как в B, так и в C, сначала можно пройти через A.",
      "view": "endpoints"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "К вершине B",
      "prompt": "В порядке a,b,c разложи DB.",
      "input": {
        "prompt": "К вершине B",
        "accepted": [
          "1;1;0"
        ],
        "feedback": "DB=DA+AB. До C в этом пути идти не приходится."
      },
      "explanation": "DB=a+b.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Сложение векторов по правилу треугольника.",
          "theoryId": "theory-070"
        }
      ],
      "view": "endpoints"
    },
    {
      "id": "step-2",
      "title": "К вершине C",
      "prompt": "Теперь разложи DC.",
      "input": {
        "prompt": "К вершине C",
        "accepted": [
          "1;0;1"
        ],
        "feedback": "Вместо AB на втором шаге нужен AC."
      },
      "explanation": "DC=a+c.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Путь D → A → C даёт DC.",
          "theoryId": "theory-070"
        }
      ],
      "view": "endpoints"
    },
    {
      "id": "step-3",
      "title": "Середина BC",
      "prompt": "Введи коэффициенты DK.",
      "input": {
        "prompt": "Середина BC",
        "accepted": [
          "1;1/2;1/2"
        ],
        "feedback": "DA встретился в обоих путях. В полусумме он останется один целый раз."
      },
      "explanation": "DK=(DB+DC)/2=a+(b+c)/2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Для середины отрезка вектор из общей точки есть полусумма векторов в его концы.",
          "theoryId": "theory-070"
        }
      ],
      "view": "average"
    },
    {
      "id": "step-4",
      "title": "Новая точка",
      "prompt": "Пусть теперь BK составляет треть BC. Запиши новые коэффициенты DK.",
      "input": {
        "prompt": "Новая точка",
        "accepted": [
          "1;2/3;1/3"
        ],
        "feedback": "Точка ближе к B. Возьми две трети DB и одну треть DC."
      },
      "explanation": "DK=(2DB+DC)/3=a+2b/3+c/3.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Деление отрезка в отношении 1:2 задаёт взвешенное среднее его концов.",
