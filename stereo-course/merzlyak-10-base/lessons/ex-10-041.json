      ]
    }
  ],
  "steps": [
    {
      "title": "Вырази стороны через k",
      "prompt": "Как обосновать шаг «вырази стороны через k»?",
      "explanation": "Касательные из каждой вершины равны. Отрезок боковой стороны у основания равен 12k, у вершины — 25k. Боковая сторона 37k, половина основания 12k.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равенство касательных из одной точки."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Найди высоту и масштаб",
      "prompt": "Как обосновать шаг «найди высоту и масштаб»?",
      "explanation": "Высота равна √((37k)²−(12k)²)=35k. Площадь равна (24k)·(35k)/2=420k². Отсюда k=2.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "neutral",
      "id": "step-2"
    },
    {
      "title": "Найди полупериметр",
      "prompt": "Как обосновать шаг «найди полупериметр»?",
      "explanation": "Боковые стороны 74, основание 48; полупериметр s=(74+74+48)/2=98 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определение полупериметра."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    },
    {
      "title": "Вычисли радиус",
      "prompt": "Как обосновать шаг «вычисли радиус»?",
      "explanation": "S=rs, поэтому r=1680/98=120/7 см.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Площадь треугольника равна произведению радиуса вписанной окружности и полупериметра."
        }
      ],
      "view": "neutral",
      "id": "step-4"
    }
