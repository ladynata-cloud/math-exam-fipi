  "steps": [
    {
      "id": "step-1",
      "title": "Три вида",
      "prompt": "Три вида — объясни действие и проверь результат.",
      "explanation": "Для прямого кругового тела используй вид сверху вдоль оси и два взаимно перпендикулярных вида сбоку. Вид сверху даёт радиус основания; вид сбоку — высоту. Для тела вращения два боковых вида одинаковы.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определения и доказанные свойства соответствующего параграфа; указанные в шаге координатные вычисления."
        }
      ],
      "view": "neutral"
    },
    {
      "id": "step-2",
      "title": "Проекции элементов",
      "prompt": "Проекции элементов — объясни действие и проверь результат.",
      "explanation": "Ось проектируется в точку на виде сверху и в отрезок длины H на виде сбоку. Основание проектируется в круг сверху и в отрезок длины 2R сбоку.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определения и доказанные свойства соответствующего параграфа; указанные в шаге координатные вычисления."
        }
      ],
      "view": "axis"
    },
    {
      "id": "step-3",
      "title": "Контур тела",
      "prompt": "Контур тела — объясни действие и проверь результат.",
      "explanation": "Контур сверху — окружность. Сбоку он образует прямоугольник. На наклонной проекции основания видны как эллипсы; размеры по произвольному изображению не определяются однозначно.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Определения и доказанные свойства соответствующего параграфа; указанные в шаге координатные вычисления."
        }
      ],
      "view": "neutral"
    },
    {
      "id": "step-4",
      "title": "Проверка выбора",
      "prompt": "Проверка выбора — объясни действие и проверь результат.",
      "explanation": "Два одинаковых круглых вида не показывают высоту. Поэтому набор «сверху и сбоку» информативнее двух почти одинаковых направлений. Для асимметричного тела нужны дополнительные виды.",
      "justifications": [
        {
          "kind": "theorem",
