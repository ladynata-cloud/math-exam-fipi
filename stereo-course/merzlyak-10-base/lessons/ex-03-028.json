  "steps": [
    {
      "title": "Одного примера достаточно",
      "prompt": "Как опровергнуть утверждение «каждый»?",
      "explanation": "Нужно построить хотя бы один многогранник с равными квадратными гранями, который не является кубом.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Ложное общее утверждение опровергается контрпримером."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Строим пространственный крест",
      "prompt": "Приклейте по одинаковому кубу к каждой грани центрального куба.",
      "explanation": "Получается фигура из семи кубов: один центральный и шесть выступающих. Каждая внешняя грань — квадрат той же стороны. Центральные грани внутри фигуры не входят в её поверхность.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "У выступающего куба одна грань внутренняя, остальные пять — наружные."
        }
      ],
      "view": "one",
      "id": "step-2"
    },
    {
      "title": "Сравниваем с кубом",
      "prompt": "Сколько квадратов образуют внешнюю поверхность?",
      "explanation": "У шести выступающих кубов по пять внешних квадратов: 6·5 = 30. У куба шесть граней, а у полученной невыпуклой фигуры — 30. Следовательно, утверждение неверно.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Контрпример соответствует всем условиям и не является кубом."
        }
      ],
      "view": "neutral",
      "id": "step-3"
    }
  ],
