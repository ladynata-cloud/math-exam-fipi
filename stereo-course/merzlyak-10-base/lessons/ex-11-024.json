  "steps": [
    {
      "title": "Определи O",
      "prompt": "Как обосновать шаг «определи o»?",
      "explanation": "Равенство DA=DB=DC даёт OA=OB=OC. Значит O — центр равностороннего ABC и лежит на медиане CK, где K — середина AB.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Равные наклонные имеют равные проекции."
        }
      ],
      "view": "neutral",
      "id": "step-1"
    },
    {
      "title": "Построй сечение",
      "prompt": "Как обосновать шаг «построй сечение»?",
      "explanation": "CK⊥AB, DO⊥AB. Эти пересекающиеся прямые задают плоскость DCK, перпендикулярную AB. Её сечение тетраэдра — треугольник DCK.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Признак перпендикулярности прямой и плоскости."
        }
      ],
      "view": "section",
      "id": "step-2"
    },
    {
      "title": "Найди основание и высоту",
      "prompt": "Как обосновать шаг «найди основание и высоту»?",
      "explanation": "CK=a√3/2. OA=a/√3, поэтому DO=√(a²−a²/3)=a√(2/3). DO⊥CK и является высотой сечения.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Теорема Пифагора в прямоугольном треугольнике."
        }
      ],
      "view": "height",
      "id": "step-3"
    },
    {
      "title": "Найди площадь",
      "prompt": "Как обосновать шаг «найди площадь»?",
      "explanation": "S=CK·DO/2=(a√3/2)·a√(2/3)/2=a²√2/4.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Формула площади треугольника."
        }
      ],
      "view": "section",
      "id": "step-4"
    }
