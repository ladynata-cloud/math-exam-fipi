  "help": [
    {
      "id": "h1",
      "question": "Что показывает плотность 1,8 г/см³?",
      "text": "Каждому кубическому сантиметру кирпича соответствует 1,8 г материала.",
      "view": "base"
    },
    {
      "id": "h2",
      "question": "Почему полезно сначала посчитать в граммах?",
      "text": "Все размеры указаны в сантиметрах, а плотность — на кубический сантиметр.",
      "view": "height"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Вычисли объём",
      "prompt": "Какой объём занимает один кирпич?",
      "explanation": "Площадь основания 25·12 = 300 см². Высота 6,5 см, поэтому V = 300·6,5 = 1950 см³.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём прямоугольного тела равен произведению трёх измерений."
        }
      ],
      "input": {
        "prompt": "Введи объём одного кирпича в см³.",
        "accepted": [
          "1950"
        ],
        "feedback": "Умножь площадь 300 см² на высоту 6,5 см."
      }
    },
    {
      "id": "step-2",
      "title": "Умножь на плотность",
      "prompt": "Какая единица останется после умножения?",
      "explanation": "Масса m = 1,8·1950 = 3510 г. Кубические сантиметры в числителе и знаменателе сокращаются.",
      "view": "height",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Плотность равна отношению массы материала к его объёму."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Вырази массу в килограммах",
      "prompt": "Сколько граммов составляет один килограмм?",
      "explanation": "Делим 3510 на 1000 и получаем 3,51 кг. Проверка порядка величины: объём около двух литров, масса чуть больше трёх килограммов.",
      "view": "sides",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Один килограмм равен тысяче граммов."
        }
      ]
    },
    {
      "id": "step-4",
      "title": "Проверь другой материал",
      "prompt": "Если кирпич тех же размеров изготовлен из материала плотности 2 г/см³, какова масса в кг?",
      "explanation": "При том же объёме получим 1950·2 = 3900 г = 3,9 кг.",
      "view": "base",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При постоянном объёме масса пропорциональна плотности."
        }
      ],
