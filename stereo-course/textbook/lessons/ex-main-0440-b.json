  "help": [
    {
      "id": "h1",
      "question": "Сколько раз при сложении V₁ и V₂ посчитано пересечение?",
      "text": "Попробуй сначала сложить части, а затем назвать область, попавшую в обе.",
      "view": "overlap"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Отметь общую часть",
      "prompt": "Какой объём посчитан в каждом из слагаемых?",
      "explanation": "Общий слой принадлежит P и Q. В сумме V₁+V₂ его объём V₁/3 учтён дважды.",
      "view": "overlap",
      "justifications": [
        {
          "kind": "theorem",
          "text": "При разбиении на части без общих внутренних точек их объёмы складываются."
        }
      ]
    },
    {
      "id": "step-2",
      "title": "Убери один лишний экземпляр",
      "prompt": "Что остаётся от P, если Q учитывается целиком?",
      "explanation": "От P остаются две трети его объёма. Получаем V = 2V₁/3 + V₂. Такое же выражение даёт V₁+V₂−V₁/3.",
      "view": "cut",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём пересечения вычитается один раз, поскольку он входит в обе части."
        }
      ]
    },
    {
      "id": "step-3",
      "title": "Проверь на числах",
      "prompt": "При V₁ = 12 см³ и V₂ = 9 см³ вычисли объём объединения.",
      "explanation": "Общий объём 4 см³. Значит, в объединении 12+9−4 = 17 см³.",
      "view": "overlap",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём объединения не меньше объёма каждой его части."
        }
      ],
      "input": {
        "prompt": "Введи объём объединения в см³.",
        "accepted": [
          "17"
        ],
        "feedback": "Нужна треть первого объёма: 12/3."
      }
    }
