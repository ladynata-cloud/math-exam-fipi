  "steps": [
    {
      "id": "step-1",
      "title": "Объём одной укладки",
      "prompt": "На модели три кубика. Какой объём в см³ у горизонтальной укладки?",
      "explanation": "Сумма трёх единичных объёмов равна 3 см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Смежные грани не добавляют объём."
        }
      ],
      "view": "row",
      "input": {
        "prompt": "Объём одной укладки",
        "accepted": [
          "3"
        ],
        "feedback": "Посчитай кубики, а не грани."
      }
    },
    {
      "id": "step-2",
      "title": "Сравнение укладок",
      "prompt": "Чему равна разность объёмов горизонтальной и вертикальной укладок?",
      "explanation": "Обе состоят из трёх кубов, поэтому разность равна нулю.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём складывается из объёмов частей независимо от их порядка.",
          "theoryId": "theory-052"
        }
      ],
      "view": "tower",
      "input": {
        "prompt": "Сравнение укладок",
        "accepted": [
          "0"
        ],
        "feedback": "Положение одной и той же группы кубов не изменяет их суммарный объём."
      }
    },
    {
      "id": "step-3",
      "title": "Новая укладка",
      "prompt": "Сколько см³ имеет каждое из тел, если n = 7?",
      "explanation": "Каждое займёт 7 см³. В общем виде V₁ = V₂ = n см³.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Каждое слагаемое суммы равно 1 см³."
        }
      ],
      "view": "row",
      "input": {
        "prompt": "Новая укладка",
        "accepted": [
          "7"
        ],
        "feedback": "Умножь объём одного кубика на n."
      }
    }
