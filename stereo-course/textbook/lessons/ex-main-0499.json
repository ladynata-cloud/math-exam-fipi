  "help": [
    {
      "id": "h1",
      "question": "Как получить радиус основания?",
      "text": "Подставь высоту и объём в V = πr²h/3. После сокращения π сначала получится квадрат радиуса.",
      "view": "axial"
    },
    {
      "id": "h2",
      "question": "Какая длина сохраняется при разворачивании?",
      "text": "Дуга развёртки до склеивания образует полную окружность основания. Радиус сектора — образующая l.",
      "view": "sector"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "title": "Восстанови круг основания",
      "prompt": "Сколько сантиметров в радиусе?",
      "explanation": "r² = 3 · 324π/(12π) = 81, поэтому r = 9.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Объём конуса определяет площадь основания при известной высоте."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи радиус конуса.",
        "accepted": [
          "9"
        ],
        "feedback": "Результат деления даёт r². Из 81 нужно извлечь корень."
      }
    },
    {
      "id": "step-2",
      "title": "Найди радиус сектора",
      "prompt": "Чему равна образующая?",
      "explanation": "В осевом прямоугольном треугольнике l = √(9²+12²) = 15 см. Радиусом развёртки станет эта длина.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Отрезки от вершины конуса до окружности основания сохраняют длину при разворачивании."
        }
      ],
      "view": "axial",
      "input": {
        "prompt": "Введи радиус развёртки.",
        "accepted": [
          "15"
        ],
        "feedback": "Радиус сектора и радиус основания — разные отрезки."
      }
    },
    {
      "id": "step-3",
      "title": "Сравни длины дуг",
      "prompt": "Сколько градусов занимает нужная дуга?",
      "explanation": "Доля окружности радиуса l равна (2πr)/(2πl) = 9/15 = 3/5. Угол сектора 360° · 3/5 = 216°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "Длина дуги пропорциональна центральному углу, когда радиус круга фиксирован.",
          "theoryId": "theory-059"
        }
      ],
      "view": "sector",
      "input": {
        "prompt": "Введи угол в градусах.",
        "accepted": [
          "216"
        ],
        "feedback": "Умножь 360 на r/l. Обратная дробь больше единицы и не описывает дугу развёртки."
      }
    },
    {
      "id": "step-4",
      "title": "Проверь другой конус",
      "prompt": "У нового конуса радиус основания 4, образующая 5. Сколько градусов в развёртке?",
      "explanation": "Дуга составляет 4/5 полной окружности радиуса 5; угол равен 288°.",
      "justifications": [
        {
          "kind": "theorem",
          "text": "В формуле угла развёртки достаточно отношения радиуса основания к образующей."
        }
      ],
      "view": "sector",
      "input": {
        "prompt": "Введи новый угол.",
        "accepted": [
          "288"
        ],
        "feedback": "Отношение длин 4/5 переводится в градусы умножением на 360."
      }
    }
  ],
